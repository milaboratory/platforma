wf := import("@platforma-sdk/workflow-tengo:workflow")
file := import("@platforma-sdk/workflow-tengo:file")

wf.body(func(args) {
	imported := file.importFile(args.inputHandle)
	result := file.exportFile(imported.file)
	return {
		outputs: {
			handle: imported.handle,
			blob: imported.file,
			downloadable: result
		},
		exports: {}
	}
})
