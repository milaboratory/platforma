{
  "name": "@milaboratories/example-pl-package-asset-1",
  "version": "1.1.0",
  "private": true,
  "description": "Example of software to be used as runenv",
  "scripts": {
    "cleanup": "shx rm -rf ./dist/ && shx rm -f ./pkg-*.tgz",
    "reset": "npm run cleanup && shx rm -rf ./node_modules/",
    "test:check": "shx rm -rf dist && no-env PL_PKG_DEV -- pl-pkg build --entrypoint=1.2.3 --docker-no-autopush && node ./verify.mjs"
  },
  "block-software": {
    "registries": {
      "binary": {
        "example": {
          "downloadURL": "https://example.com/base-path/"
        }
      }
    },
    "entrypoints": {
      "1.2.3": {
        "asset": {
          "registry": "example",
          "name": "common/example",
          "root": "./src"
        }
      }
    }
  },
  "files": [
    "dist/"
  ],
  "license": "UNLICENSED",
  "dependencies": {},
  "devDependencies": {
    "@milaboratories/no-env": "workspace:*",
    "@platforma-sdk/package-builder": "workspace:*",
    "shx": "catalog:"
  }
}
