/**
 * Custom metric collectors end to end (exec.formula.collector, MILAB-6912).
 *
 * One collector run writes two metrics, the newline count and the byte count of the files it
 * reads, and the job's RAM and CPU are formulas over both. The job echoes the quota the backend
 * actually granted ({system.ram.bytes},{system.cpu}), so the test compares it with what the
 * formula should give.
 *
 * inputs.file: the library fixture (42 newlines, 327 bytes)
 * inputs.mode: string -
 *   "tag"      - the collector reads the job's own files under tag "reads" (one fixture)
 *   "explicit" - the collector reads files it was given (the fixture twice), the job stages none
 *   "invalid"  - the collector writes a float; the run fails naming the collector
 *   "fallback" - the root exits 2; its SoftwareError plan is the one sized by the collector
 * inputs.nonce: string - keeps the renders from deduplicating against earlier runs
 */

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
file := import("@platforma-sdk/workflow-tengo:file")
ll := import("@platforma-sdk/workflow-tengo:ll")
text := import("text")
slices := import("@platforma-sdk/workflow-tengo:slices")
maps := import("@platforma-sdk/workflow-tengo:maps")

f := exec.formula

self.defineOutputs(["limits", "attempts"])

shellSw := assets.importSoftware("@platforma-open/milaboratories.software-test-utils:shell")

self.body(func(inputs) {
	inputFile := file.importFile(inputs.file).file
	mode := inputs.mode
	nonce := inputs.nonce

	shell := func(script) {
		return exec.builder().
			inLightQueue().
			software(shellSw).
			arg("-c").
			arg(script + " # " + nonce)
	}

	// `cat | wc` prints the totals over every file, with no file names to strip
	collectorDef := {
		metrics: ["lines", "bytes"],
		builder: func(files) {
			names := slices.quickSort(maps.getKeys(files))
			list := text.join(names, " ")
			script := "printf '{\"lines\": %d, \"bytes\": %d}' $(cat " + list + " | wc -l) $(cat " + list + " | wc -c)"
			if mode == "invalid" {
				script = "printf '{\"lines\": 1.5, \"bytes\": 3}'"
			}
			b := shell(script).cpu(1).mem("64MiB")
			for name in names {
				b.addFile(name, files[name])
			}
			return b
		},
		output: "stdout"
	}
	if mode == "explicit" {
		collectorDef.files = { "a.txt": inputFile, "b.txt": inputFile }
	} else {
		collectorDef.tag = "reads"
	}
	stats := f.collector("stats", collectorDef)

	// 512 MiB + 1 MiB per line; 2 cores above 400 bytes, else 1
	resources := { onCPU: {
		ram: stats.metric("lines").times(f.mib(1)).plus(f.mib(512)),
		cpu: f.when(stats.metric("bytes").gt(400), 2).otherwise(1)
	} }

	echo := func() {
		b := shell("printf '%s,%s' \"$RAM\" \"$CPU\" > limits.txt").
			envWithVar("RAM", "{system.ram.bytes}").
			envWithVar("CPU", "{system.cpu}").
			saveFileContent("limits.txt")
		if mode != "explicit" {
			b.addFile("input.txt", inputFile, { tag: "reads" })
		}
		return b
	}

	job := undefined
	if mode == "fallback" {
		sized := echo().resources(resources)
		job = shell("echo root > limits.txt; exit 2").
			cpu(1).mem("64MiB").
			addFile("input.txt", inputFile, { tag: "reads" }).
			saveFileContent("limits.txt").
			fallbacks({ SoftwareError: [{ exitCode: 2, name: "sized", builder: sized }] })
	} else if mode == "tag" || mode == "explicit" || mode == "invalid" {
		job = echo().resources(resources)
	} else {
		ll.panic("custom_metric: unknown mode %v", mode)
	}

	res := job.run()
	return {
		limits: res.getFileContent("limits.txt"),
		attempts: res.getAttempts()
	}
})
