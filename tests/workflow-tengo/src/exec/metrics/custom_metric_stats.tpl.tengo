/**
 * A custom metric template for exec.metrics.custom_metric (exec.formula.customMetric, MILAB-6912).
 * Writes {"lines": <newlines>, "bytes": <bytes>} over every file it gets.
 *
 * inputs.files: { <file name>: <file> } - the files the metric reads
 * outputs.output: the content the formula's metrics are parsed from
 */

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
slices := import("@platforma-sdk/workflow-tengo:slices")
maps := import("@platforma-sdk/workflow-tengo:maps")
text := import("text")

self.defineOutputs(["output"])

shellSw := assets.importSoftware("@platforma-open/milaboratories.software-test-utils:shell")

self.body(func(inputs) {
	names := slices.quickSort(maps.getKeys(inputs.files))
	// `cat | wc` prints the totals over every file, with no file names to strip
	list := text.join(names, " ")
	b := exec.builder().
		inLightQueue().
		software(shellSw).
		cpu(1).
		mem("64MiB").
		arg("-c").
		arg("printf '{\"lines\": %d, \"bytes\": %d}' $(cat " + list + " | wc -l) $(cat " + list + " | wc -c)")
	for name in names {
		b.addFile(name, inputs.files[name])
	}
	return { output: b.saveStdoutContent().run().getStdoutContent() }
})
