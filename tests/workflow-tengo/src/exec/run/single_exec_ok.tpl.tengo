/**
 * one exec that succeeds and returns the current time in nanoseconds. Used as the
 * upstream step in the case where an intermediate template, not the command, is what
 * fails. Its only input is the test's `seed`, so its CID is stable across renders
 * with the same seed.
 */

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")

self.defineOutputs(["main"])

self.body(func(inputs) {
	run := exec.builder().
		name("recovery-okstage").
		cpu(1).ram("50Mi").
		inLightQueue().
		cmd("/usr/bin/env").
		arg("bash").
		arg("-c").
		arg("date +%s%N > out.txt").
		arg("okstage").
		arg(inputs.seed).
		saveFileContent("out.txt").
		run()

	return {
		main: run.getFileContent("out.txt")
	}
})
