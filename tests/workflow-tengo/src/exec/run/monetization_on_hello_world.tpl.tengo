/** Runs a hello world with a turned on monetization, and returns a jwt token. */

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
smart := import("@platforma-sdk/workflow-tengo:smart")
exec := import("@platforma-sdk/workflow-tengo:exec")
ll := import("@platforma-sdk/workflow-tengo:ll")

self.defineOutputs(["token"])

shellSw := assets.importSoftware("@platforma-open/milaboratories.software-test-utils:shell")

self.body(func(inputs) {
	run := exec.builder().
		cpu(1).ram("50Mi").
		software(shellSw).
		arg("-c").
		arg("printf %s $PLATFORMA_MNZ_JWT"). // printf writes no trailing newline. The shell entrypoint is POSIX sh, whose echo prints "-n" as text instead of reading it as a flag.
		enableMnz("MIFAKEMIFAKEMIFAKE"). // a fake product key so our mnz client response with a fake response without changing prod db.
		writeFile("abc.txt", "1\n2\n3\n",
			{mnz: {
				arg: "abc.txt",
				metrics: ["lines"]
			}}
		).
		saveStdoutContent().
		run()

	return {
		token: run.getStdoutContent()
	}
})
