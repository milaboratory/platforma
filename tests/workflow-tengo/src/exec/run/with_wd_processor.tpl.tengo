/** Runs a simple echo and returns stdout */

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
smart := import("@platforma-sdk/workflow-tengo:smart")
exec := import("@platforma-sdk/workflow-tengo:exec")
ll := import("@platforma-sdk/workflow-tengo:ll")

self.defineOutputs(["p"])

shellSw := assets.importSoftware("@platforma-open/milaboratories.software-test-utils:shell")

self.body(func(inputs) {
	run := exec.builder().
		cpu(1).ram("50Mi").
		software(shellSw).
		arg("-c").
		arg("echo 'text1' > file1.txt && echo 'text2' > file2.txt").
		processWorkdir("p", assets.importTemplate(":exec.run.wd_processor_1"), {}).
		run()

	return {
		p: run.getProcessorResult("p")
	}
})
