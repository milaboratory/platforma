self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")

self.defineOutputs(["tmpdir"])

// A software entrypoint whose command is 'sh': busybox in a container, the host's own shell for a
// bare binary. Real software rather than exec.builder().cmd("sh") on purpose - the compatibility
// wrapper patches a software DESCRIPTOR, and that is the path every real block takes.
shellSw := assets.importSoftware("@platforma-open/milaboratories.software-test-utils:shell")

self.body(func(inputs) {
	/* Closes the loop on the temporary-directory contract, on whichever backend runs the test.
	 *
	 * A block asks for scratch space with no size at all - a real request for a temporary
	 * directory without a device - and the running command must find TMPDIR and TMP naming the
	 * same writable place that '{system.scratch.path}' names. Nothing in that sentence mentions a
	 * backend version, and that is the point: a current backend arranges it, an older one gets it
	 * from the SDK's compatibility wrapper, and the command cannot tell which.
	 *
	 * Reading it out of the command's own stdout is the only way to prove it. The values have to
	 * survive the quota, the allocation, the driver and - on an old backend - a shell script that
	 * execs this command; a test asserting on the SDK's own maps would pass while the command saw
	 * nothing.
	 *
	 * POSIX shells only, so this does not run on a Windows runner. That is the same boundary the
	 * SDK draws: the compatibility wrapper is POSIX-shell only, and Windows ships with a backend
	 * whose version we control.
	 */
	run := exec.builder().
		software(shellSw).
		resources({
			// The smallest numbers that still run: the test is about the directory reaching the
			// command, so it must not compete for resources with whatever shares the runner.
			onCPU: {
				cpu: 1,
				ram: "50MiB",
				scratchFreeSpace: 0
			}
		}).
		arg("-c").
		arg(
			// Fails loudly rather than reporting a wrong answer: an unset variable or a directory
			// that cannot be written to is exactly the bug this test exists to catch.
			"set -e; " +
			": \"${TMPDIR:?TMPDIR is not set}\"; " +
			": \"${TMP:?TMP is not set}\"; " +
			"printf probe > \"$TMPDIR/probe.txt\"; " +
			"printf '%s %s %s %s' \"$TMPDIR\" \"$TMP\" \"$1\" \"$(cat \"$TMPDIR/probe.txt\")\""
		).
		arg("sh"). // $0 for the inline script
		argExpr("{system.scratch.path}").
		saveStdoutContent().
		run()

	return {
		tmpdir: run.getStdoutContent()
	}
})
