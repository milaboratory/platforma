/**
 * The inputs an exec without fallbacks renders exec.exec with, dumped as text (exec fallbacks,
 * AC3.1): they must be the same as with the SDK before exec fallbacks, so the render's CID is.
 * `dump` is every input with its JSON value or resource type; `keys` the input names.
 */

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
smart := import("@platforma-sdk/workflow-tengo:smart")
text := import("text")
maps := import("@platforma-sdk/workflow-tengo:maps")

self.defineOutputs(["dump", "keys"])

shellSw := assets.importSoftware("@platforma-open/milaboratories.software-test-utils:shell")

_dump := undefined
_dump = func(r) {
	t := r.info().Type
	if text.has_prefix(t.Name, "json/") {
		return t.Name + ":" + string(r.getData())
	}
	if smart.isMapResource(r) {
		fields := r.inputs()
		parts := []
		for k in maps.getKeys(fields) {
			parts = append(parts, k + "=" + _dump(fields[k].getValue()))
		}
		return t.Name + "{" + text.join(parts, ",") + "}"
	}
	return t.Name + "/" + t.Version
}

self.body(func(inputs) {
	res := exec.builder().
		software(shellSw).
		arg("-c").arg("cat in.txt > out.txt; echo done").
		env("A", "1").
		writeFile("in.txt", "hello").
		mkDir("sub").
		cpu(2).mem("128MiB").
		inMediumQueue().
		saveFile("out.txt").
		saveFileContent("out.txt").
		saveFileSet("all", ".*\\.txt").
		saveStdoutStream().
		saveStderrContent().
		run()

	inputsMap := res.getField("inputs").getValue()
	return {
		dump: _dump(inputsMap),
		keys: maps.getKeys(inputsMap.inputs())
	}
})
