/**
 * The canonical id of the exec.exec render of an exec without fallbacks (exec fallbacks, AC3.1),
 * read once the render is ready. No software: its package version would enter the id.
 */

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
render := import("@platforma-sdk/workflow-tengo:render")
assets := import("@platforma-sdk/workflow-tengo:assets")

self.defineOutputs(["cid", "out"])

readerTpl := assets.importTemplate(":exec.fallback.cid_reader")

self.body(func(inputs) {
	res := exec.builder().
		cmd("sh").
		arg("-c").arg("cat in.txt > out.txt").
		env("A", "1").
		writeFile("in.txt", "hello").
		cpu(1).mem("64MiB").
		inLightQueue().
		saveFileContent("out.txt").
		saveStdoutStream().
		run()

	reader := render.createEphemeral(readerTpl, { exec: res })
	return { cid: reader.output("cid"), out: res.getFileContent("out.txt") }
})
