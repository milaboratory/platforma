// Reads the columns of the multi-result query stored in the bundle under "q".
// The body runs when the specs of the bundle are ready: the data map of the query can be pending.
self := import("@platforma-sdk/workflow-tengo:tpl")
smart := import("@platforma-sdk/workflow-tengo:smart")

self.awaitState("bundle", "PColumnBundle")

self.body(func(inputs) {
	columns := inputs.bundle.getColumns("q")
	return {
		count: smart.createJsonResource(len(columns)),
		name: smart.createJsonResource(columns[0].spec.name),
		data: columns[0].data
	}
})
