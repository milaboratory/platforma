// tree: creates the action context of its own render, records a transition and renders a child

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
smart := import("@platforma-sdk/workflow-tengo:smart")

self.defineOutputs(["context", "child", "childBaggage"])

self.body(func(inputs) {
	// the test renders this template without an action context, as the middle layer would create it
	contextId := self.actionContext().create({ "name": "root", "block-id": "block-1", "run-id": "run-1" })
	self.actionContext().record("tpl", "Running", "root body")

	child := render.createEphemeral(assets.importTemplate(":action-context.child"), {})

	return {
		// holds the context after the render is collected, as the middle layer does
		context: smart.resource(contextId),
		child: child.output("done"),
		childBaggage: child.output("baggage")
	}
})
