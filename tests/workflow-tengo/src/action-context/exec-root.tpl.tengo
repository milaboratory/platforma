// exec-root: renders exec with a new action context, as the middle layer does for the root render of a block

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")

self.defineOutputs(["context", "out"])

self.body(func(inputs) {
	inner := render.createEphemeral(
		assets.importTemplate(":action-context.exec"),
		{},
		{ actionContext: { "name": "root", "run-id": "run-exec" } }
	)

	return {
		context: inner.output("context"),
		out: inner.output("out")
	}
})
