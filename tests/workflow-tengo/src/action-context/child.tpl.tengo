// child: reports into the action context its parent created, and renders a grandchild with a custom name

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")

self.defineOutputs(["done", "baggage"])

self.body(func(inputs) {
	self.actionContext().record("tpl", "Running", "child body")
	self.actionContext().setReading("exec", "progress", "40")

	grandchild := render.createEphemeral(
		assets.importTemplate(":action-context.grandchild"),
		{},
		{ name: "custom grandchild" }
	)

	return { done: grandchild.output("done"), baggage: self.actionContext().baggage() }
})
