// nocontext: a template rendered without an action context. Rendering a child creates no context,
// and reports are no-ops, so a block from a middle layer without block action context runs as before.

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
actionContext := import("@platforma-sdk/workflow-tengo:action-context")

self.defineOutputs(["contexts", "child"])

self.body(func(inputs) {
	self.actionContext().record("tpl", "Running", "no context")
	self.actionContext().setReading("exec", "progress", "1")

	child := render.createEphemeral(assets.importTemplate(":action-context.grandchild"), {})

	return {
		contexts: {
			own: actionContext.linkOf(self.renderer().id).kind,
			child: actionContext.linkOf(child.id).kind
		},
		child: child.output("done")
	}
})
