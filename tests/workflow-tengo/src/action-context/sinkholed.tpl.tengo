// sinkholed: a template rendered into the sinkhole. It cannot create its own context, its reports are
// dropped, and the template it renders is in the sinkhole too.

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
actionContext := import("@platforma-sdk/workflow-tengo:action-context")

self.defineOutputs(["info", "done"])

self.body(func(inputs) {
	created := self.actionContext().create({ "name": "override" })
	self.actionContext().record("tpl", "Running", "dropped")
	self.actionContext().setReading("exec", "progress", "99")

	grandchild := render.createEphemeral(assets.importTemplate(":action-context.grandchild"), {})

	return {
		info: {
			created: !is_undefined(created),
			baggage: !is_undefined(self.actionContext().baggage()),
			own: actionContext.linkOf(self.renderer().id).kind,
			grandchild: actionContext.linkOf(grandchild.id).kind
		},
		done: grandchild.output("done")
	}
})
