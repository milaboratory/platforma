// Runs the queries args.calls describes through the v2 workflow and decodes their results in a
// sub-template (v2.decode), which awaits only what decoding needs.
//
// args.calls: map of label to one of
//   { resolve: ref, options?: {...} }    — wf.resolve
//   { query: querySpec, options?: {...} } — wf.query
// Outputs (in result): decoded — the description v2.decode produces.
wf := import("@platforma-sdk/workflow-tengo:v2.workflow")
ex := import("@platforma-sdk/workflow-tengo:v2.exports")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")

decodeTpl := assets.importTemplate(":v2.decode")

wf.body(func(args) {
	items := {}
	choices := {}
	for label, call in args.calls {
		options := is_undefined(call.options) ? [] : [call.options]
		if !is_undefined(call.resolve) {
			items[label] = wf.resolve(call.resolve, options...)
		} else {
			choices[label] = wf.query(call.query, options...)
		}
	}
	decoded := render.createEphemeral(decodeTpl, { items: items, choices: choices })
	return {
		outputs: { decoded: decoded.output("out") },
		exports: ex.collection({})
	}
})
