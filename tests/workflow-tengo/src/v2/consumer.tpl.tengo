// A consumer: resolves the ref in args.source and returns its spec and data.
wf := import("@platforma-sdk/workflow-tengo:v2.workflow")
ex := import("@platforma-sdk/workflow-tengo:v2.exports")

wf.body(func(args) {
	r := wf.resolve(args.source, { errIfMissing: true })
	return {
		outputs: { spec: r.spec, data: r.data },
		exports: ex.collection({})
	}
})
