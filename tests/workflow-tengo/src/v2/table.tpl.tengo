// A table built through the v2 workflow's table builder: args.primary is the primary's ref;
// args.column, when given, is the ref of one more column.
wf := import("@platforma-sdk/workflow-tengo:v2.workflow")
ex := import("@platforma-sdk/workflow-tengo:v2.exports")
file := import("@platforma-sdk/workflow-tengo:file")
times := import("times")

wf.body(func(args) {
	builder := wf.tableBuilder("tsv").addPrimary("main", args.primary)
	if !is_undefined(args.column) {
		builder = builder.addColumn(args.column)
	}
	builder.cacheInputs(1 * times.second)
	return {
		outputs: { table: file.exportFile(builder.build()) },
		exports: ex.collection({})
	}
})
