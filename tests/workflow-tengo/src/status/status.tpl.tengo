// status: creates the status context of its own render, records a transition and renders a child

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
smart := import("@platforma-sdk/workflow-tengo:smart")

self.defineOutputs(["status", "child", "childData"])

self.body(func(inputs) {
	// the test renders this template without a status context, as the middle layer would create it
	contextId := self.status().create({ "name": "root", "block-id": "block-1", "run-id": "run-1" })
	self.status().record("tpl", "Running", "root body")

	child := render.createEphemeral(assets.importTemplate(":status.child"), {})

	return {
		// holds the context after the render is collected, as the middle layer does
		status: smart.resource(contextId),
		child: child.output("done"),
		childData: child.output("data")
	}
})
