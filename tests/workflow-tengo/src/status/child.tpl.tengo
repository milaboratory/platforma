// child: reports into the status context its parent created, and renders a grandchild with a custom name

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")

self.defineOutputs(["done", "data"])

self.body(func(inputs) {
	self.status().record("tpl", "Running", "child body")
	self.status().setAttr("exec", "progress", "40")

	grandchild := render.createEphemeral(
		assets.importTemplate(":status.grandchild"),
		{},
		{ name: "custom grandchild" }
	)

	return { done: grandchild.output("done"), data: self.status().data() }
})
