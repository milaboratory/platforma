{
  "name": "@milaboratories/drivers-blocks-integration",
  "version": "1.0.0",
  "private": true,
  "description": "Driver tests that move files between the test blocks and a live backend",
  "scripts": {
    "check": "ts-builder check --target node",
    "formatter:check": "ts-builder formatter --check",
    "linter:check": "ts-builder linter --check",
    "types:check": "ts-builder type-check --target node",
    "test": "vitest run --coverage --no-file-parallelism --sequence.concurrent=false",
    "fmt": "ts-builder format"
  },
  "dependencies": {
    "@milaboratories/milaboratories.test-blob-url-custom-protocol": "workspace:*",
    "@milaboratories/milaboratories.test-blob-url-custom-protocol.model": "workspace:*",
    "@milaboratories/milaboratories.test-download-file": "workspace:*",
    "@milaboratories/milaboratories.test-download-file.model": "workspace:*",
    "@milaboratories/milaboratories.test-read-logs": "workspace:*",
    "@milaboratories/milaboratories.test-read-logs.model": "workspace:*",
    "@milaboratories/milaboratories.test-upload-file": "workspace:*",
    "@milaboratories/milaboratories.test-upload-file.model": "workspace:*",
    "@milaboratories/milaboratories.transfer-files": "workspace:*",
    "@milaboratories/milaboratories.transfer-files.model": "workspace:*",
    "@milaboratories/pl-middle-layer": "workspace:*",
    "@platforma-sdk/test": "workspace:*",
    "quickjs-emscripten": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@milaboratories/build-configs": "workspace:*",
    "@milaboratories/ts-builder": "workspace:*",
    "@milaboratories/ts-configs": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
