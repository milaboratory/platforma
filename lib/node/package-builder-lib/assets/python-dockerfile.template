# Auto-generated Dockerfile for Python package

# Stage 1: install dependencies, then split the installed tree into layer-sized directories.
FROM ${BASE_IMAGE_TAG} AS deps

WORKDIR ${PKG}

${RUNENV_ENVS}

# Always keep basic python packaging tools fresh to avoid CVEs even in old python versions
RUN ${TOOLSET} install --no-compile --upgrade pip wheel setuptools

# Install dependencies to leverage Docker cache, then split what was installed into
# directories of about ${DEPS_LAYER_TARGET_BYTES} bytes, one image layer each, so no single
# layer is too big for the registry to finalize in time. Both happen in one RUN: the new
# files are still in this step's own layer, so the split moves them instead of copying.
# .pyc files are compiled hash-based (not from the install time), so an unchanged package
# gives the same files on every build and its layer can be reused (see docker-relayer.ts).
# The heredoc needs BuildKit (Docker >= 23 default) or buildah/podman >= 1.33.
COPY ${REQUIREMENTS_PATH} .
RUN ${TOOLSET} install --no-compile --no-cache-dir -r ${REQUIREMENTS_FILENAME} \
    && python3 -m compileall -q -f -j 0 --invalidation-mode unchecked-hash \
        "$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && python3 - ${DEPS_ROOT} /layers ${DEPS_LAYERS} ${DEPS_LAYER_TARGET_BYTES} <<'LAYER_SPLIT_EOF'
${LAYER_SPLIT_SCRIPT}
LAYER_SPLIT_EOF

# Stage 2: the base image plus the installed tree, one COPY (= one layer) per directory.
FROM ${BASE_IMAGE_TAG}

WORKDIR ${PKG}

${RUNENV_ENVS}

# Start from an empty site-packages, so files that pip removed in stage 1 (e.g. the
# base image's old pip) do not come back from the base layer.
RUN purelib="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && test -n "$purelib" \
    && rm -rf "$purelib"

${DEPS_LAYER_COPIES}

# Copy package source
COPY . ${PKG}

# Set Python path
ENV PYTHONPATH=${PKG}

# Default command (will be overridden by entrypoint)
CMD ["bash"]
