{
  "name": "@platforma-open/milaboratories.software-ptexter",
  "version": "1.2.6",
  "description": "Text processing utilities for platforma",
  "scripts": {
    "build": "shx rm -rf ./dist && block-tools software build",
    "do-pack": "shx rm -f *.tgz && block-tools software build && pnpm pack && shx mv platforma-open-milaboratories.software-ptexter-*.tgz package.tgz"
  },
  "files": [
    "./dist/**/*"
  ],
  "dependencies": {},
  "devDependencies": {
    "@platforma-sdk/block-tools": "workspace:*",
    "@platforma-open/milaboratories.runenv-python-3": "catalog:",
    "shx": "catalog:"
  },
  "block-software": {
    "entrypoints": {
      "phead-lines": {
        "binary": {
          "artifact": {
            "type": "python",
            "registry": "platforma-open",
            "environment": "@platforma-open/milaboratories.runenv-python-3:3.12.10",
            "dependencies": {
              "toolset": "pip",
              "requirements": "requirements.txt"
            },
            "root": "./src"
          },
          "cmd": [
            "python",
            "{pkg}/phead-lines.py"
          ]
        }
      }
    }
  }
}
