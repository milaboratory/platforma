ll := import(":ll")
smart := import(":smart")
maps := import(":maps")
constants := import(":constants")
json := import("json")
text := import("text")
assets := import(":assets")
render := import(":render")
validation := import(":validation")
model := import(":workflow.model")

queryAnchoredTpl := assets.importTemplate(":workflow.query-anchored")

_CONTEXT_FIELD_NAME := "ctx"

// Resolver types per family. Family 1 resolves over BContext/1 chains; family 2 over BContext/2
// chains (a values tree). Results of family 2 carry `family: 2` in their ops; family 1 never writes it.
_FAMILIES := {
	"1": {
		single: constants.RTYPE_BRESOLVE_FIRST,
		choice: constants.RTYPE_BRESOLVE_CHOICE
	},
	"2": {
		single: { Name: "BResolveSingle", Version: "2" },
		choice: { Name: "BResolveChoice", Version: "2" }
	}
}

// options scheme for query
_OPTIONS_SCHEME := {
	"spec,?": `bool`,
	"data,?": `bool`,
	"single,?": `bool`,
	"first,?": `bool`,
	"errIfMissing,?": `bool`
}

// default query options
_DEFAULT_OPTIONS := {
	/** Return specs in the results */
	spec: true,
	/** Return data in the results */
	data: true,
	/** Asserts that the resulting list has one element and returns it */
	single: false,
	/** Returns first available result of the query */
	first: false,
	/** Throw error if no results found */
	errIfMissing: false
}

// Schema for query map validation
_QUERY_MAP_SCHEMA := {
	`__options__,closed`: true,
	`any`: ["or",
		model.AP_COLUMN_SELECTOR_SCHEMA,
		{
			`__options__,closed`: true,
			`query`: model.AP_COLUMN_SELECTOR_SCHEMA,
			`specOnly`: `bool`
		}
	]
}

/**
 * Query results pool.
 *
 * @param spec: query spec
 * @param ctx: results pool (context) to query
 * @param options: an options map
 * @return result: a list of {ref: spec: data:} objects (data will be absent if not requested)
 *
 * The query spec supports the following operand types for matching PColumnSpecs:
 *
 * 1. Logical operators:
 *    ```
 *    {type: "Or", operands: [operand1, operand2, ...]}  // matches if any operand matches
 *    {type: "And", operands: [operand1, operand2, ...]} // matches if all operands match
 *    {type: "Not", operand: someOperand}                // matches if operand doesn't match
 *    ```
 *
 * 2. Name matchers:
 *    ```
 *    {type: "Name", name: "pl7.app/rna-seq/countMatrix"} // matches by exact name
 *    {type: "NamePattern", pattern: "pl7.app/vdj/.*"}    // matches using regex pattern
 *    ```
 *
 * 3. Domain matcher:
 *    ```
 *    {
 *      type: "Domain",
 *      domain: {"pl7.app/block": "blockId"},
 *      domainExactMatch: false  // true requires exact match, false checks subset
 *    }
 *    ```
 *
 * 4. Annotation matchers:
 *    ```
 *    {type: "Annotation", annotation: "pl7.app/isDiscreteFilter", value: "true"}         // exact match
 *    {type: "AnnotationPattern", annotation: "pl7.app/abundance", pattern: ".*false.*"}  // regex match
 *    ```
 *
 * 5. AxesKeys: matches by axis specifications
 *    ```
 *    {
 *      type: "AxesKeys",
 *      axesKeys: [
 *        {
 *          name: "pl7.app/rna-seq/geneId",
 *          domain: {"pl7.app/block": "blockId"},
 *          domainExactMatch: false
 *        }
 *      ],
 *      partialMatch: false  // true allows subset of axes to match
 *    }
 *    ```
 *
 * Example:
 * ```
 * // Find RNA-seq count matrices from block "abc123"
 * query({
 *   type: "And",
 *   operands: [
 *     {type: "Name", name: "pl7.app/rna-seq/countMatrix"},
 *     {type: "Domain", domain: {"pl7.app/block": "abc123"}}
 *   ]
 * })
 * ```
 */
_create := func(family, spec, ctx, options) {

	// @TODO validate spec

	types := _FAMILIES[string(family)]

	ops := copy(_DEFAULT_OPTIONS)
	if len(options) > 0 {
		ll.assert(len(options) == 1, "expected map, got array: ", options)

		// @TODO validate options

		// override defaults
		for k, v in options[0] {
			ops[k] = v
		}
	}

	query := json.encode({
		query: spec,
		setErrorIfMissing: ops.errIfMissing
	})

	builder := undefined
	if ops.first {
		builder = smart.ephemeralBuilder(types.single, query)
	} else {
		// return all query results
		builder = smart.ephemeralBuilder(types.choice, query)
	}

	builder.createInputField(_CONTEXT_FIELD_NAME).set(ctx)
	resolve := builder.lockInputsAndBuild()


	// create a special type to store query results

	rb := smart.structBuilder(constants.RTYPE_QUERY_RESULT)

	// save options; the decoder reads the family from them
	if family != 1 {
		ops.family = family
	}
	rb.createInputField("ops").setJson(ops)

	if ops.spec {
		rb.createInputField("spec").set(resolve.getFutureOutputField("spec"))
	}

	// pass data only if needed, otherwise we are not waiting for data to complete
	if ops.data {
		rb.createInputField("data").set(resolve.getFutureOutputField("data"))
	}

	// the data structure differs in this case; the single ref, data and spec are stored
	// directly as result fields
	if ops.first {
		rb.createInputField("ref").set(resolve.getFutureOutputField("address"))
	}

	return rb.lockAndBuild()
}

create := func(spec, ctx, ...options) {
	return _create(1, spec, ctx, options)
}

/**
 * Inputs preprocessor used to convert query result into array of {ref: spec: data:} objects
 *
 * Results of family 2 (see `forFamily`) decode differently in two ways:
 *  - an item without data has no `data` key: a BResolveSingle/2 fills `data` with the no-result
 *    marker for it, a BResolveChoice/2 has no data entry for it (or one holding the marker, when a
 *    workflow passed a query result on). A `data` key holding a field
 *    reference still means the data is pending, and no `data` key with `ops.data` false means the
 *    data was not requested;
 *  - every ref is a family-2 ref `{block, workflow, name}` (see `forFamily`), so a ref a query
 *    returned can be passed to `resolve` again.
 */
resultUnmarshaller := func() {
	return  {
		canParse: func(r) {
			return smart.isResource(r) && r.info().Type.Name == constants.RTYPE_QUERY_RESULT.Name
		},

		parse: func(resource, parser)  {

			ops := resource.get("ops").getDataAsJson()
			isFamily2 := ops.family == 2

			// is no result
			isNR := func(r) {
				return r.info().Type.Name == constants.RTYPE_BRESOLVE_NO_RESULT.Name
			}

			// family-2 data of an item without data: the no-result marker, exact type
			isNoResultField := func(field) {
				return field.isSet() && !field.isErrorSet() &&
					field.getValue().checkResourceType(constants.RTYPE_BRESOLVE_NO_RESULT)
			}

			// the backend's address {blockId: "<block>/<workflow>", name}; neither part contains "/"
			decodeRef := func(address) {
				if !isFamily2 {
					return address
				}
				parts := text.split_n(address.blockId, "/", 2)
				ll.assert(len(parts) == 2, "unexpected address of a family-2 value: %v", address)
				return { block: parts[0], workflow: parts[1], name: address.name }
			}

			/**
			 * Get's data resource from a resource or a field and parses it,
			 * or returns field ref if resource is not set yet.
			 */
			getData := func(res, fieldName) {
				field := res.getField(fieldName)
				if field.isSet() {
					return parser(field.getValue())
				} else {
					return field
				}
			}

			if ops.first {
				// special case, single element

				if isNR(resource.get("ref")) {
					return undefined
				}

				result := {
					ref: decodeRef(resource.get("ref").getDataAsJson()),
					spec: resource.get("spec").getDataAsJson()
				}

				if resource.hasInputField("data") {
					if !isFamily2 || !isNoResultField(resource.getField("data")) {
						result.data = getData(resource, "data")
					}
				}

				return ll.toStrict(result)
			} else {
				// format list of results

				specs := resource.get("spec").inputs() // map of specs
				datas := undefined
				if resource.hasInputField("data") {
					datas = resource.get("data") // map of datas
				}

				result := []
				maps.forEach(specs, func(ref, s) {
					r := {
						ref: decodeRef(json.decode(ref)),
						spec: s.getValueAsJson()
					}

					// only if the data is there; a BResolveChoice/2 writes an address's spec and data
					// entries together, so a missing data entry means the item has no data
					if !is_undefined(datas) {
						if !isFamily2 {
							r.data = getData(datas, ref)
						} else if datas.hasInputField(ref) && !isNoResultField(datas.getField(ref)) {
							r.data = getData(datas, ref)
						}
					}

					result = append(result, ll.toStrict(r))
				})

				if ops.single {
					ll.assert(len(result) == 1, "expected single element, got ", len(result))

					result = result[0]
				}

				return result
			}
		}
	}
}

/**
 * Query results pool to find spec & data for a given ref.
 *
 * @param ref: a ref object ({blockId: name:})
 * @param ctx: results pool (context) to query
 * @return result: a {ref: spec: data:} object
 */
_FAMILY2_REF_FIELDS := ["block", "workflow", "name"]

// Whether value is a family-2 ref: a map with exactly the fields block, workflow and name, each a
// non-empty string, block and workflow without "/".
_isFamily2Ref := func(value) {
	if !ll.isMap(value) || smart.isReference(value) || len(value) != len(_FAMILY2_REF_FIELDS) {
		return false
	}
	for f in _FAMILY2_REF_FIELDS {
		if !maps.containsKey(value, f) || !is_string(value[f]) || value[f] == "" {
			return false
		}
	}
	return !text.contains(value.block, "/") && !text.contains(value.workflow, "/")
}

_assertFamily2Ref := func(ref) {
	if !_isFamily2Ref(ref) {
		ll.panic("a ref is {block, workflow, name}: three non-empty strings, block and workflow without \"/\"; got %v", ref)
	}
}

// The options a family-2 call was given, checked: at most one map, whose keys are among `allowed`
// and whose values are booleans.
_family2Options := func(options, allowed) {
	ll.assert(len(options) <= 1, "expected at most one options map, got %v", options)
	if len(options) == 0 {
		return {}
	}
	o := options[0]
	ll.assert(ll.isMap(o) && !smart.isReference(o), "expected a map of options, got %v", o)
	for k, v in o {
		ok := false
		for a in allowed {
			if a == k {
				ok = true
			}
		}
		if !ok {
			ll.panic("query option %q is not allowed in the v2 query API; allowed: %v", k, allowed)
		}
		ll.assert(is_bool(v), "query option %q must be a boolean, got %v", k, v)
	}
	return copy(o)
}

_resolve := func(family, ref, ctx, options) {

	spec := undefined
	if family == 2 {
		_assertFamily2Ref(ref)
		spec = {
			type: "Direct",
			block_id: ref.block + "/" + ref.workflow,
			output_name: ref.name
		}
	} else {
		spec = {
			type: "Direct",
			block_id: ref.blockId, 	// @TODO use consistent naming in pl
			output_name: ref.name 	// @TODO use consistent naming in pl
		}
	}

	ops := {}

	if len(options) > 0 {
		ops = copy(options[0])
	}

	ops.first = true
	if family == 2 {
		ops.errIfMissing = true
	}

	return _create(family, spec, ctx, [ops])
}

resolve := func(ref, ctx, ...options) {
	return _resolve(1, ref, ctx, options)
}

/** Default options for anchoredQuery */
_ANCHORED_QUERY_DEFAULT_OPTIONS := {
	/** If true, ignores errors when referenced anchors or their domains are missing during resolution */
	ignoreMissingDomains: false
}

/**
 * Resolves both anchor references and related items in one operation.
 *
 * @param ctx: results pool (context) to query
 * @param anchors: a map of anchorId -> ref or {ref: {blockId: string, name: string}, specOnly: bool}
 *                 When providing {ref, specOnly}, the specOnly flag controls whether to fetch data
 * @param queryMap: a map of queryId -> APColumnSelector specifications
 *                 or {query: APColumnSelector, specOnly: bool}
 *                 When providing {query, specOnly}, the specOnly flag controls whether to fetch data
 * @param opts: an optional map containing additional options:
 *                 - ignoreMissingDomains: bool (default: false) - If true, ignores errors when referenced anchor domains are missing during resolution.
 *
 * === Return ===
 *
 * @returns Object with methods for retrieving anchor resolution and query results:
 *          getAnchor(anchorId) - Returns the resolved anchor for the given ID
 *              @param anchorId - The ID of the anchor to retrieve
 *              @returns The resolved anchor object {ref: spec: data:}
 *
 *          getResult(queryId) - Returns the query result for the given ID
 *              @param queryId - The ID of the query result to retrieve
 *              @returns The query result for the given ID
 */
_anchoredQuery := func(family, ctx, anchors, queryMap, opts) {
	// Validate query map schema
	validation.assertType(queryMap, _QUERY_MAP_SCHEMA, "invalid query map schema")

	// Process options
	normalizedOpts := _ANCHORED_QUERY_DEFAULT_OPTIONS
	if len(opts) > 0 {
		ll.assert(len(opts) == 1 && is_map(opts[0]), "expected single map for opts, got: ", opts)
		normalizedOpts = maps.deepMerge(normalizedOpts, opts[0])
	}

	// First, resolve all anchors
	resolvedAnchors := {}
	for anchorId, anchorValue in anchors {
		opts := { spec: true, data: true }

		ref := anchorValue
		if !is_undefined(anchorValue.ref) {
			ref = anchorValue.ref
			if anchorValue.specOnly {
				opts.data = false
			}
		}

		resolvedAnchors[anchorId] = _resolve(family, ref, ctx, [opts])
	}

	// Process the query items to handle specOnly flag
	processedQueryMap := {}
	for queryId, aQuery in queryMap {
		query := aQuery
		fetchData := true

		if !is_undefined(aQuery.query) {
			query = aQuery.query
			if aQuery.specOnly {
				fetchData = false
			}
		}

		processedQueryMap[queryId] = {
			query: query,
			fetchData: fetchData
		}
	}

	request := {
		queryMap: processedQueryMap,
		opts: normalizedOpts
	}
	if family != 1 {
		request.family = family
	}

	// Render the template with the appropriate parameters
	queryResult := render.createEphemeral(queryAnchoredTpl, {
		ctx: ctx,
		anchorSpecs: smart.createMapResource(maps.mapValues(resolvedAnchors, func(v) { return v.inputs().spec })),
		request: request
	})

	// Create structured result object with accessor methods
	self := undefined
	self = ll.toStrict({
		/**
		 * Get a specific anchor resolution result
		 * @param anchorId - The ID of the anchor to retrieve
		 * @returns The resolved anchor {ref: spec: data:}
		 */
		getAnchor: func(anchorId) {
			anchor := resolvedAnchors[anchorId]
			if is_undefined(anchor) {
				ll.panic("unknown anchor ID: " + anchorId)
			}
			return anchor
		},

		/**
		 * Get a specific query result by ID
		 * @param queryId - The ID of the query result to retrieve
		 * @returns The query result for the given ID
		 */
		getResult: func(queryId) {
			return queryResult.output("result/" + queryId)
		},

		/**
		 * Get the specification for a specific query result
		 * @param queryId - The ID of the query result to retrieve
		 * @returns The specification of the query result
		 */
		getResultSpec: func(queryId) {
			return self.getResult(queryId).getFutureInputField("spec")
		},

		/**
		 * Get the data for a specific query result
		 * @param queryId - The ID of the query result to retrieve
		 * @returns The data of the query result
		 */
		getResultData: func(queryId) {
			return self.getResult(queryId).getFutureInputField("data")
		},

		/**
		 * Get the reference for a specific query result
		 * @param queryId - The ID of the query result to retrieve
		 * @returns The reference of the query result
		 */
		getResultRef: func(queryId) {
			return self.getResult(queryId).getFutureInputField("ref")
		}
	})

	return self
}

anchoredQuery := func(ctx, anchors, queryMap, ...opts) {
	return _anchoredQuery(1, ctx, anchors, queryMap, opts)
}

/**
 * The query API of one resolver family: `{create, resolve, anchoredQuery}`, with the signatures and
 * meaning of this module's functions of the same names.
 *
 * Family 1 is this module's own functions: resolvers BResolveSingle/1 and BResolveChoice/1 over
 * BContext/1 chains. Family 2 creates BResolveSingle/2 and BResolveChoice/2, which resolve over
 * BContext/2 chains (platforma2); its results decode with the family-2 rules of `resultUnmarshaller`.
 * A family-1 query over a platforma2 context finds no values there (it answers "not found"); a
 * family-2 resolver needs a BContext/2 or BContextEnd/1 and fails on a BContext/1.
 *
 * Results are told apart by `family: 2` in the options they store, so a family-1 caller must not pass
 * an option named `family`.
 *
 * Family 2 differs from family 1 in what it takes:
 *  - a ref is `{block, workflow, name}`: exactly these three fields, non-empty strings, `block` and
 *    `workflow` without "/" — the block id, the name of the block's workflow that exports the value,
 *    and the value's path in that workflow's exported tree joined with "."; decoded results carry
 *    refs in this form, and `isRef(value)` tells whether a value is one;
 *  - the options of `create` and `resolve` are checked: only `spec`, `data` (fetch the spec or the
 *    data; both by default) and, for `create`, `single`, each a boolean; anything else panics
 *    (`anchoredQuery` keeps its own options);
 *  - a single lookup — `resolve`, or `create` with `single` — finds exactly one value: none, or more
 *    than one, is an error; `create` without `single` finds every match, none being an empty list.
 *
 * Each call returns a new object; both families can be used in one template.
 *
 * @param family: 1 or 2; anything else panics
 */
forFamily := func(family) {
	ll.assert(family == 1 || family == 2, "unknown resolver family: %v, expected 1 or 2", family)
	if family == 1 {
		return ll.toStrict({
			create: func(spec, ctx, ...options) {
				return _create(1, spec, ctx, options)
			},
			resolve: func(ref, ctx, ...options) {
				return _resolve(1, ref, ctx, options)
			},
			anchoredQuery: func(ctx, anchors, queryMap, ...opts) {
				return _anchoredQuery(1, ctx, anchors, queryMap, opts)
			}
		})
	}
	return ll.toStrict({
		create: func(spec, ctx, ...options) {
			ops := _family2Options(options, ["spec", "data", "single"])
			if ops.single == true {
				ops.first = true
				ops.errIfMissing = true
			}
			delete(ops, "single")
			return _create(2, spec, ctx, [ops])
		},
		resolve: func(ref, ctx, ...options) {
			return _resolve(2, ref, ctx, [_family2Options(options, ["spec", "data"])])
		},
		anchoredQuery: func(ctx, anchors, queryMap, ...opts) {
			return _anchoredQuery(2, ctx, anchors, queryMap, opts)
		},
		isRef: _isFamily2Ref
	})
}

export ll.toStrict({
	create: create,
	resolve: resolve,
	resultUnmarshaller: resultUnmarshaller,
	anchoredQuery: anchoredQuery,
	forFamily: forFamily
})
