/*
 * Column value references in block args.
 *
 * A block that lets the user pick values of another block's column passes each picked
 * value to its workflow as a ColumnValueId: the canonical JSON string of
 * `{ __isColumnValue: true, column: <column id>, value: <string | number> }`.
 * The id names the column the value came from, so the project knows which block
 * produced it. The workflow itself needs only the value.
 *
 * A ColumnValueId can sit in args as a plain value or as a map key, and may be wrapped
 * in extra layers of JSON string escaping. All functions here accept every such form.
 *
 * Numbers keep the type JSON decoding gives them: an integral value (`2`) comes back as
 * int, a fractional one (`2.5`) as float — the same as if the value were written into
 * args directly.
 */

ll := import(":ll")
json := import("json")
text := import("text")
validation := import(":validation")

_parseColumnValueId := undefined // Forward declaration
_unwrap := undefined // Forward declaration

/**
 * Whether the given object is a ColumnValueId.
 *
 * @param s: any
 * @return bool: true for a string that decodes, possibly through extra layers of JSON
 *               string escaping, to a map with `__isColumnValue: true`
 */
isColumnValueId := func(s) {
	return !is_undefined(_parseColumnValueId(s))
}

/**
 * Value carried by a ColumnValueId.
 *
 * @param x: any
 * @return value: string | int | float - the picked value when x is a ColumnValueId;
 *                x itself otherwise
 */
valueOf := func(x) {
	key := _parseColumnValueId(x)
	if is_undefined(key) {
		return x
	}

	value := key.value
	ll.assert(
		is_string(value) || is_int(value) || is_float(value),
		"column-value: value of a column value id must be a string or a number, got %v", value
	)
	return value
}

/**
 * Values carried by an array of ColumnValueIds.
 *
 * @param xs: []any
 * @return values: []any - valueOf applied to every element, order preserved
 */
valuesOf := func(xs) {
	ll.assert(is_array(xs) || is_immutable_array(xs), "column-value.valuesOf: expected an array, got %v", xs)

	result := []
	for x in xs {
		result = append(result, valueOf(x))
	}
	return result
}

/**
 * Deep-walks maps and arrays and replaces every ColumnValueId, whether it is a value or
 * a map key, with the value it carries. Everything else is kept as is.
 *
 * A number value used as a map key becomes its string form, since map keys are strings.
 * Panics when two keys of one map end up equal after the replacement.
 *
 * Strict maps (resources, fields, library objects) are runtime objects rather than
 * decoded args, so they are not walked. A container without ColumnValueIds inside is
 * returned as the same object.
 *
 * @param x: any
 * @return unwrapped: any
 */
unwrapValues := func(x) {
	unwrapped := _unwrap(x)
	if is_undefined(unwrapped) {
		return x
	}
	return unwrapped
}

// options scheme for argsWithOptions
_ARGS_OPTIONS_SCHEME := {
	"__options__,closed": "",
	"unwrapValues,?": `bool`
}

/**
 * Block arguments as a workflow callback receives them.
 *
 * @param args: map - block arguments
 * @param options: optional {unwrapValues: bool}. With unwrapValues: true, every
 *                 ColumnValueId in args, as a value or as a map key, is replaced with the
 *                 value it carries (see unwrapValues). Without options, or with
 *                 unwrapValues: false, args are returned as they are.
 * @return args: map
 */
argsWithOptions := func(args, ...options) {
	if len(options) == 0 {
		return args
	}
	ll.assert(len(options) == 1, "column-value.argsWithOptions: expected a single options map, got %v", options)
	validation.assertType(options[0], _ARGS_OPTIONS_SCHEME, "column-value.argsWithOptions: invalid options")

	if options[0].unwrapValues == true {
		return unwrapValues(args)
	}
	return args
}

//
// Internals
//

/**
 * Decodes a ColumnValueId into its key map.
 *
 * Only a string that starts with `{` or `"` can be JSON of a map or of an escaped string,
 * so other strings are rejected without decoding. A decoding pass that yields a string
 * means one layer of escaping; it is peeled and the result decoded again. Each such pass
 * makes the string strictly shorter, which bounds the loop.
 *
 * @param s: any
 * @return key: map | undefined - undefined when s is not a ColumnValueId
 */
_parseColumnValueId = func(s) {
	if !is_string(s) {
		return undefined
	}

	current := s
	for {
		if !text.has_prefix(current, "{") && !text.has_prefix(current, "\"") {
			return undefined
		}

		decoded := json.decode(current)
		if is_error(decoded) {
			return undefined
		}

		if is_string(decoded) {
			if len(decoded) >= len(current) {
				return undefined
			}
			current = decoded
			continue
		}

		if !is_map(decoded) || decoded.__isColumnValue != true {
			return undefined
		}
		return decoded
	}
}

/**
 * The walk behind unwrapValues.
 *
 * @param x: any
 * @return unwrapped: any | undefined - undefined when x holds no ColumnValueId, so an
 *                    untouched container is never rebuilt. A ColumnValueId never carries
 *                    undefined, so the two cases cannot be confused.
 */
_unwrap = func(x) {
	if is_string(x) {
		if !isColumnValueId(x) {
			return undefined
		}
		return valueOf(x)
	}

	if is_array(x) || is_immutable_array(x) {
		changed := false
		result := []
		for item in x {
			unwrapped := _unwrap(item)
			if is_undefined(unwrapped) {
				result = append(result, item)
			} else {
				result = append(result, unwrapped)
				changed = true
			}
		}
		if !changed {
			return undefined
		}
		return result
	}

	if is_map(x) || is_immutable_map(x) {
		changed := false
		result := {}
		seenKeys := {}
		for k, v in x {
			key := k
			if isColumnValueId(k) {
				key = string(valueOf(k))
				changed = true
			}
			ll.assert(
				is_undefined(seenKeys[key]),
				"column-value.unwrapValues: two map keys turn into the same key '%v' after unwrapping", key
			)
			seenKeys[key] = true

			unwrapped := _unwrap(v)
			if is_undefined(unwrapped) {
				result[key] = v
			} else {
				result[key] = unwrapped
				changed = true
			}
		}
		if !changed {
			return undefined
		}
		return result
	}

	return undefined
}

export ll.toStrict({
	isColumnValueId: isColumnValueId,
	valueOf: valueOf,
	valuesOf: valuesOf,
	unwrapValues: unwrapValues,
	argsWithOptions: argsWithOptions
})
