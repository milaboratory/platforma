/*
 * The entry of a platforma2 block workflow: what a block's main template imports, as V1 blocks
 * import `:workflow`. platforma2 is the next block runtime: a block exports a typed values tree
 * (`:v2.exports`), and downstream blocks read it through a chain of BContext/2 contexts.
 *
 * The project renders the template with the inputs `args` (JSON), `blockId` (a JSON string, the
 * block's id), `isProduction` (a JSON boolean: true for a run workflow, false for an auto one) and
 * `context` (the BContext/2 the block reads upstream values from, or a BContextEnd/1 when nothing is
 * upstream), and reads three outputs:
 *  - `result`: a map of the body's `outputs`;
 *  - `exports`: the node the body returned as `exports` (see `:v2.exports`), set directly; the
 *    project builds the block's context around it;
 *  - `effect`: the files the workflow imports, listed for the engine — the client-side runtime that
 *    sends uploads and reports import progress — and never read by block code (see `body`).
 *
 * A ref names a value another block's workflow exports:
 *
 *     { block: "<block id>", workflow: "<workflow name>", name: "<value name>" }
 *
 * exactly these three fields, each a non-empty string, `block` and `workflow` without "/"; the value
 * name is its path in that workflow's exported tree joined with ".". `resolve`, the anchors of
 * `anchoredQuery`, the bundle collector's refs and the table builder's ref inputs take refs in this
 * form, and query results carry them in this form.
 *
 * Queries resolve with the BContext/2 family (`:v2.bquery`). A query finds every match (none is an
 * empty list); a single lookup — `resolve`, or `query` with `single` — finds exactly one value, and
 * none or more than one fails the render. A value exported without data reaches a template in one of
 * these forms, by the path it took:
 *  - decoded (a `prepare` result, or a sub-template's input): an item `{ref, spec}` with no `data`
 *    key; the item is a strict map, so test with `maps.containsKey(item, "data")`, not `item.data`;
 *  - in a PColumnBundle: `data` is undefined;
 *  - `resolve(ref).data` in the body: a future that resolves to the no-result marker
 *    (BResolveSingleNoResult/1); `:v2.exports.collection` leaves it out when it has already resolved
 *    there, and the UI export leaves out data that has resolved there by the time the collection's
 *    specs are ready;
 *  - as a table builder input: the table's run fails (see `tableBuilder`).
 *
 * Unstable: this module and every `:v2.*` module may change in any release.
 */

ll := import(":ll")
text := import("text")
smart := import(":smart")
sets := import(":sets")
oop := import(":oop")
bquery := import(":v2.bquery")
exports := import(":v2.exports")
pBundle := import(":pframes.bundle")
pTableBuilder := import(":pframes.table-builder")
file := import(":file")

self := import(":tpl")

_RESULT_OUTPUT := "result"
_EXPORTS_OUTPUT := "exports"
_EFFECT_OUTPUT := "effect"
_INPUT_CONTEXT := "context"

// the effect's section listing the files the workflow imports, one field per source
_IMPORTS_SECTION := "imports"

// one file the workflow imports, as the effect lists it: Input fields `upload` (upload grants
// only), `progress` and `file`
_RTYPE_IMPORT_ENTRY := { Name: "ImportEntry", Version: "1" }

// the prefix of a source the client uploads; the backend imports any other accepted source without
// the client
_UPLOAD_SOURCE_PREFIX := "upload://upload/"

// a field name prefix of the inputs that 'prepare()' requested
_PREPARED_INPUTS_PREFIX := "prepared/"

// declared for the prepare route, where the framework creates and locks the outputs before the
// body runs (the template is ephemeral)
self.defineOutputs([_RESULT_OUTPUT, _EXPORTS_OUTPUT, _EFFECT_OUTPUT])

/**
 * Whether this render is a run workflow (true) or an auto one (false).
 */
isProduction := func() {
	return self.rawInputs().isProduction.getValueAsJson() == true
}

_args := undefined

/**
 * Block arguments map, with the resources requested by `prepare` added under their names.
 */
args := func() {
	if is_undefined(_args) {
		inputs := self.inputs()

		_args = inputs.args
		if is_undefined(_args) || smart.isReference(_args) {
			ll.panic("Unexpected args type: %v", _args)
		}

		for k, v in inputs {
			if text.has_prefix(k, _PREPARED_INPUTS_PREFIX) {
				name := text.trim_prefix(k, _PREPARED_INPUTS_PREFIX)
				ll.assert(is_undefined(_args[name]), "prepare name is already in use in inputs: %s", name)
				_args[name] = v
			}
		}
	}
	return _args
}

_blockId := undefined

/**
 * The block id input, a resource holding a JSON string.
 */
blockId := func() {
	if is_undefined(_blockId) {
		_blockId = self.inputs().blockId
		ll.assert(!is_undefined(_blockId), "block id is not set in workflow inputs")
	}
	return _blockId
}

/**
 * The block id as a string.
 */
getBlockId := func() {
	ret := blockId().getDataAsJson()
	ll.assert(is_string(ret), "block id is not a string")
	return ret
}

_parentContext := undefined

/**
 * The context upstream values are read from: a BContext/2, or a BContextEnd/1 for a block with
 * nothing upstream.
 */
getParentBCtx := func() {
	if is_undefined(_parentContext) {
		_parentContext = self.inputs()[_INPUT_CONTEXT]
		if is_undefined(_parentContext) {
			ll.panic("parent context is not set in inputs")
		}
	}
	return _parentContext
}

/**
 * Query the values upstream: see `:workflow.bquery`'s `create` for the query spec.
 *
 * @param spec: query spec
 * @param options: optional {spec?: bool, data?: bool, single?: bool} — fetch the spec or the data
 *        (both by default; a result without its spec cannot be decoded, only read field by field);
 *        `single`: exactly one value must match, else the render fails
 * @return the query result; decodes to a list of {ref, spec, data?}, or with `single` to that one item
 */
query := func(spec, ...options) {
	return bquery.create(spec, getParentBCtx(), options...)
}

_resolveOne := func(r, ...options) {
	res := bquery.resolve(r, getParentBCtx(), options...)
	return ll.toStrict(oop.inherit(res, {
		spec: res.getFutureInputField("spec"),
		data: res.getFutureInputField("data")
	}))
}

/**
 * Resolves one ref into { spec, data }: exactly one value must be found, else the render fails.
 *
 * @param ref: a ref {block, workflow, name} (see the header)
 * @param options: optional {spec?: bool, data?: bool} — fetch the spec or the data (both by default;
 *        a result without its spec cannot be decoded, only read field by field)
 */
resolve := func(ref, ...options) {
	return _resolveOne(ref, options...)
}

/**
 * Resolves anchors and the queries anchored to them in one operation (see `:workflow.bquery`'s
 * `anchoredQuery`).
 */
anchoredQuery := func(anchors, queryMap, ...opts) {
	return bquery.anchoredQuery(getParentBCtx(), anchors, queryMap, opts...)
}

/**
 * Requests resources the body needs resolved: `cb(args)` returns a map of references; the body runs
 * once they are ready, with each under its name in `args`. Applies to run and auto workflows alike.
 * Files are imported in the body, not here (see `body`): an upload grant imported here with `:file`'s
 * `importFile` is not listed for the engine, so unless something else uploads it, it never resolves
 * and the body never runs.
 *
 * @param cb: func(args) map
 */
prepare := func(cb) {
	self.prepare(func(_) {
		raw := cb(args())
		prefixed := {}
		for k, v in raw {
			prefixed[_PREPARED_INPUTS_PREFIX + k] = v
		}
		return prefixed
	})
}

/**
 * Validate that arguments fulfil the desired schema.
 */
validateArgs := func(argsSchema) {
	self.validateInputs({
		args: argsSchema
	})
}

/**
 * A PColumnBundle collector resolving upstream (see `:pframes.bundle`'s `createBuilder`). In the
 * bundle a template receives, a value without data has `data` undefined.
 */
createPBundleBuilder := func() {
	return pBundle.createBuilderWith(bquery, getParentBCtx())
}

/**
 * A table builder resolving its unresolved inputs upstream (see `:pframes.table-builder`). Inputs
 * are refs, resolved columns `{spec, data}` and column query specs. Every column needs data: a value
 * exported without data, reached through a ref or a single-match query, fails the table's run with
 * "unsupported p-column data type" naming BResolveSingleNoResult; reached as an item of a
 * multi-match query, it fails earlier, while the columns are assembled.
 *
 * @param format: string — "tsv" | "csv" | "parquet" | "ndjson"
 */
tableBuilder := func(format) {
	return pTableBuilder.tableBuilderWith(bquery, format, getParentBCtx())
}

// The template's outputs must be exactly `result`, `exports` and `effect`. A module that imports `:workflow`
// declares the output `context` too; on the prepare route the framework creates every declared
// output, and `context` would never be set, so the render would never finish.
_assertOwnOutputs := func() {
	defined := sets.fromSlice(self.definedOutputs())
	if defined != sets.fromSlice([_RESULT_OUTPUT, _EXPORTS_OUTPUT, _EFFECT_OUTPUT]) {
		ll.panic("a v2 workflow's outputs are exactly result, exports and effect, but this template defines %v; " +
			"is something it imports using @platforma-sdk/workflow-tengo:workflow?", sets.toSlice(defined))
	}
}

// The effect of one body call: `api` is the body's second argument, and `build` makes the `effect`
// output once the body has returned, after which `api` refuses further imports.
_newEffect := func() {
	// source -> { entry, file }; ImportEntry resources are created as sources are imported
	imported := {}
	built := false

	importFile := func(source) {
		ll.assert(is_string(source), "effect.importFile takes a source string, got %v", source)
		if built {
			ll.panic("effect.importFile(%q) was called after the workflow body returned; " +
				"import every file inside the body", source)
		}
		if is_undefined(imported[source]) {
			importer := file.importFile(source)
			entry := smart.ephemeralBuilder(_RTYPE_IMPORT_ENTRY)
			if text.has_prefix(source, _UPLOAD_SOURCE_PREFIX) {
				entry.createInputField("upload").set(importer.handle)
			}
			entry.createInputField("progress").set(importer.progress)
			entry.createInputField("file").set(importer.file)
			imported[source] = { entry: entry.lockAndBuild(), file: importer.file }
		}
		return imported[source].file
	}

	build := func() {
		built = true
		imports := smart.ephemeralMapBuilder()
		for source, i in imported {
			imports.addRef(source, i.entry)
		}
		effect := smart.ephemeralMapBuilder()
		effect.addRef(_IMPORTS_SECTION, imports.build())
		return effect.build()
	}

	return {
		api: ll.toStrict({ importFile: importFile }),
		build: build
	}
}

_buildOutputs := func(results, effect) {
	ll.assert(ll.isMap(results) && !smart.isReference(results), "expected to see map result from body function")
	ll.assert(
		sets.fromSlice(["outputs", "exports"]) == sets.fromMapKeys(results),
		"expected only outputs and exports in the returned map, found %v", sets.toSlice(sets.fromMapKeys(results))
	)
	ll.assert(ll.isMap(results.outputs) && !smart.isReference(results.outputs),
		"expected a map in outputs returned from workflow.body")

	exports.assertNode(results.exports, "exports")

	resBuilder := smart.mapBuilder()
	for name, value in results.outputs {
		ll.assert(!is_undefined(value), "value is undefined for output %s", name)
		resBuilder.add(name, value)
	}

	tplOutputs := {}
	tplOutputs[_RESULT_OUTPUT] = resBuilder.build()
	tplOutputs[_EXPORTS_OUTPUT] = results.exports
	tplOutputs[_EFFECT_OUTPUT] = effect.build()
	return tplOutputs
}

/**
 * Defines the workflow's body: `fn(args, effect)` returns `{outputs, exports}`, where `outputs` is
 * a map and `exports` is one node (`:v2.exports`). Runs for run and auto workflows alike.
 *
 * `effect` imports files and lists them for the engine, which reports each import and, for an
 * upload grant, sends the upload:
 *
 *     file := import("@platforma-sdk/workflow-tengo:file")
 *
 *     wf.body(func(args, effect) {
 *         reads := effect.importFile(args.reads)
 *         return { outputs: { reads: file.exportFile(reads) }, exports: ex.collection({}) }
 *     })
 *
 * `effect.importFile(source)` takes what `:file`'s `importFile` takes, parsed and validated by it —
 * an upload grant (`upload://upload/…`, a local file or a URL the client uploads) or a library file
 * (`index://index/…`, which the backend imports without the client) — and returns a reference to
 * the imported file; no output of the block has to start or report the import. Sources are compared
 * as strings: the same string again returns the same file, and two different strings naming the
 * same file are imported and listed twice. The whole source string becomes a field name, so it must
 * fit the backend's limit of 65,535 bytes. A failed import puts its error on the imported file; the
 * backend reports it on the entry, the `imports` map and `effect` once all inputs of each are
 * final, so another import still running delays it there.
 *
 * Only the workflow body imports this way: `effect` exists only as this argument, and calling
 * `effect.importFile` after the body has returned panics. `prepare` gets no effect, and neither
 * does a sub-template: import in the body and pass the file on. A file imported with `:file`'s
 * `importFile` anywhere else is not listed, so the engine neither reports it nor uploads it: unless
 * something else uploads an upload grant imported that way, its file never becomes ready.
 *
 * Once the body has returned, the render's `effect` output is an ephemeral map with inputs locked:
 * its field `imports` is an ephemeral map, inputs locked and empty when nothing was imported, with
 * one field per imported source string, named by it, to an ephemeral ImportEntry/1 with inputs
 * locked, whose Input fields are `upload` (the storage-side upload a client sends parts to, present
 * for an upload grant only), `progress` (the import's map of progress steps) and `file` (the imported
 * file). A body that fails sets no output.
 *
 * @param fn: func(args, effect) {outputs, exports}
 */
body := func(fn) {
	_assertOwnOutputs()
	self.body(func(_) {
		effect := _newEffect()
		return _buildOutputs(fn(args(), effect.api), effect)
	})
}

export ll.toStrict({
	getParentBCtx: getParentBCtx,
	query: query,
	resolve: resolve,
	anchoredQuery: anchoredQuery,
	prepare: prepare,
	args: args,
	rawInputs: self.rawInputs,
	body: body,
	isProduction: isProduction,
	blockId: blockId,
	getBlockId: getBlockId,
	validateArgs: validateArgs,
	createPBundleBuilder: createPBundleBuilder,
	tableBuilder: tableBuilder
})
