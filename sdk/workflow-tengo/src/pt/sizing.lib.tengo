// Default resource sizing for a ptabler run. Used by :pt.workflow-run when the block
// author leaves cpu or mem unset. Kept out of the template body so the formulas can be
// unit tested against a fake metric resolver (see sizing.test.tengo).
//
//     ram = between(2 GiB + 6 * size, memFloor or 2 GiB, 256 GiB)
//     cpu = between(2 + size / 16 GiB, 2, 8)
//
// Measured need per GiB of input, per plan shape, at 8 Polars threads:
//     concat + aggregate with max_by   4.94   <- the steepest one reachable here
//     bulk export                      2.92
//     single-cell export               1.40
//     write_frame                      4.13 x^0.68, sub-linear
// One formula serves every shape, so it carries the steepest. CPU_MAX is 8, and no call
// site sets cpu without also setting mem, so 8 threads is the ceiling these formulas run
// at. The same aggregate shape needs 6.85 at 32 threads, which only a site that pins cpu
// above 8 and leaves mem auto would reach.
//
// RAM_SLOPE is 6, above the 4.94 it must cover. The margin is deliberate. The fits are
// against uncompressed TSV bytes, and f.size() reports stored blob bytes, so a parquet
// input understates the volume the plan decodes.
//
// f.size() counts only files attached with addFile(). A non-partitioned JSON p-column is
// attached with writeFile() and contributes nothing, so a frame built only from those
// columns sizes to the intercept or the floor. See :exec.formula for the full rule.

// Scratch space holds everything ptabler spills: the table pframes-rs writes for each
// read_frame, and for each write_frame the unsorted and intermediate parquet files and the
// temporary files of the DuckDB sort. Peak scratch per GiB of input, measured with DuckDB
// forced to spill the whole sort:
//     read_frames  shape              peak / input
//     0            parquet -> frame   9.5
//     1            4 shapes           1.9 - 11.9
//     3            4 shapes           3.5 - 36.4
//     6            2 shapes           29 - 61
// The steepest shape is a sequential Long axis with constant values: it stores in about
// 2 bytes per row, and pframes-rs writes its joined table uncompressed. Every read_frame
// table lives until collect_all ends, so the need grows with their count; the sorts run
// one at a time, but every write_frame keeps its compressed unsorted file until its turn.
//
//     scratch = size * (16 * (read_frames + 1) + 2 * write_frames)
//
// covers every measurement by 1.8x or more. Below SCRATCH_DEVICE_MIN_GIB the request is 0:
// the spill stays on the working directory's filesystem, as before, and a small run does not
// wait for a volume to be created and attached. A plan with no frames asks for 0 too.
//
// The formula is an estimate, not a bound. A column that compresses far better than the
// shapes above can need more, and the volume then fills and the run fails with a disk
// error. Use pt.workflow().scratchFreeSpace() to set the size by hand.

f := import(":exec.formula")
ll := import(":ll")
units := import(":units")

RAM_INTERCEPT_GIB := 2
RAM_SLOPE := 6
RAM_FLOOR_GIB := 2
RAM_CAP_GIB := 256
RAM_STATIC_FALLBACK := "4GiB"

SCRATCH_PER_READ_FRAME := 16
SCRATCH_SORT := 16
SCRATCH_PER_WRITE_FRAME := 2
SCRATCH_DEVICE_MIN_GIB := 16

CPU_MIN := 2
CPU_MAX := 8
CPU_GIB_PER_CORE := 16

/**
 * The default RAM formula.
 *
 * @param memFloor: number | undefined - lower bound in bytes from .memFloor(), or
 *                  undefined for the standard 2 GiB floor.
 * @return formula
 */
ramFormula := func(memFloor) {
	floor := f.gib(RAM_FLOOR_GIB)
	cap := f.gib(RAM_CAP_GIB)
	fallback := RAM_STATIC_FALLBACK

	if !is_undefined(memFloor) {
		// A floor above the cap is rejected at the .memFloor() setter, not here.
		// Raising the cap to match would make between(floor, floor) return the floor
		// for every input, which is the flat pin memFloor exists to avoid.
		ll.assert(memFloor <= RAM_CAP_GIB * units.GiB,
			"pt.sizing: memFloor (%v bytes) must not exceed the %d GiB ceiling", memFloor, RAM_CAP_GIB)
		floor = f.const(memFloor)
		fallback = memFloor
	}

	return f.size({ default: 0 }).times(RAM_SLOPE).plus(f.gib(RAM_INTERCEPT_GIB)).
		between(floor, cap).
		staticFallback(fallback)
}

/**
 * The default CPU formula. Raising CPU_MAX raises the RAM requirement too -- the same
 * plan needs 4.09 / 4.94 / 6.85 GiB per input GiB at 2 / 8 / 32 Polars threads.
 *
 * @return formula
 */
cpuFormula := func() {
	return f.size({ default: 0 }).dividedByFloor(f.gib(CPU_GIB_PER_CORE)).plus(f.const(CPU_MIN)).
		between(f.const(CPU_MIN), f.const(CPU_MAX)).
		staticFallback(CPU_MIN)
}

/**
 * The default scratch formula.
 *
 * @param readFrames: number - read_frame steps in the workflow
 * @param writeFrames: number - write_frame steps in the workflow
 * @return formula, or 0 for a workflow without frames
 */
scratchFormula := func(readFrames, writeFrames) {
	ll.assert(is_int(readFrames) && readFrames >= 0 && is_int(writeFrames) && writeFrames >= 0,
		"pt.sizing: frame counts must be non-negative integers, got %v and %v", readFrames, writeFrames)
	if readFrames == 0 && writeFrames == 0 {
		return 0
	}
	factor := SCRATCH_PER_READ_FRAME * readFrames + SCRATCH_SORT + SCRATCH_PER_WRITE_FRAME * writeFrames
	estimate := f.size({ default: 0 }).times(factor)
	return f.when(estimate.lt(f.gib(SCRATCH_DEVICE_MIN_GIB)), 0).otherwise(estimate)
}

export {
	ramFormula: ramFormula,
	cpuFormula: cpuFormula,
	scratchFormula: scratchFormula,

	// exported for the unit tests and for callers that need the documented numbers
	RAM_INTERCEPT_GIB: RAM_INTERCEPT_GIB,
	RAM_SLOPE:         RAM_SLOPE,
	RAM_FLOOR_GIB:     RAM_FLOOR_GIB,
	RAM_CAP_GIB:       RAM_CAP_GIB,
	CPU_MIN:           CPU_MIN,
	CPU_MAX:           CPU_MAX,
	SCRATCH_PER_READ_FRAME:  SCRATCH_PER_READ_FRAME,
	SCRATCH_SORT:            SCRATCH_SORT,
	SCRATCH_PER_WRITE_FRAME: SCRATCH_PER_WRITE_FRAME,
	SCRATCH_DEVICE_MIN_GIB:  SCRATCH_DEVICE_MIN_GIB
}
