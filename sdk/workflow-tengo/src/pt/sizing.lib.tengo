// Default resource sizing for a ptabler run. Used by :pt.workflow-run when the block
// author leaves cpu or mem unset. Kept out of the template body so the formulas can be
// unit tested against a fake metric resolver (see sizing.test.tengo).
//
//     ram                = between(2 GiB + 7 * volume, memFloor or 2 GiB, memCeiling or none)
//     volume             = decoded + size(STORED_TAG) + 4 * size(COMPRESSED_TAG)
//     cpu                = between(2 + size / 16 GiB, 2, 8)
//     POLARS_MAX_THREADS = between(system.cpu, 2, 8)
//
// volume estimates the decoded bytes the plan reads:
//     decoded             Parquet frame chunks, from .datainfo stats.numberOfBytes, summed
//                         at render time. Axes bytes count once per Parquet blob, because
//                         every p-column stored in a blob repeats the same axes stats.
//     size(STORED_TAG)    blob bytes of every other input: plain inFiles, JSON and binary
//                         chunks, and Parquet chunks that carry no numberOfBytes stats.
//     size(COMPRESSED_TAG) blob bytes of inFiles named *.gz, *.bz2 or *.zst, times
//                         COMPRESSED_RATIO.
//
// Measured need per GiB of input, per plan shape, at 8 Polars threads:
//     concat + aggregate with max_by   4.94   <- the steepest one reachable here
//     bulk export                      2.92
//     single-cell export               1.40
//     write_frame                      4.13 x^0.68, sub-linear
// One formula serves every shape, so it carries the steepest. The slopes hold at 8
// Polars threads or fewer; the same aggregate shape needs 6.22 at 16 threads. Polars
// threads are therefore clamped to CPU_MAX whatever cpu the run is granted, including
// an explicit cpu() above 8, which reserves cores Polars does not use.
//
// RAM_SLOPE is 7. On decoded bytes it covers every measured cell by 1.38x or more.
//
// There is no ceiling unless the block sets .memCeiling(). The backend reduces a request
// above what the host can give.
//
// f.size() counts only files attached with addFile(). A non-partitioned JSON p-column is
// attached with writeFile() and contributes nothing, so a frame built only from those
// columns sizes to the intercept or the floor. See :exec.formula for the full rule.

// Scratch space holds everything ptabler spills: the table pframes-rs writes for each
// read_frame, and for each write_frame the unsorted and intermediate parquet files and the
// temporary files of the DuckDB sort. Peak scratch per GiB of input, measured with DuckDB
// forced to spill the whole sort:
//     read_frames  shape              peak / input
//     0            parquet -> frame   9.5
//     1            4 shapes           1.9 - 11.9
//     3            4 shapes           3.5 - 36.4
//     6            2 shapes           29 - 61
// The steepest shape is a sequential Long axis with constant values: it stores in about
// 2 bytes per row, and pframes-rs writes its joined table uncompressed. Every read_frame
// table lives until collect_all ends, so the need grows with their count; the sorts run
// one at a time, but every write_frame keeps its compressed unsorted file until its turn.
//
//     scratch = size * (16 * (read_frames + 1) + 2 * write_frames)
//
// covers every measurement by 1.8x or more. Below SCRATCH_DEVICE_MIN_GIB the request is 0:
// the spill stays on the working directory's filesystem, as before, and a small run does not
// wait for a volume to be created and attached. A plan with no frames asks for 0 too.
//
// The formula is an estimate, not a bound. A column that compresses far better than the
// shapes above can need more, and the volume then fills and the run fails with a disk
// error. Use pt.workflow().scratchFreeSpace() to set the size by hand.

f := import(":exec.formula")
ll := import(":ll")
text := import("text")
units := import(":units")

RAM_INTERCEPT_GIB := 2
RAM_SLOPE := 7
RAM_FLOOR_GIB := 2
RAM_STATIC_FALLBACK := "4GiB"
RAM_STATIC_FALLBACK_BYTES := 4 * units.GiB

// Tags on the files the RAM formula reads by blob size. Untagged files still count for
// cpu and scratch, which read f.size() over every file.
STORED_TAG := "pt-sizing-stored"
COMPRESSED_TAG := "pt-sizing-compressed"
COMPRESSED_RATIO := 4
_COMPRESSED_SUFFIXES := [".gz", ".bz2", ".zst"]

SCRATCH_PER_READ_FRAME := 16
SCRATCH_SORT := 16
SCRATCH_PER_WRITE_FRAME := 2
SCRATCH_DEVICE_MIN_GIB := 16

CPU_MIN := 2
CPU_MAX := 8
CPU_GIB_PER_CORE := 16

// Backend expression for POLARS_MAX_THREADS; system.cpu is the granted core count.
POLARS_MAX_THREADS_EXPR := format("{min(%d,max(%d,system.cpu))}", CPU_MAX, CPU_MIN)

/**
 * The tag for an input file attached by name: COMPRESSED_TAG for *.gz, *.bz2 and *.zst,
 * STORED_TAG otherwise.
 *
 * @param fileName: string
 * @return string
 */
fileTag := func(fileName) {
	lower := text.to_lower(fileName)
	for suffix in _COMPRESSED_SUFFIXES {
		if text.has_suffix(lower, suffix) {
			return COMPRESSED_TAG
		}
	}
	return STORED_TAG
}

/**
 * Reads the decoded-size stats of one Parquet chunk.
 *
 * @param blobId: string | number - id of the chunk's Parquet blob
 * @param chunk: map - the chunk's .datainfo part: its metadata merged with its mapping
 * @return { blob, column, axesBytes, columnBytes }, or undefined if the chunk has no
 *         stats.numberOfBytes
 */
parquetChunkStats := func(blobId, chunk) {
	if is_undefined(chunk.stats) || is_undefined(chunk.stats.numberOfBytes) {
		return undefined
	}
	bytes := chunk.stats.numberOfBytes
	axesBytes := 0
	for b in bytes.axes {
		axesBytes += b
	}
	return {
		blob: string(blobId),
		column: chunk.column.id,
		axesBytes: axesBytes,
		columnBytes: bytes.column
	}
}

/**
 * Sums decoded bytes over Parquet chunks. Axes bytes count once per blob; column bytes
 * count once per (blob, column).
 *
 * @param chunks: array of parquetChunkStats() results
 * @return number - bytes
 */
decodedFrameBytes := func(chunks) {
	axesByBlob := {}
	columnBytes := {}
	for c in chunks {
		if is_undefined(axesByBlob[c.blob]) || c.axesBytes > axesByBlob[c.blob] {
			axesByBlob[c.blob] = c.axesBytes
		}
		columnBytes[c.blob + "/" + c.column] = c.columnBytes
	}
	total := 0
	for _, b in axesByBlob {
		total += b
	}
	for _, b in columnBytes {
		total += b
	}
	return total
}

/**
 * The default RAM formula.
 *
 * @param opts: map, every field optional:
 *   - memFloor: number - lower bound in bytes from .memFloor(); default 2 GiB
 *   - memCeiling: number - upper bound in bytes from .memCeiling(); default none
 *   - decodedBytes: number - decodedFrameBytes() of the Parquet chunks the formula does
 *                   not read by blob size; default 0
 * @return formula
 */
ramFormula := func(opts) {
	if is_undefined(opts) {
		opts = {}
	}
	memFloor := opts.memFloor
	memCeiling := opts.memCeiling
	decodedBytes := is_undefined(opts.decodedBytes) ? 0 : opts.decodedBytes
	ll.assert(is_int(decodedBytes) && decodedBytes >= 0,
		"pt.sizing: decodedBytes must be a non-negative integer, got %v", decodedBytes)

	floor := f.gib(RAM_FLOOR_GIB)
	floorBytes := RAM_FLOOR_GIB * units.GiB
	fallback := RAM_STATIC_FALLBACK
	if !is_undefined(memFloor) {
		floor = f.const(memFloor)
		floorBytes = memFloor
		fallback = memFloor
	}

	volume := f.size(STORED_TAG, { default: 0 }).
		plus(f.size(COMPRESSED_TAG, { default: 0 }).times(COMPRESSED_RATIO)).
		plus(f.const(decodedBytes))
	ram := volume.times(RAM_SLOPE).plus(f.gib(RAM_INTERCEPT_GIB))

	if is_undefined(memCeiling) {
		return ram.atLeast(floor).staticFallback(fallback)
	}

	ll.assert(memCeiling >= floorBytes,
		"pt.sizing: memCeiling (%v bytes) is below the floor (%v bytes). Set .memCeiling() at or above .memFloor(), and at or above 2 GiB.",
		memCeiling, floorBytes)
	if is_int(fallback) {
		fallback = fallback < memCeiling ? fallback : memCeiling
	} else if RAM_STATIC_FALLBACK_BYTES > memCeiling {
		fallback = memCeiling
	}
	return ram.between(floor, f.const(memCeiling)).staticFallback(fallback)
}

/**
 * The default CPU formula. Raising CPU_MAX raises the RAM requirement too -- the same
 * plan needs 4.09 / 4.94 / 6.85 GiB per input GiB at 2 / 8 / 32 Polars threads.
 *
 * @return formula
 */
cpuFormula := func() {
	return f.size({ default: 0 }).dividedByFloor(f.gib(CPU_GIB_PER_CORE)).plus(f.const(CPU_MIN)).
		between(f.const(CPU_MIN), f.const(CPU_MAX)).
		staticFallback(CPU_MIN)
}

/**
 * The default scratch formula.
 *
 * @param readFrames: number - read_frame steps in the workflow
 * @param writeFrames: number - write_frame steps in the workflow
 * @return formula, or 0 for a workflow without frames
 */
scratchFormula := func(readFrames, writeFrames) {
	ll.assert(is_int(readFrames) && readFrames >= 0 && is_int(writeFrames) && writeFrames >= 0,
		"pt.sizing: frame counts must be non-negative integers, got %v and %v", readFrames, writeFrames)
	if readFrames == 0 && writeFrames == 0 {
		return 0
	}
	factor := SCRATCH_PER_READ_FRAME * readFrames + SCRATCH_SORT + SCRATCH_PER_WRITE_FRAME * writeFrames
	estimate := f.size({ default: 0 }).times(factor)
	return f.when(estimate.lt(f.gib(SCRATCH_DEVICE_MIN_GIB)), 0).otherwise(estimate)
}

export {
	ramFormula: ramFormula,
	fileTag: fileTag,
	parquetChunkStats: parquetChunkStats,
	decodedFrameBytes: decodedFrameBytes,
	cpuFormula: cpuFormula,
	scratchFormula: scratchFormula,

	POLARS_MAX_THREADS_EXPR: POLARS_MAX_THREADS_EXPR,

	// exported for the unit tests and for callers that need the documented numbers
	RAM_INTERCEPT_GIB: RAM_INTERCEPT_GIB,
	RAM_SLOPE:         RAM_SLOPE,
	RAM_FLOOR_GIB:     RAM_FLOOR_GIB,
	STORED_TAG:        STORED_TAG,
	COMPRESSED_TAG:    COMPRESSED_TAG,
	COMPRESSED_RATIO:  COMPRESSED_RATIO,
	CPU_MIN:           CPU_MIN,
	CPU_MAX:           CPU_MAX,
	SCRATCH_PER_READ_FRAME:  SCRATCH_PER_READ_FRAME,
	SCRATCH_SORT:            SCRATCH_SORT,
	SCRATCH_PER_WRITE_FRAME: SCRATCH_PER_WRITE_FRAME,
	SCRATCH_DEVICE_MIN_GIB:  SCRATCH_DEVICE_MIN_GIB
}
