test := import(":test")
f := import(":exec.formula")
units := import(":units")
sizing := import(":pt.sizing")

// Evaluate a sizing formula the way exec.tpl does: resolve the metric against a file
// list, then evaluate with a resolver that reports a chosen total size.
_evalAt := func(formula, inputBytes) {
	resolved := f.resolveAst(formula, {}, ["in.tsv"])
	return f._internal.evaluate(resolved, {
		size:      func(files) { return inputBytes },
		lineCount: func(files) { return 0 }
	})
}

// inputBytes stays an integer throughout: the evaluator asserts integer operands, and
// a float would silently change the arithmetic it is being checked against.
_ram := func(inputBytes, opts) {
	return _evalAt(sizing.ramFormula(opts), inputBytes)
}

_fallback := func(opts) {
	return f.fallbackOf(sizing.ramFormula(opts))
}

_cpu := func(inputBytes) {
	return _evalAt(sizing.cpuFormula(), inputBytes)
}

GiB := units.GiB

// ---- ram: the documented curve --------------------------------------------
// ram = max(4 GiB + 10 * size, 5 GiB)

TestRamDefaultFloorAtSmallInput := func() {
	// Below (5 - 4) / 10 = 0.1 GiB of input, the 5 GiB floor wins.
	test.isEqual(5 * GiB, _ram(0, {}))
	test.isEqual(5 * GiB, _ram(64 * units.MiB, {}))
}

TestRamSlopeGoverns := func() {
	test.isEqual(14 * GiB, _ram(1 * GiB, {}))   //  4 + 10*1
	test.isEqual(44 * GiB, _ram(4 * GiB, {}))   //  4 + 10*4
	test.isEqual(84 * GiB, _ram(8 * GiB, {}))   //  4 + 10*8
}

TestRamHasNoCeiling := func() {
	test.isEqual(504 * GiB, _ram(50 * GiB, {}))
	test.isEqual(5004 * GiB, _ram(500 * GiB, {}))
}

TestUndefinedOptionsMatchTheDefault := func() {
	test.isEqual(_ram(8 * GiB, {}), _ram(8 * GiB, { floor: undefined, slope: undefined, intercept: undefined }))
}

// ---- ram: floor -----------------------------------------------------------

TestFloorRaisesTheLowerBound := func() {
	test.isEqual(12 * GiB, _ram(0, { floor: 12 * GiB }))
	test.isEqual(12 * GiB, _ram(512 * units.MiB, { floor: 12 * GiB }))
}

TestFloorDoesNotCapGrowth := func() {
	// Above (12 - 4) / 10 = 0.8 GiB of input, the formula wins.
	test.isEqual(14 * GiB, _ram(1 * GiB, { floor: 12 * GiB }))
	test.isEqual(204 * GiB, _ram(20 * GiB, { floor: 12 * GiB }))
}

TestFloorAboveOldCeilingIsAccepted := func() {
	test.isEqual(300 * GiB, _ram(0, { floor: 300 * GiB }))
	test.isEqual(5004 * GiB, _ram(500 * GiB, { floor: 300 * GiB }))
}

TestFloorBelowInterceptLeavesTheIntercept := func() {
	test.isEqual(4 * GiB, _ram(0, { floor: 2 * GiB }))
}

// ---- ram: slope and intercept ---------------------------------------------

TestCustomSlopeGoverns := func() {
	test.isEqual(44 * GiB, _ram(8 * GiB, { slope: 5 }))     //  4 + 5*8, the minimum slope
	test.isEqual(124 * GiB, _ram(8 * GiB, { slope: 15 }))   //  4 + 15*8
}

TestCustomIntercept := func() {
	test.isEqual(88 * GiB, _ram(8 * GiB, { intercept: 8 * GiB }))  //  8 + 10*8
	test.isEqual(84 * GiB, _ram(8 * GiB, { intercept: 4 * GiB }))  //  the minimum intercept
}

TestFloorStillAppliesWithCustomParams := func() {
	test.isEqual(12 * GiB, _ram(0, { floor: 12 * GiB, slope: 6, intercept: 4 * GiB }))
	test.isEqual(52 * GiB, _ram(8 * GiB, { floor: 12 * GiB, slope: 6, intercept: 4 * GiB }))  //  4 + 6*8
}

// ---- ram: static fallback -------------------------------------------------
// A backend that cannot evaluate formulas uses the static fallback, in bytes. It equals
// the smallest value the formula can give: max(intercept, floor).

TestFallbackDefault := func() {
	test.isEqual(5 * GiB, _fallback({}))
}

TestFallbackFollowsTheFloor := func() {
	test.isEqual(12 * GiB, _fallback({ floor: 12 * GiB }))
	test.isEqual(12 * GiB, _fallback({ floor: 12 * GiB, intercept: 8 * GiB }))
}

TestFallbackIsAtLeastTheIntercept := func() {
	test.isEqual(4 * GiB, _fallback({ floor: 2 * GiB }))
	test.isEqual(8 * GiB, _fallback({ intercept: 8 * GiB }))
	test.isEqual(8 * GiB, _fallback({ floor: 2 * GiB, intercept: 8 * GiB }))
}

// ll.assert rejects a non-integer or non-positive floor, a non-integer slope, a slope
// below 5, and an intercept below 4 GiB. ll.assert stops the template, and is_error cannot
// catch that. Thus no test checks it.

// ---- cpu ------------------------------------------------------------------
// cpu = between(2 + size / 16 GiB, 2, 8)

TestCpuCurve := func() {
	test.isEqual(sizing.CPU_MIN, _cpu(0))
	test.isEqual(2, _cpu(15 * GiB))                 // 2 + floor(15/16)
	test.isEqual(3, _cpu(16 * GiB))                 // 2 + 1
	test.isEqual(sizing.CPU_MAX, _cpu(1000 * GiB))  // clamped
}

// ---- polars threads -------------------------------------------------------
// POLARS_MAX_THREADS = between(system.cpu, 2, 8), evaluated by the backend.

TestPolarsThreadsClampedToCpuBounds := func() {
	test.isEqual("{min(8,max(2,system.cpu))}", sizing.POLARS_MAX_THREADS_EXPR)
}

// ---- an explicit mem() is not this module's business ----------------------

TestConstantsMatchTheDocumentedFormula := func() {
	test.isEqual(4, sizing.RAM_INTERCEPT_GIB)
	test.isEqual(4, sizing.RAM_INTERCEPT_MIN_GIB)
	test.isEqual(10, sizing.RAM_SLOPE)
	test.isEqual(5, sizing.RAM_SLOPE_MIN)
	test.isEqual(5, sizing.RAM_FLOOR_GIB)
	test.isEqual(2, sizing.CPU_MIN)
	test.isEqual(8, sizing.CPU_MAX)
}

// ---- scratch: the documented curve and its threshold ----------------------
// scratch = size * (16 * (read_frames + 1) + 2 * write_frames), 0 below 16 GiB

_scratch := func(inputBytes, readFrames, writeFrames) {
	formula := sizing.scratchFormula(readFrames, writeFrames)
	if is_int(formula) {
		return formula
	}
	resolved := f.resolveAst(formula, {}, ["in.parquet"])
	return f.evaluateScratch(resolved, {
		size:      func(files) { return inputBytes },
		lineCount: func(files) { return 0 }
	})
}

TestScratchWithoutFramesIsZero := func() {
	test.isEqual(0, _scratch(100 * GiB, 0, 0))
}

TestScratchSlopeCountsFrames := func() {
	test.isEqual(34 * GiB, _scratch(1 * GiB, 1, 1))    // 16 * 2 + 2
	test.isEqual(124 * GiB, _scratch(1 * GiB, 6, 6))   // 16 * 7 + 12
	test.isEqual(36 * GiB, _scratch(2 * GiB, 0, 1))    // 2 * (16 + 2)
}

TestScratchBelowThresholdIsZero := func() {
	// One join and one frame need 34 x input: 450 MiB estimates 14.9 GiB, 512 MiB 17 GiB.
	test.isEqual(0, _scratch(450 * units.MiB, 1, 1))
	test.isEqual(17 * GiB, _scratch(512 * units.MiB, 1, 1))
	test.isEqual(0, _scratch(0, 1, 1))
}
