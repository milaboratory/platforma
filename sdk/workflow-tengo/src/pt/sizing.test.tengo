test := import(":test")
f := import(":exec.formula")
units := import(":units")
sizing := import(":pt.sizing")

// Evaluate a sizing formula the way exec.tpl does: resolve the metric against a file
// list, then evaluate with a resolver that reports a chosen total size.
_evalAt := func(formula, inputBytes) {
	resolved := f.resolveAst(formula, {}, ["in.tsv"])
	return f._internal.evaluate(resolved, {
		size:      func(files) { return inputBytes },
		lineCount: func(files) { return 0 }
	})
}

// inputBytes stays an integer throughout: the evaluator asserts integer operands, and
// a float would silently change the arithmetic it is being checked against.
_ram := func(inputBytes, memFloor) {
	return _evalAt(sizing.ramFormula(memFloor), inputBytes)
}

_cpu := func(inputBytes) {
	return _evalAt(sizing.cpuFormula(), inputBytes)
}

GiB := units.GiB

// ---- ram: the documented curve --------------------------------------------
// ram = max(2 GiB + 10 * size, 2 GiB)

TestRamFloorBinds := func() {
	// At zero input the intercept alone is the floor.
	test.isEqual(2 * GiB, _ram(0, undefined))
}

TestRamSlopeGoverns := func() {
	test.isEqual(12 * GiB, _ram(1 * GiB, undefined))   //  2 + 10*1
	test.isEqual(42 * GiB, _ram(4 * GiB, undefined))   //  2 + 10*4
	test.isEqual(82 * GiB, _ram(8 * GiB, undefined))   //  2 + 10*8
}

TestRamHasNoCeiling := func() {
	// 25.4 GiB is where the previous 256 GiB ceiling bound at slope 10.
	test.isEqual(502 * GiB, _ram(50 * GiB, undefined))
	test.isEqual(5002 * GiB, _ram(500 * GiB, undefined))
}

// ---- ram: memFloor --------------------------------------------------------

TestMemFloorRaisesTheLowerBound := func() {
	// Below the crossover the floor wins, so the grant matches the old flat pin.
	test.isEqual(12 * GiB, _ram(0, 12 * GiB))
	test.isEqual(12 * GiB, _ram(1 * GiB, 12 * GiB))
}

TestMemFloorDoesNotCapGrowth := func() {
	// Above (12 - 2) / 10 = 1 GiB the formula governs again.
	test.isEqual(42 * GiB, _ram(4 * GiB, 12 * GiB))
	test.isEqual(202 * GiB, _ram(20 * GiB, 12 * GiB))
}

TestMemFloorAboveOldCeilingIsAccepted := func() {
	test.isEqual(300 * GiB, _ram(0, 300 * GiB))
	test.isEqual(5002 * GiB, _ram(500 * GiB, 300 * GiB))
}

// ---- cpu ------------------------------------------------------------------
// cpu = between(2 + size / 16 GiB, 2, 8)

TestCpuCurve := func() {
	test.isEqual(sizing.CPU_MIN, _cpu(0))
	test.isEqual(2, _cpu(15 * GiB))                 // 2 + floor(15/16)
	test.isEqual(3, _cpu(16 * GiB))                 // 2 + 1
	test.isEqual(sizing.CPU_MAX, _cpu(1000 * GiB))  // clamped
}

// ---- polars threads -------------------------------------------------------
// POLARS_MAX_THREADS = between(system.cpu, 2, 8), evaluated by the backend.

TestPolarsThreadsClampedToCpuBounds := func() {
	test.isEqual("{min(8,max(2,system.cpu))}", sizing.POLARS_MAX_THREADS_EXPR)
}

// ---- an explicit mem() is not this module's business ----------------------

TestConstantsMatchTheDocumentedFormula := func() {
	test.isEqual(2, sizing.RAM_INTERCEPT_GIB)
	test.isEqual(10, sizing.RAM_SLOPE)
	test.isEqual(2, sizing.RAM_FLOOR_GIB)
	test.isEqual(2, sizing.CPU_MIN)
	test.isEqual(8, sizing.CPU_MAX)
}

// ---- scratch: the documented curve and its threshold ----------------------
// scratch = size * (16 * (read_frames + 1) + 2 * write_frames), 0 below 16 GiB

_scratch := func(inputBytes, readFrames, writeFrames) {
	formula := sizing.scratchFormula(readFrames, writeFrames)
	if is_int(formula) {
		return formula
	}
	resolved := f.resolveAst(formula, {}, ["in.parquet"])
	return f.evaluateScratch(resolved, {
		size:      func(files) { return inputBytes },
		lineCount: func(files) { return 0 }
	})
}

TestScratchWithoutFramesIsZero := func() {
	test.isEqual(0, _scratch(100 * GiB, 0, 0))
}

TestScratchSlopeCountsFrames := func() {
	test.isEqual(34 * GiB, _scratch(1 * GiB, 1, 1))    // 16 * 2 + 2
	test.isEqual(124 * GiB, _scratch(1 * GiB, 6, 6))   // 16 * 7 + 12
	test.isEqual(36 * GiB, _scratch(2 * GiB, 0, 1))    // 2 * (16 + 2)
}

TestScratchBelowThresholdIsZero := func() {
	// One join and one frame need 34 x input: 450 MiB estimates 14.9 GiB, 512 MiB 17 GiB.
	test.isEqual(0, _scratch(450 * units.MiB, 1, 1))
	test.isEqual(17 * GiB, _scratch(512 * units.MiB, 1, 1))
	test.isEqual(0, _scratch(0, 1, 1))
}
