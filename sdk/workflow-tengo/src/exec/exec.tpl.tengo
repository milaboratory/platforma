//tengo:hash_override 6FB763E3-AB0C-4676-8F74-C7E23069DCCF

/**
 * Creates and fill a workdir, runs a command on it
 * and saves a chosen resulted files from this dir.
 */

self := import(":tpl.light")

validation := import(":validation")

smart := import(":smart")
render := import(":render")
pkg := import(":exec.package")
desc := import(":exec.descriptor")
monetization := import(":exec.monetization_internal")
assets := import(":assets")
execConstants := import(":exec.constants")
prepare := import(":exec.prepare")
stream := import(":exec.stream")
tplutil := import(":tpl.util")

execImplTpl := assets.importTemplate(":exec.exec-impl")

self.defineOutputs(
	"files",
	"filesContent",
	"fileSets",
	"fileSetsContent",
	"progress",
	"fileStreams",
	"wdProcessors",
	"attempts"
)

inputSchema := {
	"softwareInfo,?": validation.resource(),
	filesToAdd: { any: validation.resource() },
	filesToWrite: { any: validation.resource() },
	"assets,?": { any: validation.resource() },
	"wdProcessors,?": {
		any: {
			tpl: validation.resource(),
			"tplArgs,?": "any"
		}
	},

	"dirsToCreate,?": ["string"],
	runOptions: {
		"name,?": "string",
		"software,?": pkg.softwareInfoScheme,
		"cmd,?": "string",
		args: ["string"],
		envs: { any: "string" },
		"argsTyped,?": [{type: "string", value: "string"}],
		"envsTyped,?": {"any": {type: "string", value: "string"}},
		secrets: { any: "string" },
		queue: "string",
		stdout: "string",
		stderr: "string",
		nErrorLines: "number",
		"monetization,?": monetization.schema,
		"dockerImageTag,?": "string",
		"dockerEntrypoint,?": ["string"]
	},
	"filesToSave,?": ["string"],
	"filesContentToSave,?": ["string"],
	"fileSetsToSave,?": { any: "string" },
	"fileSetsContentToSave,?": { any: "string" },
	"filesToStream,?": ["string"],
	"writableFiles,?": ["string"],
	"assetDescriptors,?": { any: { asset: desc.assetScheme } },
	"assetRules,?": { any: { any: ["string"] } },
	"assetCache,?": { any: "number" },

	// Meta inputs
	"quota": {
		queue: "string",
		"cpu,?": "number",
		"ram,?": ["or", "number", "string"],
		"gpuMemory,?": "string",
		"scratchFreeSpace,?": ["or", "number", "string"]
	}
}

// Optional resource-formula inputs (attached by the exec builder when a RAM /
// CPU / VRAM formula is used), evaluated by the body below (exec.prepare). The formula ASTs
// __memFormula__/__cpuFormula__/__gpuFormula__ are JSON value resources on the
// META rail — CID-transparent, yet readable as final in this pure body (same
// mechanism as `quota`). __metric_lineCount__ is a COMPUTED map resource
// (fileName -> content resource with that file's line count) on the REGULAR
// rail, so this pure template's readiness gate deep-waits its per-file entries to
// final before the body reads them. Keys come from execConstants so the
// attach/read/validate sites share one source of truth. See analysis doc §4.
inputSchema[execConstants.META_INPUT_MEM_FORMULA + ",?"] = "any"
inputSchema[execConstants.META_INPUT_CPU_FORMULA + ",?"] = "any"
inputSchema[execConstants.META_INPUT_GPU_FORMULA + ",?"] = "any"
inputSchema[execConstants.META_INPUT_SCRATCH_FORMULA + ",?"] = "any"
inputSchema[execConstants.REGULAR_INPUT_LINE_COUNT + ",?"] = "any"
inputSchema[execConstants.META_INPUT_FORCE_RUN_COMMAND_V2 + ",?"] = "any"

// Exec fallbacks (spec §12.3), present only when the builder used .fallbacks(), so an exec
// without them renders the same inputs, and has the same CID, as before: plan key -> { inputs,
// meta } of each handler's exec.exec render, and the policy JSON that names them.
inputSchema["fallbackPlans,?"] = "any"
inputSchema["fallbackPolicy,?"] = "any"
self.validateInputs(inputSchema)

self.body(func(inputs) {
	impl := prepare.implInputs(inputs, self.rawInputs())

	// With fallbacks, every streamed file is a StreamCollection/1 that follows the running attempt
	// (spec §13); the attempts write its fields. Without them the streams are the attempt's own
	// StreamManager/2s, as before.
	collections := undefined
	if !is_undefined(inputs.fallbackPlans) && !is_undefined(inputs.filesToStream) && len(inputs.filesToStream) > 0 {
		// TODO: the CID of this render once Tengo can read it; the inputs map is deduplicated
		// exactly as the render is, so it stands in for the identity
		identity := self.renderer().get(tplutil.INPUTS_MAP_FIELD)
		c := {}
		for name in inputs.filesToStream {
			c[name] = stream.createCollection(identity, name)
		}
		collections = smart.createMapResource(c)
		impl.pure.streamCollections = collections
	}

	// exec-impl cannot import itself through the router (no template import cycles), so it gets
	// its own template as an input and passes it on
	impl.pure.execImplTpl = execImplTpl

	execImpl := render.createEphemeral(execImplTpl, impl.pure, { metaInputs: impl.meta })

	return {
		files: execImpl.output("files"),
		filesContent: execImpl.output("filesContent"),
		fileSets: execImpl.output("fileSets"),
		fileSetsContent: execImpl.output("fileSetsContent"),
		fileStreams: is_undefined(collections) ? execImpl.output("fileStreams") : collections,
		wdProcessors: execImpl.output("wdProcessors"),
		progress: execImpl.output("progress"),
		attempts: execImpl.output("attempts")
	}
})
