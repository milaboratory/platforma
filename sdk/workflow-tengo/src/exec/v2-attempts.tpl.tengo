/**
 * The `attempts` output of an exec whose save has no outcome to decide on (exec fallbacks, spec
 * §10.2, §12.4): on RunCommand v2 the one entry a successful exec has, on RunCommand v3 without
 * WorkdirSave v3 the attempt history, once the working directory is saved. A failed command or
 * save errors the save's working directory, and the error reaches `attempts` too, as it reaches
 * the other outputs.
 *
 * inputs.workdir: the save's post-save working directory
 * inputs.history: map[], optional - the history; the one success entry of attempt 0 by default
 * inputs.plan: string, optional - the plan of that entry, when a fallback plan ran in place of the
 *   root on a backend without RunCommand v3; the root by default
 */

self := import(":tpl.light")
fallback := import(":exec.fallback")

self.awaitState("workdir", "ResourceReady")

self.body(func(inputs) {
	if !is_undefined(inputs.history) {
		return { attempts: inputs.history }
	}
	plan := is_undefined(inputs.plan) ? fallback.ROOT_PLAN : inputs.plan
	return { attempts: [{ attempt: 0, plan: plan, result: "success" }] }
})
