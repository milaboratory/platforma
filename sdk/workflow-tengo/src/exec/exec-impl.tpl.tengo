/**
 * Creates and fill a workdir, runs a command on it
 * and saves a chosen resulted files from this dir.
 */

self := import(":tpl.light")

validation := import(":validation")

smart := import(":smart")
render := import(":render")
assets := import(":assets")
workdir := import(":workdir")
stream := import(":exec.stream")
pkg := import(":exec.package")
blobs := import(":file.internal")
desc := import(":exec.descriptor")
monetization := import(":exec.monetization_internal")
maps := import(":maps")
runcmd := import(":exec.runcmd")
feats := import(":feats")
R := import(":exec.R")
limits := import(":exec.limits")
execConstants := import(":exec.constants")

delayedCompAlloc := import(":exec.delayed-compute-allocation")
tplutil := import(":tpl.util")

routerTpl := assets.importTemplate(":exec.outcome-router")
v2AttemptsTpl := assets.importTemplate(":exec.v2-attempts")

self.defineOutputs(
	"files",
	"filesContent",
	"fileSets",
	"fileSetsContent",
	"progress",
	"fileStreams",
	"wdProcessors",
	"attempts",
	// RunCommand v3 only: the attempt's final streamed files (the outcome router's streamOwn)
	"streamOwn"
)

EXTENDED_PLAN_OPTIONS_SCHEMA := maps.merge(runcmd.RUN_CMD_PLAN_OPTIONS_SCHEMA, {
	"__options__,closed": true,
	"runEnvType,?": "string"
})

// awaits the whole input map to become ready
self.awaitState("ResourceReady")

inputSchema := {
	filesToAdd: { any: validation.resource() },
	filesToWrite: { any: validation.resource() },
	"assets,?": { any: validation.resource() },
	"wdProcessors,?": {
		any: {
			tpl: validation.resource(),
			"tplArgs,?": "any"
		}
	},
	mainPlan: runcmd.RUN_CMD_PLAN_STATE_SCHEMA,
	"mnzPlan,?": runcmd.RUN_CMD_PLAN_STATE_SCHEMA,

	settings: {
		"dirsToCreate,?": ["string"],
		runOptions: {
			"name,?": "string",
			"software,?": pkg.softwareInfoScheme,
			"cmd,?": "string",
			args: ["string"],
			envs: { any: "string" },
			"argsTyped,?": [{type: "string", value: "string"}],
			"envsTyped,?": {"any": {type: "string", value: "string"}},
			secrets: { any: "string" },
			queue: "string",
			stdout: "string",
			stderr: "string",
			nErrorLines: "number",
			"monetization,?": monetization.schema
		},
		"filesToSave,?": ["string"],
		"filesContentToSave,?": ["string"],
		"fileSetsToSave,?": { any: "string" },
		"fileSetsContentToSave,?": { any: "string" },
		"filesToStream,?": ["string"],
		"writableFiles,?": ["string"],

		"assetDescriptors,?": { any: { asset: desc.assetScheme } },
		"assetRules,?": { any: { any: ["string"] } },
		"assetCache,?": { any: "number" }
	},

	// Exec fallbacks, RunCommand v3 only (spec §10.2): the plans and the policy of this attempt's
	// plan, the attempt context (absent on attempt 0), the stream collections of the exec, and
	// this template itself, for the router to render the next attempt with.
	"fallbackPlans,?": "any",
	"fallbackPolicy,?": "any",
	"attemptCtx,?": {
		attempt: "number",
		jobId: "string",
		plan: "string",
		restart: "number",
		history: ["any"]
	},
	"streamCollections,?": "any",
	"execImplTpl,?": "any",

	// Meta inputs
	"quota": {
		queue: "string",
		"cpu,?": "number",
		"ram,?": ["or", "number", "string"],
		"gpuMemory,?": "string",
		"scratchFreeSpace,?": ["or", "number", "string"]
	}
}

inputSchema[execConstants.META_INPUT_FORCE_RUN_COMMAND_V2 + ",?"] = "any"
inputSchema[execConstants.META_INPUT_FORCE_WORKDIR_SAVE_V1 + ",?"] = "any"

self.validateInputs(inputSchema)

/**
 * The RunCommand v2 path, as before exec fallbacks: a software failure is an error of the
 * command, propagated through the save chain to the outputs. `attempts` is the one entry a
 * successful exec has, resolved once the save is done, so getAttempts() resolves on such a backend
 * as the other outputs do, and errors as they do.
 */
_runV2 := func(inputs, mainRunBuilder, wdBefore) {
	settings := inputs.settings
	run := mainRunBuilder.build()

	// get the workdir containing all the files, including produced by the run command
	wdAfter := run.workdir

	//
	// Run workdir processors
	//

	wdProcessorsResults := {}
	if !is_undefined(inputs.wdProcessors) {
		for name, p in inputs.wdProcessors {
			tpl := p.tpl
			tplInputs := {
				workdir: wdAfter,
				args: p.tplArgs
			}

			// render template & get results
			r := render.createEphemeral(tpl, tplInputs)

			wdProcessorsResults[name] = r.output("result")
			wdAfter = r.output("workdir")
		}
	}

	//
	// Save data from the workdir
	//

	// saver resource
	wdSaver := workdir.save(wdAfter)
	// save files
	if !is_undefined(settings.filesToSave) {
		for fName in settings.filesToSave {
			wdSaver.saveFile(fName)
		}
	}
	// save files content
	if !is_undefined(settings.filesContentToSave) {
		for fName in settings.filesContentToSave {
			wdSaver.saveFileContent(fName)
		}
	}
	// save file sets
	if !is_undefined(settings.fileSetsToSave) {
		for name, regex in settings.fileSetsToSave {
			wdSaver.saveFileSet(name, regex)
		}
	}
	// save file sets content
	if !is_undefined(settings.fileSetsContentToSave) {
		for name, regex in settings.fileSetsContentToSave {
			wdSaver.saveFileSetContent(name, regex)
		}
	}

	// resulting wd
	wdResult := wdSaver.build()

	// create streams for all requested file streams.
	streams := smart.mapBuilder()
	if !is_undefined(settings.filesToStream) {
		for fName in settings.filesToStream {
			streams.add(fName, stream.create(wdBefore, wdResult, fName))
		}
	}

	return {
		files: wdResult.files,
		filesContent: wdResult.filesContent,
		fileSets: wdResult.fileSets,
		fileSetsContent: wdResult.fileSetsContent,
		fileStreams: streams.build(),
		wdProcessors: wdProcessorsResults,
		progress: wdResult.progress,
		attempts: render.createEphemeral(v2AttemptsTpl, { workdir: wdResult.workdir }).output("attempts")
	}
}

self.body(func(inputs) {
	settings := inputs.settings
	// original run options passed by the user
	runOptions := settings.runOptions

	//
	// Create and fill the workdir with files that were passed from inputs.
	//

	wdBuilder := workdir.builder()

	// The quota is already fully computed by the pure exec.tpl (resource formulas
	// are evaluated there). This ephemeral impl just consumes it.
	quota := inputs.quota

	wdBuilder.inQueue(quota.queue).cpu(quota.cpu).mem(quota.ram)

	// Names whose fill-rule should land 0o600 (writable) instead of the
	// 0o400 default. Absence = read-only / hardlink fast path.
	writableSet := {}
	if !is_undefined(settings.writableFiles) {
		for _, name in settings.writableFiles {
			writableSet[name] = true
		}
	}

	// add files
	maps.forEach(inputs.filesToAdd, func(fName, fRef) {
		wdBuilder.addFile(fName, fRef, { writable: writableSet[fName] == true })
	})
	wdBuilder.mkDirs(settings.dirsToCreate)

	// add assets
	archives := {}
	for k, descriptor in settings.assetDescriptors {
		assetBlob := blobs.createBlobImportExternal({
			dataURL: descriptor.asset.url
		}).file

		archives[k] = assetBlob
		if is_int(settings.assetCache[k]) {
			assetBlob.setCache(settings.assetCache[k])
		} else {
			assetBlob.setCacheDays(1)
		}
	}
	for k, archiveRules in settings.assetRules {
		for dir, filesToExtract in archiveRules {
			wdBuilder.addFromZip(archives[k], dir, filesToExtract)
		}
	}

	// pass values as fields for saving the topology in pl-core
	// and avoiding deduplication issues:
	maps.forEach(self.rawInputs().filesToWrite.getValue().inputs(), func(fName, fRef) {
		wdBuilder.writeFile(fName, fRef, { writable: writableSet[fName] == true })
	})

	// working directory with input files added; before run
	wdBefore := wdBuilder.build()

	// Delay requesting compute quota until the workdir is ready.
	// This prevents a deadlock between storage and compute quotas.
	// A waiter ensures that a task requests compute quota only after
	// it has acquired the storage quota required for workdir creation,
	// which is a prerequisite for the computation itself.

	computeRequest := {
		queue: runOptions.queue,
		cpu: quota.cpu,
		ram: quota.ram
	}
	if !is_undefined(quota.gpuMemory) {
		computeRequest.gpuMemory = quota.gpuMemory
	}
	if !is_undefined(quota.scratchFreeSpace) {
		computeRequest.scratchFreeSpace = quota.scratchFreeSpace
	}
	computeAllocationRef := delayedCompAlloc.create(wdBefore, computeRequest)

	runEnvType := inputs.mainPlan.options.runEnvType

	mainPlanPreBuilder := runcmd.createRunCommandPlan(inputs.mainPlan)

	mnz := runOptions.monetization
	if !is_undefined(mnz) {
		result := monetization.run(mnz, wdBefore, inputs.mnzPlan, runOptions.queue, computeAllocationRef)
		wdBefore = result.wdAfter
		mainPlanPreBuilder.refVar(result.jwtEnvName, result.jwtEnvName, result.jwtEnvValue)
		mainPlanPreBuilder.envExpression(result.jwtEnvName, "{" + result.jwtEnvName + "}")
	}

	// Working directory after run environment preparation steps.
	// The same as wdBefore, but might get additional files if they are required for run environment,
	// like .Rprofile for R with activated renv.
	if (runEnvType == "R") {
		wdBefore = R.activateRenvInWD(wdBefore, runOptions.queue, computeAllocationRef, inputs.mainPlan)
		wdBefore = R.installDepsIntoRenv(wdBefore, runOptions.queue, computeAllocationRef, inputs.mainPlan)
	}

	mainRunBuilder := runcmd.builder(wdBefore, mainPlanPreBuilder.state()).
		inQueue(runOptions.queue).
		allocation(computeAllocationRef)

	if !is_undefined(runOptions.name) && runOptions.name != "" {
		mainRunBuilder.name(runOptions.name)
	}

	// Passing arguments and environment variables from run options passed by the user

	shouldUseNewTyped := !is_undefined(runOptions.argsTyped) || !is_undefined(runOptions.envsTyped)

	args := shouldUseNewTyped ? runOptions.argsTyped : runOptions.args
	for _, arg in args {
		if shouldUseNewTyped {
			mainRunBuilder.argTyped(arg.type, arg.value)
		} else {
			mainRunBuilder.arg(arg)
		}
	}

	envs := shouldUseNewTyped ? runOptions.envsTyped : runOptions.envs
	for name, v in envs {
		if shouldUseNewTyped {
			mainRunBuilder.envTyped(name, v.type, v.value)
		} else {
			mainRunBuilder.env(name, v)
		}
	}

	//
	// Build runcmd resource
	//

	// Load secrets
	for envName, secretName in runOptions.secrets {
		if feats.secretEnvSupport {
			mainRunBuilder.envSecret(envName, secretName)
		} else {
			mainRunBuilder.envExpression(envName, "{secrets." + secretName + "}")
		}
	}

	// other options
	mainRunBuilder.stdout(runOptions.stdout)
	mainRunBuilder.stderr(runOptions.stderr)
	mainRunBuilder.nErrorLines(runOptions.nErrorLines)
	queue := runOptions.queue
	useV3 := is_undefined(inputs[execConstants.META_INPUT_FORCE_RUN_COMMAND_V2]) &&
		!is_undefined(limits.getRunCommandV3Type(queue))
	if !useV3 {
		return _runV2(inputs, mainRunBuilder, wdBefore)
	}

	//
	// RunCommand v3 (exec fallbacks): a software failure is an outcome, read by the outcome
	// router, which saves the results, renders a fallback plan, or raises the error.
	//

	ctx := inputs.attemptCtx // undefined on attempt 0
	attempt := is_undefined(ctx) ? 0 : ctx.attempt
	// attempt 0 leaves jobId unset: the backend takes the RunCommand's own id
	mainRunBuilder.v3(attempt, is_undefined(ctx) ? undefined : ctx.jobId)
	run := mainRunBuilder.build()

	raw := self.rawInputs()

	// this attempt's own exec-impl inputs, for a restart of the same plan (spec §14.3): the inputs
	// map of this render itself, pure and meta inputs; a restart replaces attemptCtx
	implInputs := self.renderer().get(tplutil.INPUTS_MAP_FIELD)

	routerInputs := {
		outcome: run.outcome,
		workdir: run.workdir,
		settings: raw.settings.getValue(),
		implInputs: implInputs
	}
	for name in ["wdProcessors", "fallbackPlans", "fallbackPolicy", "attemptCtx", "streamCollections", "execImplTpl"] {
		if !is_undefined(raw[name]) {
			routerInputs[name] = raw[name].getValue()
		}
	}
	if !is_undefined(inputs[execConstants.META_INPUT_FORCE_WORKDIR_SAVE_V1]) {
		routerInputs.forceWorkdirSaveV1 = true
	}
	router := render.createEphemeral(routerTpl, routerInputs)

	// one manager per streamed file, live on this attempt's workdir, ending on this attempt's own
	// file, which the router saves on success and on a failure alike
	managers := smart.mapBuilder()
	streams := {}
	if !is_undefined(settings.filesToStream) {
		for fName in settings.filesToStream {
			streams[fName] = stream.createWithLive(wdBefore, fName, router.output("streamOwn").getFutureInputField(fName))
			managers.addRef(fName, streams[fName].manager)
		}
	}
	if !is_undefined(inputs.streamCollections) {
		// attempt 0 of a job, not a restart of it: no attempt context
		stream.attemptStarted(inputs.streamCollections, attempt, streams, is_undefined(ctx))
	}

	return {
		files: router.output("files"),
		filesContent: router.output("filesContent"),
		fileSets: router.output("fileSets"),
		fileSetsContent: router.output("fileSetsContent"),
		fileStreams: managers.build(),
		wdProcessors: router.output("wdProcessors"),
		progress: router.output("progress"),
		attempts: router.output("attempts"),
		// this attempt's final streamed files; a restart hands them to the lost attempt's managers
		streamOwn: router.output("streamOwn")
	}
})
