/**
 * The final content of a successful attempt's streams (see :exec.wave2), and the switch of the
 * stream collections to it: on "saved", the attempt's saved streamed files, as before fallbacks, and
 * a stand-in for a streamed file not saved or never written; on
 * "restarted", the restart's, which writes the collections itself.
 *
 * inputs.decision: the wd-retrier's decision
 * inputs.settings, inputs.attemptCtx, inputs.streamCollections (optional): of the attempt
 * inputs.workdir: the attempt's post-run working directory
 * meta inputs files: the save chain's saved files; restarted: the restart's streamOwn
 * outputs.value: file name -> the file's blob
 */

self := import(":tpl.light")
smart := import(":smart")
file := import(":file")
slices := import(":slices")
stream := import(":exec.stream")

self.awaitState("decision", "ResourceReady")

self.body(func(inputs) {
	meta := self.rawMetaInputs()
	if inputs.decision != "saved" {
		return { value: meta.restarted }
	}

	settings := inputs.settings
	ctx := inputs.attemptCtx
	wdOut := self.rawInputs().workdir.getValue()
	listed := wdOut.getDataAsJson().files
	savedFiles := is_undefined(settings.filesToSave) ? [] : settings.filesToSave

	// every streamed name has an entry: the saved file when the attempt wrote it, a stand-in
	// otherwise (stream.notWritten) (a missing key, or a save of a missing file, would be an error that spreads
	// to the exec's other outputs)
	streamFiles := {}
	streamOwn := smart.ephemeralMapBuilder()
	if !is_undefined(settings.filesToStream) {
		for name in settings.filesToStream {
			if slices.hasElement(savedFiles, name) && slices.hasElement(listed, name) {
				streamFiles[name] = file.exportFile(meta.files.getFutureInputField(name))
				streamOwn.addRef(name, streamFiles[name])
			} else {
				streamOwn.addRef(name, stream.notWritten(name))
			}
		}
	}
	collections := is_undefined(inputs.streamCollections) ? {} : inputs.streamCollections
	stream.attemptEnded(collections, ctx.attempt, ctx.history[len(ctx.history) - 1], streamFiles)

	return { value: streamOwn.build() }
})
