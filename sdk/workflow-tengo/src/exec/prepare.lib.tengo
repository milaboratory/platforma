/**
 * Turns the inputs of an exec.exec render (a plan) into the inputs of its exec-impl render:
 * software load, resource-formula evaluation into the quota, settings. The pure exec.exec template
 * calls it for attempt 0; the outcome router calls it for a fallback plan, so both run the same
 * code (exec fallbacks).
 */

ll := import(":ll")
smart := import(":smart")
maps := import(":maps")
text := import("text")
assets := import(":assets")
runcmd := import(":exec.runcmd")
loadSoftware := import(":exec.load-software")
execConstants := import(":exec.constants")
execFormula := import(":exec.formula")

mnzSw := assets.importSoftware("@platforma-open/milaboratories.software-small-binaries:mnz-client")

/**
 * @param inputs: map - the plan's inputs, resolved (pure and meta merged, as tpl.inputs() has them)
 * @param raw: map - the plan's pure input fields by name, as tpl.rawInputs() has them
 * @return { pure: map, meta: map } - the inputs and the meta inputs of the exec-impl render
 */
implInputs := func(inputs, raw) {
	plan := undefined
	if (is_undefined(inputs.runOptions.software)) {
		// Simple local command run, no software packages involved (backward compatibility)
		plan = runcmd.createRunCommandPlan().cmd(inputs.runOptions.cmd).state()
	} else {
		software := inputs.runOptions.software
		plan = loadSoftware.loadSoftware(software)
	}

	// Resource-formula evaluation happens HERE. By the time this runs, the meta formula ASTs and
	// the regular line-count map (see the input-schema note in exec.tpl) are resolved and
	// deep-waited, so it reads and evaluates them directly.
	quota := maps.clone(inputs.quota)

	memFormula := inputs[execConstants.META_INPUT_MEM_FORMULA]
	cpuFormula := inputs[execConstants.META_INPUT_CPU_FORMULA]
	gpuFormula := inputs[execConstants.META_INPUT_GPU_FORMULA]
	scratchFormula := inputs[execConstants.META_INPUT_SCRATCH_FORMULA]
	if !is_undefined(memFormula) || !is_undefined(cpuFormula) ||
		!is_undefined(gpuFormula) || !is_undefined(scratchFormula) {
		fileRefs := inputs.filesToAdd
		lineCountMap := inputs[execConstants.REGULAR_INPUT_LINE_COUNT]
		resolver := {
			// size: sum of blob sizes (bytes) of the referenced input files.
			size: func(files) {
				total := 0
				for fn in files {
					ll.assert(!is_undefined(fileRefs[fn]), "exec.tpl: resource formula references file %q, which is not among the exec's input files", fn)
					total += ll.getBlobSize(fileRefs[fn].id)
				}
				return total
			},
			// lineCount: sum of the deep-waited per-file line counts. Each map entry
			// is a content resource holding a base-10 int (no trailing newline).
			lineCount: func(files) {
				ll.assert(!is_undefined(lineCountMap), "exec.tpl: a lineCount formula was evaluated but the __metric_lineCount__ metric map is missing")
				total := 0
				for fn in files {
					// As a regular input, each map entry is deep-waited to a ready
					// content-resource handle; read its bytes directly.
					ll.assert(!is_undefined(lineCountMap[fn]), "exec.tpl: lineCount metric map has no entry for %q (the line-counter pre-exec did not produce a count for this file)", fn)
					data := lineCountMap[fn].getData()
					n := int(text.trim(string(data), "\n \r\t"))
					ll.assert(!is_undefined(n), "exec.tpl: lineCount for %q is not a base-10 integer: %q", fn, string(data))
					total += n
				}
				return total
			}
		}
		if !is_undefined(memFormula) {
			quota.ram = string(execFormula.evaluateResource(memFormula, resolver, "ram")) + "b"
		}
		if !is_undefined(cpuFormula) {
			quota.cpu = execFormula.evaluateResource(cpuFormula, resolver, "cpu")
		}
		if !is_undefined(gpuFormula) {
			// VRAM bytes -> SizeUnit string (the quota's gpuMemory is a size string,
			// parsed identically to ram). A positive integer is asserted, same as ram.
			quota.gpuMemory = string(execFormula.evaluateResource(gpuFormula, resolver, "gpuMemory")) + "b"
		}
		if !is_undefined(scratchFormula) {
			quota.scratchFreeSpace = string(execFormula.evaluateScratch(scratchFormula, resolver)) + "b"
		}
	}

	metaImplInputs := { quota: smart.createJsonResource(quota) }
	pureImplInputs := { mainPlan: plan }

	if !is_undefined(inputs.runOptions.monetization) {
		pureImplInputs.mnzPlan = loadSoftware.loadSoftware(mnzSw)
	}

	//
	// Code below uses raw inputs, to pass exactly same resource as we received in inputs.
	// This will not be needed after we finish MILAB-685: https://github.com/milaboratory/platforma/pull/8
	//

	for name in ["filesToAdd", "filesToWrite", "assets", "wdProcessors", "fallbackPlans"] {
		if !is_undefined(raw[name]) {
			pureImplInputs[name] = raw[name]
		}
	}
	if !is_undefined(inputs.fallbackPolicy) {
		pureImplInputs.fallbackPolicy = inputs.fallbackPolicy
	}
	if !is_undefined(inputs[execConstants.META_INPUT_FORCE_RUN_COMMAND_V2]) {
		metaImplInputs[execConstants.META_INPUT_FORCE_RUN_COMMAND_V2] = smart.createJsonResource(true)
	}

	pureImplInputs.settings = smart.createJsonResource(maps.clone({
		dirsToCreate: inputs.dirsToCreate,
		runOptions: inputs.runOptions,
		filesToSave: inputs.filesToSave,
		filesContentToSave: inputs.filesContentToSave,
		fileSetsToSave: inputs.fileSetsToSave,
		fileSetsContentToSave: inputs.fileSetsContentToSave,
		filesToStream: inputs.filesToStream,
		writableFiles: inputs.writableFiles,
		assetDescriptors: inputs.assetDescriptors,
		assetRules: inputs.assetRules,
		assetCache: inputs.assetCache
	}, { removeUndefs: true }))

	return { pure: pureImplInputs, meta: metaImplInputs }
}

export ll.toStrict({
	implInputs: implInputs
})
