/**
 * Wave 2 of a successful RunCommand v3 attempt (exec fallbacks, spec §14.2): the save chain, then
 * exec.wd-retrier on its outcomes. Rendered by the outcome router; a library so tests can render
 * it on a working directory of their own (decision D5).
 */

ll := import(":ll")
render := import(":render")
smart := import(":smart")
assets := import(":assets")
saveChain := import(":exec.save-chain")

wdRetrierTpl := assets.importTemplate(":exec.wd-retrier")
wdForwardTpl := assets.importTemplate(":exec.wd-forward")
wdStreamOwnTpl := assets.importTemplate(":exec.wd-stream-own")

/**
 * @param p: map -
 *   workdir: reference - the post-run working directory
 *   settings: map - the exec's settings, decoded
 *   settingsRef: reference - the same settings resource, passed on
 *   wdProcessors: map | undefined - name -> { tpl, tplArgs }
 *   v3: bool - save with WorkdirSave v3; the wd-retrier then restarts on a lost directory
 *   attemptCtx: map - the attempt context, history including this attempt's success entry,
 *                     attemptLimit and restartLimit
 *   implInputs: reference - this attempt's exec-impl inputs, for a restart
 *   streamCollections: reference | undefined
 *   execImplTpl: reference | undefined
 * @return { output(name) } - files, filesContent, fileSets, fileSetsContent, wdProcessors, progress,
 *         attempts, streamOwn
 */
run := func(p) {
	settings := p.settings
	saved := saveChain.run(p.workdir, settings, p.wdProcessors, { v3: p.v3 })

	// The wd-retrier decides on the outcome maps, whose entries are values (WorkdirSave v3, D2), and
	// never sees the save chain's outputs: a file the software never wrote errors its own blob, and
	// a template with an error anywhere among its inputs, meta inputs included, fails as a whole.
	// Each output then goes out through a forwarder of its own, choosing between the saved output
	// and the restart's, so an error reaches the output it is in and no other, as with v1.
	inputs := {
		settings: p.settingsRef,
		attemptCtx: p.attemptCtx,
		implInputs: p.implInputs
	}
	if p.v3 {
		inputs.saveOutcome = saved.outcome
		if is_undefined(p.wdProcessors) || len(p.wdProcessors) == 0 {
			// the main save reads the post-run directory itself
			inputs.awaitOutcome = "saveOutcome"
		} else {
			// the processors read it first, after the probe at the head of the chain: decide on
			// the probe, then on the main save. On a lost directory the probe hands nothing on,
			// so the processors and the main save never run.
			inputs.probeOutcome = saved.probeOutcome
			inputs.awaitOutcome = "probeOutcome"
		}
	}
	if !is_undefined(p.streamCollections) {
		inputs.streamCollections = p.streamCollections
	}
	if !is_undefined(p.execImplTpl) {
		inputs.execImplTpl = p.execImplTpl
	}
	retrier := render.createEphemeral(wdRetrierTpl, inputs)
	decision := retrier.output("decision")

	forward := func(name, savedOutput) {
		return render.createEphemeral(wdForwardTpl, { decision: decision }, {
			metaInputs: { saved: savedOutput, restarted: retrier.output(name) }
		}).output("value")
	}

	streamInputs := {
		decision: decision,
		settings: p.settingsRef,
		attemptCtx: p.attemptCtx,
		workdir: p.workdir
	}
	if !is_undefined(p.streamCollections) {
		streamInputs.streamCollections = p.streamCollections
	}
	streamOwn := render.createEphemeral(wdStreamOwnTpl, streamInputs, {
		metaInputs: { files: saved.files, restarted: retrier.output("streamOwn") }
	}).output("value")

	outputs := {
		files: forward("files", saved.files),
		filesContent: forward("filesContent", saved.filesContent),
		fileSets: forward("fileSets", saved.fileSets),
		fileSetsContent: forward("fileSetsContent", saved.fileSetsContent),
		progress: forward("progress", saved.progress),
		wdProcessors: forward("wdProcessors", smart.createMapResource(saved.wdProcessors)),
		attempts: retrier.output("attempts"),
		streamOwn: streamOwn
	}
	return ll.toStrict({
		output: func(name) {
			return outputs[name]
		}
	})
}

export ll.toStrict({
	run: run
})
