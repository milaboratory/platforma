/**
 * The final content of a failed attempt's streams on a backend with WorkdirSave v3 (exec fallbacks,
 * spec §13.3, §14.3): decides on the outcomes of a save of the streamed files the attempt wrote,
 * then saves again only those that saved, on the first save's post-save working directory. A file
 * whose first save failed (the directory lost, a path that is not a regular file) ends on the
 * stand-in, as one never written does: its error stays in that save, which nothing reads, instead
 * of spreading from the router's outputs to the successful fallback's.
 *
 * inputs.outcome: the first save's outcome map
 * inputs.workdir: the first save's post-save working directory (unset when the directory is lost)
 * inputs.streamed: string[] - every streamed file name
 * outputs.streamOwn: file name -> the file's blob or the stand-in
 */

self := import(":tpl.light")
smart := import(":smart")
workdir := import(":workdir")
file := import(":file")
stream := import(":exec.stream")

self.awaitState("outcome", { wildcard: "*" }, "ResourceReady")

self.body(func(inputs) {
	saved := []
	for name, oc in inputs.outcome {
		v := is_map(oc) ? oc : oc.getDataAsJson()
		if name != "workdir" && v.result == "success" {
			saved = append(saved, name)
		}
	}

	files := undefined
	if len(saved) > 0 {
		again := workdir.save(self.rawInputs().workdir.getValue())
		for name in saved {
			again.saveFile(name)
		}
		files = again.build().files
	}

	own := smart.ephemeralMapBuilder()
	for name in inputs.streamed {
		found := false
		for s in saved {
			if s == name {
				found = true
			}
		}
		if found {
			own.addRef(name, file.exportFile(files.getFutureInputField(name)))
		} else {
			own.addRef(name, stream.notWritten(name))
		}
	}
	return { streamOwn: own.build() }
})
