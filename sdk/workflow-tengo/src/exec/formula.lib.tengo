// exec.formula — compute an exec's RAM/CPU/GPU from its input data instead of
// hardcoding it. A formula is a pure AST of plain maps (see "AST node shapes"
// below) that flows through two phases across the exec boundary:
//
// WORKFLOW RENDER TIME (in exec.builder().run(), before the exec exists):
//   1. The author composes a formula by chaining off a leaf constructor
//      (size/lineCount, gib/mib/..., const). The chain covers arithmetic
//      (.plus/.minus/.times/.dividedBy/.dividedByFloor), bounds
//      (.atLeast/.atMost/.between),
//      comparisons (.gt/.gte/.lt/.lte), logic (.and/.or/.not) and multi-branch
//      conditionals (f.when(cond, value).when(...).otherwise(default)).
//      Bare ints auto-wrap to const.
//   2. resolveAst() turns each { op: "metric", tag } into a concrete
//      { op: "metricSum", files } via the builder's tag -> files map, and rejects
//      lineCount on a non-text file. A metric with NO tag reads every file added
//      with addFile(). A metric with a tag reads only the files under that tag.
//      Either case collapses to its { default } when it resolves to no files.
//   3. referencedMetricFiles() lists the files needing a line-counter pre-exec
//      (lineCount); size reads the blob size inline, so it needs none.
//   The resolved AST rides to the exec as a META input — CID-transparent
//   (excluded from the exec CID) but readable as final in the pure body — while
//   the per-file line-count map, if any, rides as a REGULAR input: it holds
//   computed results that must be deep-waited to final, and being file-derived it
//   adds no CID differentiation. See analysis doc §4.
//
// RUN TIME (in the pure exec.tpl, once those inputs are ready):
//   4. evaluate()/evaluateResource() walk the resolved AST against a resolver
//      exec.tpl supplies — size via ll.getBlobSize, lineCount via the deep-waited
//      count map — reject a top-level comparison/logic op, assert a positive
//      integer, and override the quota.
//
// FALLBACK: a backend that can't evaluate formulas uses a static value instead
//   (applyFormulaFallback) — an explicit .staticFallback()/{ fallback } or a
//   static request set on the same dimension.
//
// FLUENT WRAPPERS: every constructor returns a chainable wrapper — a map
//   { __isFormula__: true, __ast__: <plain AST>, __fallback__: <static?> } that
//   also carries the chain methods. The plain AST is never contaminated: _wrap
//   (used by every method when composing children) unwraps a wrapper back to its
//   __ast__, so the tree stored and serialized is always plain maps. The builder
//   reads a value with astOf()/fallbackOf(); the evaluator entry points
//   auto-unwrap, so passing a wrapper straight to resolveAst/evaluate/... works.
//
// Pure by design: this file walks data and knows nothing of the backend. That
// resolver injection (step 4) keeps it import-free — and is why lineCount runs a
// binary from :exec instead of calling :pt, which would close an import cycle.

ll := import(":ll")
text := import("text")
slices := import(":slices")
maps := import(":maps")
sets := import(":sets")
units := import(":units")
fmt := import("fmt")
json := import("json")

// ---- AST node shapes -------------------------------------------------------
// const:      { op: "const", value: <int> }
// arithmetic: { op: "plus"|"minus"|"times"|"dividedBy"|"dividedByFloor", a: <node>, b: <node> }
//             ("dividedBy" is ceiling division; "dividedByFloor" is truncating)
// bounds:     { op: "atLeast"|"atMost", a, b } | { op: "between", value, lo, hi }
// compare:    { op: "gt"|"gte"|"lt"|"lte", a, b }
// logic:      { op: "and"|"or", a, b } | { op: "not", a }
// cond:       { op: "when", cond, then, else }
// metric:     { op: "metric", metric: "size"|"lineCount", "tag,?": <string>, "default,?": <int> }
//             (the builder later resolves "metric" -> "metricSum" with concrete files)
// custom:     { op: "metric", metric: "custom", collector: <name>, name: <metric>, declared: [<metric>...],
//               "tag,?": <string>, "files,?": [<file name>...], "default,?": <int> }
//             (resolved to { op: "custom", collector, name, declared, files }; see collector() below)
// The op strings mirror the fluent chain method names (.plus/.dividedBy/.between/
// .when/...), so a raw AST dump reads like the source formula.
// Note: when.cond and not.a may be const-wrapped if given a bare int; the
// evaluator treats any nonzero const as truthy.

// Ops _wrap accepts as valid expression nodes. "metricSum" is builder-internal
// (resolveAst rewrites "metric" -> "metricSum" with concrete files); the DSL
// never emits it directly.
_KNOWN_OPS := sets.fromSlice([
	"const", "metric", "metricSum", "custom",
	"plus", "minus", "times", "dividedBy", "dividedByFloor",
	"atLeast", "atMost", "between",
	"gt", "gte", "lt", "lte", "and", "or", "not",
	"when"
])

// Comparison/logic ops. Rejected at the top level of a resource formula
// (evaluateResource) — they are meaningful only inside a f.when(...) branch.
_BOOL_OPS := sets.fromSlice(["gt", "gte", "lt", "lte", "and", "or", "not"])

// _unwrap strips a fluent wrapper down to its plain AST; a plain AST or an int
// passes through untouched. Applied at every evaluator entry point and by _wrap,
// so the plain AST tree never contains a wrapper.
_unwrap := func(x) {
	return is_map(x) && !is_undefined(x.__isFormula__) ? x.__ast__ : x
}

_wrap := func(x) {
	x = _unwrap(x)
	if is_map(x) && !is_undefined(x.op) {
		ll.assert(sets.hasElement(_KNOWN_OPS, x.op), "exec.formula: not a valid expression node (unknown op %v)", x.op)
		return x
	}
	ll.assert(is_int(x), "exec.formula: expected an expression node or an integer, got %v", x)
	return { op: "const", value: x }
}

_bin := func(op, a, b) { return { op: op, a: _wrap(a), b: _wrap(b) } }

// metric(metricName, args) where args may be: (), ("tag"), ({default:n}), ("tag", {default:n})
_metric := func(metricName, args) {
	node := { op: "metric", metric: metricName }
	for arg in args {
		if is_string(arg) {
			ll.assert(is_undefined(node.tag), "exec.formula.%s: tag specified more than once", metricName)
			node.tag = arg
		} else if is_map(arg) && !is_undefined(arg.default) {
			ll.assert(is_undefined(node.default), "exec.formula.%s: default specified more than once", metricName)
			ll.assert(is_int(arg.default), "exec.formula.%s: default must be an integer", metricName)
			node.default = arg.default
		} else {
			ll.panic("exec.formula.%s: unexpected argument %v", metricName, arg)
		}
	}
	return node
}

// _staticValue extracts the constant behind a .staticFallback() argument: a bare
// number/string passes through; a pure-const wrapper (e.g. f.gib(64)) yields its
// integer byte value. Anything else is rejected — a fallback must be static.
_staticValue := func(v) {
	if is_map(v) && !is_undefined(v.__isFormula__) {
		a := v.__ast__
		ll.assert(is_map(a) && a.op == "const",
			"exec.formula.staticFallback: expected a constant (a number, a size string, or a pure unit like f.gib(64)), got a formula")
		return a.value
	}
	return v
}

evaluate := undefined
evaluate = func(node, resolver) {
	node = _unwrap(node)
	op := node.op
	if op == "const" { return node.value }
	if op == "metricSum" {
		fn := resolver[node.metric]
		ll.assert(!is_undefined(fn), "exec.formula.evaluate: no resolver for metric %q", node.metric)
		return fn(node.files)
	}
	if op == "custom" {
		ll.assert(!is_undefined(resolver.custom), "exec.formula.evaluate: no resolver for custom metrics (collector %q)", node.collector)
		return resolver.custom(node)
	}

	if op == "plus"  { return evaluate(node.a, resolver) + evaluate(node.b, resolver) }
	if op == "minus" { return evaluate(node.a, resolver) - evaluate(node.b, resolver) }
	if op == "times" { return evaluate(node.a, resolver) * evaluate(node.b, resolver) }
	if op == "dividedByFloor" {
		b := evaluate(node.b, resolver)
		ll.assert(b != 0, "exec.formula.evaluate: division by zero")
		// integer (truncating) division; toward zero, which for the non-negative
		// resource-metric domain (sizes, line counts) is floor.
		return evaluate(node.a, resolver) / b
	}
	if op == "dividedBy" {
		b := evaluate(node.b, resolver)
		ll.assert(b != 0, "exec.formula.evaluate: division by zero")
		a := evaluate(node.a, resolver)
		// ceiling division; assumes a >= 0 (resource metrics — sizes, line counts — are non-negative)
		return (a + b - 1) / b
	}

	if op == "atLeast" { a := evaluate(node.a, resolver); b := evaluate(node.b, resolver); return a > b ? a : b }
	if op == "atMost"  { a := evaluate(node.a, resolver); b := evaluate(node.b, resolver); return a < b ? a : b }
	if op == "between" {
		v := evaluate(node.value, resolver)
		lo := evaluate(node.lo, resolver)
		hi := evaluate(node.hi, resolver)
		ll.assert(lo <= hi, "exec.formula.between: lo (%v) must be <= hi (%v) — inverted bounds collapse every input to hi", lo, hi)
		if v < lo { v = lo }
		if v > hi { v = hi }
		return v
	}

	if op == "gt"  { return evaluate(node.a, resolver) > evaluate(node.b, resolver) }
	if op == "gte" { return evaluate(node.a, resolver) >= evaluate(node.b, resolver) }
	if op == "lt"  { return evaluate(node.a, resolver) < evaluate(node.b, resolver) }
	if op == "lte" { return evaluate(node.a, resolver) <= evaluate(node.b, resolver) }
	if op == "and" { return evaluate(node.a, resolver) && evaluate(node.b, resolver) }
	if op == "or"  { return evaluate(node.a, resolver) || evaluate(node.b, resolver) }
	if op == "not" { return !evaluate(node.a, resolver) }

	if op == "when" { return evaluate(node.cond, resolver) ? evaluate(node.then, resolver) : evaluate(node["else"], resolver) }

	ll.panic("exec.formula.evaluate: unknown op %q", op)
}

// _fail reports an invalid formula result: through the caller's `fail` when given, else a panic.
_fail := func(fail, msg) {
	if len(fail) > 0 && !is_undefined(fail[0]) {
		fail[0](msg)
	}
	ll.panic("%s", msg)
}

// evaluateResource evaluates a formula destined for a resource quota (ram / cpu /
// gpu) and asserts the result is usable: a positive integer. It first rejects a
// comparison/logic op at the top level — Tengo's && / || return the deciding
// OPERAND (an int), so a top-level .and/.or of ints would otherwise pass the
// is_int check; comparisons and logic belong only inside a f.when(...) branch. The
// positive-int check then catches a non-positive result (a .minus that
// underflows, or a metric that floored to 0) BEFORE it reaches the quota as an
// opaque "trueb" RAM string or a 0-core request. `label` ("ram" / "cpu" /
// "gpuMemory") names the offending dimension.
//
// `fail`, optional, is called with the message instead of panicking with it, for a caller that
// adds context to the error (the outcome router keeps the failed attempt and its history).
// evaluateScratch takes it too.
evaluateResource := func(node, resolver, label, ...fail) {
	node = _unwrap(node)
	if sets.hasElement(_BOOL_OPS, node.op) {
		_fail(fail, fmt.sprintf("exec resource formula (%s) must compute a number, but its top-level op is %q (a comparison/logic op). Use comparisons and logic only inside f.when(...).",
			label, node.op))
	}
	v := evaluate(node, resolver)
	if !is_int(v) || v <= 0 {
		_fail(fail, fmt.sprintf("exec resource formula (%s) must evaluate to a positive integer, got %v. If a metric can be zero or a subtraction can underflow, floor it with .atLeast(...) or .between(...).",
			label, v))
	}
	return v
}

// evaluateScratch is evaluateResource for a scratch request, where 0 is a valid answer:
// the command gets its temporary directory and no sized device, the same meaning a
// static `scratchFreeSpace: 0` has. A negative result is still an error.
evaluateScratch := func(node, resolver, ...fail) {
	node = _unwrap(node)
	if sets.hasElement(_BOOL_OPS, node.op) {
		_fail(fail, fmt.sprintf("exec resource formula (scratchFreeSpace) must compute a number, but its top-level op is %q (a comparison/logic op). Use comparisons and logic only inside f.when(...).",
			node.op))
	}
	v := evaluate(node, resolver)
	if !is_int(v) || v < 0 {
		_fail(fail, fmt.sprintf("exec resource formula (scratchFreeSpace) must evaluate to a non-negative integer, got %v. Floor a subtraction that can underflow with .atLeast(0).",
			v))
	}
	return v
}

// ---- workflow-render-time resolution helpers -------------------------------

// Line-oriented text extensions f.lineCount() supports, and the compression
// suffixes it may carry. The line-counter binary infers the codec from the
// suffix itself, so the builder only needs to recognize and strip it — hence a
// set, not an ext -> codec map.
_LINECOUNT_OK := sets.fromSlice(["csv", "tsv", "txt", "fastq", "fq", "fasta", "fa", "tab"])
_COMPRESSION_EXT := sets.fromSlice(["gz", "bz2", "zst"])

_assertMetricCompatible := func(metric, fileName) {
	if metric == "lineCount" {
		// Strip a trailing compression suffix (case-insensitively, mirroring the
		// line-counter binary, which lowercases it before decompressing), then
		// match the format-bearing extension case-insensitively so .TXT / .FASTQ
		// and "reads.fastq.GZ" are all accepted. `ext` keeps its original case for
		// the error message.
		parts := text.split(fileName, ".")
		if len(parts) >= 2 && sets.hasElement(_COMPRESSION_EXT, text.to_lower(parts[len(parts)-1])) {
			parts = parts[0:len(parts)-1]
		}
		ext := len(parts) >= 2 ? parts[len(parts)-1] : ""
		ll.assert(sets.hasElement(_LINECOUNT_OK, text.to_lower(ext)),
			"exec.formula: lineCount is not supported for file %q (extension %q is not a line-oriented text format)", fileName, ext)
	}
	// size is always compatible
}

resolveAst := undefined
resolveAst = func(node, tagMap, allFiles) {
	node = _unwrap(node)
	op := node.op
	if op == "metric" && node.metric == "custom" {
		// A collector reads either files it was given itself or the exec's own files (all of
		// them, or those under its tag), and runs once over the whole set.
		files := node.files
		if is_undefined(files) {
			files = is_undefined(node.tag) ? allFiles : (is_undefined(tagMap[node.tag]) ? [] : tagMap[node.tag])
		}
		if len(files) == 0 {
			ll.assert(!is_undefined(node.default),
				"exec.formula: collector %q has no files to read for metric %q, and no { default: ... } was given", node.collector, node.name)
			return { op: "const", value: node.default }
		}
		return { op: "custom", collector: node.collector, name: node.name, declared: node.declared, files: slices.quickSort(files) }
	}
	if op == "metric" {
		files := is_undefined(node.tag) ? allFiles : (is_undefined(tagMap[node.tag]) ? [] : tagMap[node.tag])
		if len(files) == 0 {
			if is_undefined(node.tag) {
				ll.assert(!is_undefined(node.default),
					"exec.formula: f.%s() references all input files but the exec has none, and no { default: ... } was given", node.metric)
			} else {
				ll.assert(!is_undefined(node.default),
					"exec.formula: tag %q has no files and no { default: ... } was given", node.tag)
			}
			return { op: "const", value: node.default }
		}
		for fn in files { _assertMetricCompatible(node.metric, fn) }
		files = slices.quickSort(files)
		// A metricSum always has >= 1 file (the no-files case became a const
		// above), and the resolver computes the metric from those files — so a
		// carried { default } would be dead data. default is intentionally NOT
		// placed on the metricSum. It only drives the no-files const substitution.
		return { op: "metricSum", metric: node.metric, files: files }
	}
	// Non-metric node: copy the map, recursing into any child-node field (a map
	// carrying an `op`) and passing every other field through unchanged.
	return maps.mapValues(node, func(v) {
		return is_map(v) && !is_undefined(v.op) ? resolveAst(v, tagMap, allFiles) : v
	})
}

referencedMetricFiles := func(resolvedNode) {
	resolvedNode = _unwrap(resolvedNode)
	acc := {}
	walk := undefined
	walk = func(n) {
		if n.op == "metricSum" {
			if n.metric != "size" {
				existing := is_undefined(acc[n.metric]) ? [] : acc[n.metric]
				for fn in n.files { existing = append(existing, fn) }
				// slices.unique dedups while preserving first-seen order (a file may be
				// referenced by more than one metricSum node — e.g. a when cond and a
				// branch — but needs only one line-counter pre-exec).
				acc[n.metric] = slices.unique(existing)
			}
			return
		}
		for k, v in n {
			if is_map(v) && !is_undefined(v.op) { walk(v) }
		}
	}
	walk(resolvedNode)
	return acc
}

// referencedCollectors lists the collectors a resolved formula reads, with the files each one
// runs over: { <collector name>: [<file name>...] }. A collector has one set of files per exec,
// so two of its metrics never ask for two runs.
referencedCollectors := func(resolvedNode) {
	resolvedNode = _unwrap(resolvedNode)
	acc := {}
	walk := undefined
	walk = func(n) {
		if n.op == "custom" {
			ll.assert(is_undefined(acc[n.collector]) || acc[n.collector] == n.files,
				"exec.formula: collector %q reads different files in one exec", n.collector)
			acc[n.collector] = n.files
			return
		}
		for k, v in n {
			if is_map(v) && !is_undefined(v.op) { walk(v) }
		}
	}
	walk(resolvedNode)
	return acc
}

// parseCollectorOutput reads what a collector wrote: a JSON object with one non-negative integer
// per declared metric and nothing else. Returns { values } or { err } with a message naming the
// collector. `declared` is the list of metric names the collector was declared with.
parseCollectorOutput := func(collectorName, declared, data) {
	v := json.decode(data)
	if is_error(v) || !is_map(v) {
		return { err: fmt.sprintf("exec.formula: collector %q must write a JSON object of metric -> integer, got %q", collectorName, string(data)) }
	}
	known := sets.fromSlice(declared)
	for k, x in v {
		if !sets.hasElement(known, k) {
			return { err: fmt.sprintf("exec.formula: collector %q wrote metric %q, which it does not declare (declared: %s)", collectorName, k, text.join(declared, ", ")) }
		}
		if !is_int(x) || x < 0 {
			return { err: fmt.sprintf("exec.formula: collector %q wrote %v for metric %q; a metric is one non-negative integer", collectorName, x, k) }
		}
	}
	for k in declared {
		if is_undefined(v[k]) {
			return { err: fmt.sprintf("exec.formula: collector %q did not write metric %q", collectorName, k) }
		}
	}
	return { values: v }
}

// applyFormulaFallback resolves the static ram/cpu/gpu/scratch to use when the backend
// cannot evaluate resource formulas at run time (no getBlobSize). `dims` is keyed
// by dimension — { ram: { ast, fallback, static }, cpu: {...}, gpu?: {...} } —
// where `ast` is the formula (if any), `static` the static request (if any), and
// `fallback` the .staticFallback()/{ fallback } given on the formula. A formula
// dimension needs SOME static value: a static request always wins (the formula
// won't run on this backend) and doubles as the fallback, so `fallback` fills in
// only when no static request was set; the sole error is a formula dimension with
// NEITHER. Returns { ram, cpu, gpu, err } — err a message string or undefined;
// the caller asserts err is undefined, then applies ram/cpu/gpu. (Field is `err`,
// not `error`: `error` is a reserved word in Tengo.) The values are validated by
// the builder before they reach here; this only picks among them. The gpu
// dimension is optional in `dims` (omitted when no GPU is in play); res.gpu is
// then undefined and the caller leaves the quota's gpuMemory unset.
//
// Scratch space breaks the "needs SOME static value" rule on purpose: a scratch
// formula with neither a static request nor a fallback resolves to undefined and
// the caller simply omits the field. A backend that cannot evaluate the formula
// cannot serve a scratch request either — scratch control came after formulas — so
// no value this could pick would change what the command gets, and refusing the
// exec over the missing one would cost a run for nothing. RAM and CPU are honoured
// by those same backends and have no run at all without a number, so they error.
applyFormulaFallback := func(dims) {
	gpu := is_undefined(dims.gpu) ? {} : dims.gpu
	scratch := is_undefined(dims.scratch) ? {} : dims.scratch
	res := { ram: dims.ram.static, cpu: dims.cpu.static, gpu: gpu.static, scratch: scratch.static, err: undefined }
	if !is_undefined(_unwrap(dims.ram.ast)) && is_undefined(res.ram) {
		if is_undefined(dims.ram.fallback) {
			res.err = "exec.builder: the RAM formula needs a static fallback on backends that can't evaluate resource formulas at run time. Provide .staticFallback(...) on the RAM formula, set a static ram, or upgrade the backend."
			return res
		}
		res.ram = dims.ram.fallback
	}
	if !is_undefined(_unwrap(dims.cpu.ast)) && is_undefined(res.cpu) {
		if is_undefined(dims.cpu.fallback) {
			res.err = "exec.builder: the CPU formula needs a static fallback on backends that can't evaluate resource formulas at run time. Provide .staticFallback(...) on the CPU formula, set a static cpu, or upgrade the backend."
			return res
		}
		res.cpu = dims.cpu.fallback
	}
	if !is_undefined(_unwrap(gpu.ast)) && is_undefined(res.gpu) {
		if is_undefined(gpu.fallback) {
			res.err = "exec.builder: the VRAM formula needs a static fallback on backends that can't evaluate resource formulas at run time. Provide .staticFallback(...) on the vram formula, set a static vram, or upgrade the backend."
			return res
		}
		res.gpu = gpu.fallback
	}
	if !is_undefined(_unwrap(scratch.ast)) && is_undefined(res.scratch) {
		res.scratch = scratch.fallback
	}
	return res
}

// ---- collectors carried by wrappers -----------------------------------------
// A custom metric's AST names its collector; the collector itself (its builder function and
// files) cannot live in the AST, which is serialized. So every wrapper also carries the
// collectors its AST names, { <name>: <collector> }, merged from both operands by every chain
// method. The exec builder reads them back with collectorsOf().

// At most this many collectors per exec. Each is a job of its own, with a queue slot, an
// allocation and a cache entry, run before the sized job: a cost guard, not a privacy one.
MAX_COLLECTORS := 3

_BUILT_IN_METRICS := sets.fromSlice(["size", "lineCount"])

_collectorsOf := func(x) {
	return is_map(x) && !is_undefined(x.__isFormula__) && !is_undefined(x.__collectors__) ? x.__collectors__ : {}
}

_mergeCollectors := func(...parts) {
	res := {}
	for part in parts {
		for name, c in _collectorsOf(part) {
			ll.assert(is_undefined(res[name]) || res[name].id == c.id,
				"exec.formula: two different collectors are named %q; a collector name must be unique", name)
			res[name] = c
		}
	}
	ll.assert(len(res) <= MAX_COLLECTORS,
		"exec.formula: a formula reads %d collectors (%s), at most %d are allowed per exec",
		len(res), text.join(slices.quickSort(maps.getKeys(res)), ", "), MAX_COLLECTORS)
	return res
}

// ---- fluent wrapper factory ------------------------------------------------
// _node wraps a plain AST in a chainable object. Every chain method returns a
// NEW wrapper (immutable), carrying the accumulated { fallback } and collectors forward and
// reading left-to-right — `f.size("x").times(12).plus(f.gib(8))` composes
// times(size, 12) then plus(that, gib(8)). Arithmetic: .plus/.minus/.times;
// .dividedBy -> ceiling division, .dividedByFloor -> integer (truncating)
// division. Bounds: .atLeast/.atMost/.between(lo, hi). Comparisons
// (.gt/.gte/.lt/.lte) and logic (.and/.or/.not) build boolean nodes for use
// inside a f.when(...) branch. Each method's op string equals its name.
// .staticFallback pins the value used on backends that can't evaluate the formula.
_node := undefined
_node = func(ast, fallback, collectors) {
	self := {
		__isFormula__:   true,
		__ast__:         ast,
		__fallback__:    fallback,
		__collectors__:  collectors
	}
	bin := func(op, x) { return _node(_bin(op, ast, x), fallback, _mergeCollectors(self, x)) }
	self.plus      = func(x) { return bin("plus", x) }
	self.minus     = func(x) { return bin("minus", x) }
	self.times     = func(x) { return bin("times", x) }
	self.dividedBy      = func(x) { return bin("dividedBy", x) }
	self.dividedByFloor = func(x) { return bin("dividedByFloor", x) }
	self.atLeast   = func(x) { return bin("atLeast", x) }
	self.atMost    = func(x) { return bin("atMost", x) }
	self.between   = func(lo, hi) {
		return _node({ op: "between", value: _wrap(ast), lo: _wrap(lo), hi: _wrap(hi) }, fallback, _mergeCollectors(self, lo, hi))
	}
	self.gt        = func(x) { return bin("gt", x) }
	self.gte       = func(x) { return bin("gte", x) }
	self.lt        = func(x) { return bin("lt", x) }
	self.lte       = func(x) { return bin("lte", x) }
	self.and       = func(x) { return bin("and", x) }
	self.or        = func(x) { return bin("or", x) }
	self.not       = func() { return _node({ op: "not", a: _wrap(ast) }, fallback, collectors) }
	self.staticFallback = func(v) { return _node(ast, _staticValue(v), collectors) }
	return self
}

// _condBuilder accumulates when()-branches and folds them, right-to-left, into a
// nested `when` AST on .otherwise(). It exposes ONLY .when / .otherwise — so a
// conditional must be finished with .otherwise (there is no way to leak a
// dangling boolean into a quota).
_condBuilder := undefined
_condBuilder = func(branches, collectors) {
	self := {}
	self.when = func(cond, value) {
		// Copy `branches` before appending so sibling chains off the same builder
		// never alias each other's branch list.
		next := []
		for br in branches { next = append(next, br) }
		next = append(next, { cond: _wrap(cond), value: _wrap(value) })
		return _condBuilder(next, _mergeCollectors({ __isFormula__: true, __collectors__: collectors }, cond, value))
	}
	self.otherwise = func(dflt) {
		node := _wrap(dflt)
		i := len(branches) - 1
		for i >= 0 {
			b := branches[i]
			node = { op: "when", cond: b.cond, then: b.value, "else": node }
			i = i - 1
		}
		return _node(node, undefined, _mergeCollectors({ __isFormula__: true, __collectors__: collectors }, dflt))
	}
	return self
}

_const := func(n) { ll.assert(is_int(n), "exec.formula: unit amount must be an integer"); return _node({ op: "const", value: n }, undefined, {}) }

_NAME_RE := "^[A-Za-z][A-Za-z0-9_]*$"

// Tells two collectors apart: Tengo never finds two functions equal, so a collector cannot be
// compared by its builder.
_collectorSeq := 0

/**
 * collector declares a custom metric source: software the block author supplies, run once over
 * a set of input files before the job it sizes, writing several metrics at once.
 *
 * @param name: string - unique among the collectors of one exec; not a built-in metric name
 * @param def: map -
 *   metrics: string[]     - the metric names the collector writes (at least one, unique)
 *   builder: func(files)  - gets the files to read, { <file name>: <file resource> }, and returns
 *                           an exec.builder() that writes `output`, with the software, arguments,
 *                           files and resources (its cost bound) set; do not run() it. It may run
 *                           commands of its own first and stage their results, so a tool's report
 *                           can be turned into the metrics by a second command.
 *   output: string        - optional, default "metrics.json": the file the command writes, or
 *                           "stdout" for its standard output. A JSON object with one non-negative
 *                           integer per declared metric and no other key, e.g.
 *                           {"reads": 1200000, "longestRead": 301}
 *   tag: string           - optional: read the exec's files under this addFile tag
 *   files: map            - optional: { <file name>: <file resource> } the collector reads,
 *                           for a job that does not stage the files itself. Exclusive with tag.
 *                           With neither, the collector reads every file the exec adds.
 * @return { name, metric: func(metricName, ...opts) } - metric() is a formula leaf; opts may be
 *         { default: <int> }, the value when the collector has no files to read.
 */
collector := func(name, def) {
	ll.assert(is_string(name) && text.re_match(_NAME_RE, name), "exec.formula.collector: name must be an identifier, got %v", name)
	ll.assert(!sets.hasElement(_BUILT_IN_METRICS, name), "exec.formula.collector: %q is a built-in metric name", name)
	ll.assert(is_map(def), "exec.formula.collector(%q): expected a definition map", name)
	allowed := { metrics: true, builder: true, output: true, tag: true, files: true }
	for k, _ in def {
		ll.assert(!is_undefined(allowed[k]), "exec.formula.collector(%q): unknown key %q (allowed: metrics, builder, output, tag, files)", name, k)
	}
	ll.assert(is_array(def.metrics) && len(def.metrics) > 0, "exec.formula.collector(%q): metrics must be a non-empty list of names", name)
	seen := {}
	for m in def.metrics {
		ll.assert(is_string(m) && text.re_match(_NAME_RE, m), "exec.formula.collector(%q): metric name must be an identifier, got %v", name, m)
		ll.assert(is_undefined(seen[m]), "exec.formula.collector(%q): metric %q is declared twice", name, m)
		seen[m] = true
	}
	ll.assert(is_callable(def.builder), "exec.formula.collector(%q): builder must be a function of the files", name)
	output := is_undefined(def.output) ? "metrics.json" : def.output
	ll.assert(is_string(output) && output != "", "exec.formula.collector(%q): output must be a file name", name)
	ll.assert(is_undefined(def.tag) || is_undefined(def.files), "exec.formula.collector(%q): give tag or files, not both", name)
	ll.assert(is_undefined(def.tag) || is_string(def.tag), "exec.formula.collector(%q): tag must be a string", name)
	ll.assert(is_undefined(def.files) || is_map(def.files), "exec.formula.collector(%q): files must be a map of file name -> resource", name)

	declared := copy(def.metrics)
	_collectorSeq += 1
	c := { id: _collectorSeq, name: name, metrics: declared, builder: def.builder, output: output, files: def.files }
	collectors := {}
	collectors[name] = c

	return {
		name: name,
		metric: func(metricName, ...opts) {
			ll.assert(!is_undefined(seen[metricName]), "exec.formula.collector(%q): metric %q is not declared (declared: %s)", name, metricName, text.join(declared, ", "))
			node := { op: "metric", metric: "custom", collector: name, name: metricName, declared: declared }
			if !is_undefined(def.tag) { node.tag = def.tag }
			if !is_undefined(def.files) { node.files = maps.getKeys(def.files) }
			for opt in opts {
				ll.assert(is_map(opt) && is_int(opt.default) && opt.default >= 0, "exec.formula.collector(%q).metric(%q): expected { default: <non-negative int> }, got %v", name, metricName, opt)
				node.default = opt.default
			}
			return _node(node, undefined, collectors)
		}
	}
}

export {
	// size: total blob bytes of the input files the metric reads (no pre-exec).
	//   f.size() with no tag reads every file added with addFile(). f.size("tag")
	//   reads only the files under that tag. A file created with writeFile() is NOT
	//   counted: allFiles comes from filesToAdd, never filesToWrite. That excludes a
	//   non-partitioned JSON p-column, which pframes.util attaches with writeFile,
	//   and every .spec and .datainfo sidecar. { default: n } gives the value when
	//   the metric resolves to no files, and resolveAst fails if no default was given.
	// lineCount: total NEWLINE characters across the referenced files — a file
	//   with N newlines reports N, so a final line without a trailing newline is
	//   NOT counted. Requires a pre-exec line-counter pass, so it is supported
	//   only for line-oriented text formats (see _LINECOUNT_OK above).
	size:      func(...args) { return _node(_metric("size", args), undefined, {}) },
	lineCount: func(...args) { return _node(_metric("lineCount", args), undefined, {}) },

	// collector: a custom metric source, see collector() above. Its .metric(name) is a leaf
	//   like size/lineCount. Evaluated only where the backend evaluates formulas; elsewhere the
	//   dimension takes its .staticFallback(), as any formula does.
	collector: collector,
	MAX_COLLECTORS: MAX_COLLECTORS,

	gib: func(n) { return _const(n * units.GiB) },
	mib: func(n) { return _const(n * units.MiB) },
	kib: func(n) { return _const(n * units.KiB) },
	gb:  func(n) { return _const(n * units.GB) },
	mb:  func(n) { return _const(n * units.MB) },
	kb:  func(n) { return _const(n * units.KB) },

	// const: a bare integer as a formula leaf (bytes / cores). Handy when a
	// dimension is a plain number you still want to chain off of.
	const: func(n) { return _const(n) },

	// when(cond, value): start a multi-branch conditional. Chain more .when(...)
	// branches (evaluated in order), then finish with .otherwise(default). Compiles
	// to a nested `when` — the first branch whose condition is truthy wins. Conditions
	// come from the comparison/logic chain, e.g. f.size("input").gt(f.gib(1)).
	when: func(cond, value) { return _condBuilder([], {}).when(cond, value) },

	// ---- wrapper introspection (used by the exec builder) ------------------
	// astOf: the plain AST behind a value (a wrapper -> its __ast__; a plain AST
	//   or int -> itself). fallbackOf: the .staticFallback() carried on a wrapper
	//   (else undefined). isFormula: true for a wrapper or a plain AST node, false
	//   for a bare number/string (i.e. a static request).
	astOf:      func(x) { return _unwrap(x) },
	fallbackOf: func(x) { return is_map(x) && !is_undefined(x.__isFormula__) ? x.__fallback__ : undefined },
	isFormula:  func(x) { return is_map(x) && (!is_undefined(x.__isFormula__) || !is_undefined(x.op)) },
	// collectorsOf: the collectors a wrapper's custom metrics read, { <name>: <collector> }.
	collectorsOf: _collectorsOf,

	evaluateResource:      evaluateResource,
	evaluateScratch:       evaluateScratch,
	resolveAst:            resolveAst,
	referencedMetricFiles: referencedMetricFiles,
	referencedCollectors:  referencedCollectors,
	parseCollectorOutput:  parseCollectorOutput,
	applyFormulaFallback:  applyFormulaFallback,

	// _internal: SDK-internal entry points, NOT part of the block-author API.
	// evaluate is the raw evaluator — it bypasses evaluateResource's positive-integer
	// and no-top-level-comparison guards (it can return a bool or a non-positive int),
	// so it must not be used to compute a quota. Exposed only for the unit tests and
	// evaluateResource's own use; authors use the constructors + evaluateResource.
	_internal: { evaluate: evaluate }
}
