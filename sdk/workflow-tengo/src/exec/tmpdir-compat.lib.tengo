/** Compatibility layer: give a command TMPDIR and TMP on a backend that does not.
 *
 * A current backend guarantees both, pointed at '<workdir>/.pl/tmp', to every command that asked
 * for scratch space - any size, including none. A backend from before that contract sets TMPDIR
 * only for a sized request, or not at all, and has no '{system.scratch.path}' and 
 * '{system.scratch.<size>}' to render.
 *
 * The SDK closes the gap itself rather than leaving blocks to branch on a flag. Two obstacles
 * shaped how:
 *
 *   - Nothing the SDK sends can CREATE '<workdir>/.pl/tmp' on such a backend. Workdir fill refuses
 *     every path under '.pl', which is reserved for platform files, and has done since v4.3.2.
 *     So the directory is made at run time, by a script, with mkdir -p.
 *
 *   - The SDK does not where it runs: on linux server in Kubernetes or on laptop. But it can tell
 *     if it is Windows machine and if commands will be run in containers.
 *
 * For backends prior 4.4.4 executed on non-windows systems we apply wrapper shell script
 * that modifies command's env variables setting TMPDIR and TMP vars accordingly with 4.4.4 and abve.
 * We intentionally ignore Windows hosts as this is builtin-only backends we can update easily
 * along with Desktop App.
 *
 * Everything about the workaround lives in this file. Deleting it is how the workaround goes away
 * once no supported backend needs it.
 *
 * The really dirty part is how we deal with expr variables (system.scratch.*): we have to
 * track their usage and treat them on tengo side for backends before 4.4.0
 */

ll := import(":ll")
text := import("text")

// SCRIPT_FILE_NAME is the wrapper's name in the working directory.
//
// Fixed, not per-run: a file's name and content are part of the exec CID, so a stable name keeps
// identical commands deduplicating. It sits at the workdir root and NOT under '.pl/', because
// workdir fill refuses that directory - the hash suffix is there so it cannot collide with a name
// a block chose.
SCRIPT_FILE_NAME := ".pl-run-compat-f9b7eca1b8.sh"

// SCRATCH_PATH_VARIABLE and SCRATCH_SIZE_VARIABLES are the command-expression variables a block
// writes to ask about its scratch space. A backend from before the contract has no 'system.scratch'
// at all, so these do not render empty - expr.Eval returns nil and the command dies with "variable
// is not defined". Rewriting them is what keeps such a block running.
//
// SCRATCH_SIZE_VARIABLES lists every unit the backend answers with, and lists them LONGEST FIRST.
// The substitution is textual, so 'system.scratch.b' would otherwise match inside
// 'system.scratch.bytes' and leave '0ytes' behind.
SCRATCH_PATH_VARIABLE := "system.scratch.path"
SCRATCH_SIZE_VARIABLES := ["system.scratch.bytes", "system.scratch.gib", "system.scratch.kib",
	"system.scratch.mib", "system.scratch.gb", "system.scratch.kb", "system.scratch.mb",
	"system.scratch.b"]

// WORKDIR_TMP_REL_PATH is the temporary directory relative to the working directory - the same
// place the current backend points TMPDIR at. The command's working directory IS the workdir, so
// the relative form names the same directory without the SDK having to know its absolute path.
WORKDIR_TMP_REL_PATH := ".pl/tmp"

// script returns the wrapper's text.
//
// Held in a FILE, never passed as an inline 'sh -c' script: the Kubernetes job script runs the
// command as `sh -c "$PL_JOB_CMD_AND_ARGS"`, so an inline script would be parsed by that outer
// shell first and "$@" would expand there, empty. Text in a file never passes through it.
script := func() {
	return `#!/bin/sh

# Compatibility layer between a current workflow-tengo SDK and a Platforma Backend from before
# the temporary-directory contract. Update the backend and this file stops appearing here.
#
# Written by exec.tmpdirCompat in @platforma-sdk/workflow-tengo.

wd="${PL_JOB_WORKDIR:-$PWD}"
tmp="$wd/` + WORKDIR_TMP_REL_PATH + `"
mkdir -p "$tmp"

TMPDIR="$tmp"
TMP="$tmp"
export TMPDIR TMP

exec "$@"
`
}

// isNeeded reports whether the backend leaves the temporary directory to the SDK.
//
// Current SDK contract sounds: any command execution gets TMPDIR and TMP pointing into
// <workdir>/.pl/tmp
//
// To maintain it, we need compatibility hacks for older backends
//
// scratchSized must be true only when the block asked for a size above zero.
isNeeded := func(feats, scratchSized) {
	if feats.supportsScratchSpaceRequests {
		// >= 4.4.4: no hacks, all is fine
		return false
	}

	if feats.hasScratchSpace {
		// 4.4.0 - 4.4.3: zero scratch request violates contract - need the hack
		return !scratchSized
	}

	// before 4.4.0: no TMPDIR at all in any case - need the hack
	return true
}

// isSizedRequest reports whether the block asked for scratch space of a size above zero, which is
// what isNeeded's second argument needs.
//
// A FORMULA counts as sized even though its value is not known yet. The decision here is taken
// before formula fallback resolution, and reading it the other way round is the expensive mistake:
// treating a formula as sizeless would wrap a command in the 4.4.0-4.4.3 window and point it at
// the working directory instead of the scratch device it asked for. A formula that resolves to
// zero is therefore left without the wrapper - which is the same thing that happens on a backend
// that cannot evaluate the formula at all, where the request is dropped outright.
isSizedRequest := func(scratchFreeSpace, scratchFormulaAst) {
	if !is_undefined(scratchFormulaAst) {
		return true
	}

	if is_undefined(scratchFreeSpace) {
		return false
	}

	return scratchFreeSpace != 0
}

// isWindows reports whether the runner puts commands on a Windows host, judged by the path
// separator the backend reports. Docker is checked before this: a container is Linux whatever the
// runner runs on.
isWindows := func() {
	return ll.pathSeparator == "\\"
}

// concat returns prefix followed by tail.
//
// Not append(prefix, tail...): tengo's append rejects a zero-length spread with "wrong number of
// arguments", so an image that declares no entrypoint would blow up on the happy path.
concat := func(prefix, tail) {
	result := copy(prefix)
	for item in tail {
		result = append(result, item)
	}

	return result
}

// _assertNotWindows refuses the workaround on Windows. Windows ships only as a built-in backend
// whose version we control, so the answer there is to update it rather than to keep a second,
// cmd.exe-shaped wrapper alive.
_assertNotWindows := func() {
	ll.assert(!isWindows(),
		"exec.builder: this Platforma Backend is too old to provide a temporary directory (TMPDIR),"+
			" and the workaround for it is POSIX-shell only, so it cannot run on Windows."+
			" Update Platforma Backend to a version >=4.4.4")
}

// patchSoftwareDescriptor routes a software's command through the wrapper.
//
// All three execution shapes carry their command as '<kind>.cmd', an array of '[command, args...]',
// so all three are patched the same way - except docker, where the image's ENTRYPOINT is the right
// hook: 'cmd' then arrives at the script as "$@" untouched, which is what the proof of concept
// validated.
//
// An image that already declares an entrypoint keeps it, moved behind the script, so replacing the
// entrypoint never silently drops the image's own.
//
// Takes and returns a plain (non-strict) descriptor map.
patchSoftwareDescriptor := func(descriptor, isDockerAvailable) {
	if isDockerAvailable && !is_undefined(descriptor.docker) {
		docker := ll.fromStrict(descriptor.docker)

		entrypoint := docker.entrypoint
		if is_undefined(entrypoint) { entrypoint = [] }
		docker.entrypoint = concat(["sh", "./" + SCRIPT_FILE_NAME], entrypoint)

		descriptor.docker = docker
		return descriptor
	}

	// A bare binary, or a locally built package during block development. Both run on the runner
	// host, so the wrapper has to be a shell the host actually has.
	_assertNotWindows()

	for kind in ["local", "binary"] {
		if is_undefined(descriptor[kind]) { continue }

		pkg := ll.fromStrict(descriptor[kind])
		ll.assert(is_array(pkg.cmd) && len(pkg.cmd) != 0,
			"exec.tmpdirCompat: software descriptor %q has no 'cmd' to wrap", kind)

		pkg.cmd = concat(["sh", "./" + SCRIPT_FILE_NAME], pkg.cmd)
		descriptor[kind] = pkg
	}

	return descriptor
}

// wrapCommand routes a command a block spelled out itself - exec.builder().cmd(...), with no
// software behind it - through the wrapper. Returns the new cmd and the arguments to PREPEND.
//
// The caller must prepend to the typed argument list as well, or an exec that used argExpr would
// lose the wrapper.
wrapCommand := func(cmd) {
	_assertNotWindows()

	return {
		cmd: "sh",
		prependArgs: ["./" + SCRIPT_FILE_NAME, cmd]
	}
}

// rewriteScratchExpressions removes every reference to 'system.scratch' from one argument or
// environment value, so a block that asks about its scratch space still runs on a backend that has
// no such variable to answer with.
//
// The size becomes 0 and the path becomes the temporary directory the wrapper creates, which is the
// truth on such a backend: there is a directory to write into, and no device sized behind it. A
// block reading the size to decide how much to spill therefore sees "nothing promised" rather than
// a number no one honours.
//
// Two shapes are handled, because a command expression can be a whole argument or one piece of a
// larger string:
//
//   - The bare form, '{system.scratch.gib}', is replaced with the value itself. That leaves no
//     braces, so it does not depend on the backend evaluating anything.
//   - Inside any remaining expression, the variable is replaced where it stands, so
//     '{system.scratch.gib * 2}' keeps evaluating - now against 0. The path is quoted there,
//     because it is a string where the units are numbers.
//
// Every other expression is left for the backend to render.
rewriteScratchExpressions := func(value) {
	if !is_string(value) {
		return value
	}

	// Bare forms first: each leaves no expression behind, so nothing below can match it again.
	value = text.replace(value, "{" + SCRATCH_PATH_VARIABLE + "}", WORKDIR_TMP_REL_PATH, -1)
	for variable in SCRATCH_SIZE_VARIABLES {
		value = text.replace(value, "{" + variable + "}", "0", -1)
	}

	if !text.contains(value, "system.scratch.") {
		return value
	}

	// What is left sits inside a larger expression, which the backend still evaluates.
	value = text.replace(value, SCRATCH_PATH_VARIABLE, "'" + WORKDIR_TMP_REL_PATH + "'", -1)
	for variable in SCRATCH_SIZE_VARIABLES {
		value = text.replace(value, variable, "0", -1)
	}

	return value
}

export ll.toStrict({
	SCRIPT_FILE_NAME: SCRIPT_FILE_NAME,
	WORKDIR_TMP_REL_PATH: WORKDIR_TMP_REL_PATH,
	SCRATCH_PATH_VARIABLE: SCRATCH_PATH_VARIABLE,
	SCRATCH_SIZE_VARIABLES: SCRATCH_SIZE_VARIABLES,

	script: script,
	isNeeded: isNeeded,
	isSizedRequest: isSizedRequest,
	isWindows: isWindows,
	patchSoftwareDescriptor: patchSoftwareDescriptor,
	wrapCommand: wrapCommand,
	rewriteScratchExpressions: rewriteScratchExpressions,
	concat: concat
})
