/**
 * A builder for executing commands.
 */

ll := import(":ll")
validation := import(":validation")

assets := import(":assets")
smart := import(":smart")
times := import("times")
maps := import(":maps")
sets := import(":sets")
slices := import(":slices")
path := import(":path")
render := import(":render")
enum := import("enum")
oop := import(":oop")
constants := import(":constants")
canonical := import(":canonical")
monetization := import(":exec.monetization_internal")
execConstants := import(":exec.constants")
tmpdirCompat := import(":exec.tmpdir-compat")
execFormula := import(":exec.formula")
units := import(":units")
feats := import(":feats")
limits := import(":exec.limits")
fallback := import(":exec.fallback")
text := import("text")
fmt := import("fmt")

// line-counter: small Go binary from the software-small-binaries catalogue.
// CLI: `line-counter --input <file> --output <file>`; writes the exact line
// count as a base-10 integer with no trailing newline. Run via the exec
// builder() factory below (recursive function call within :exec — no import,
// no cycle, no DI) to compute f.lineCount() metrics inline.
lineCounterSoft := assets.importSoftware("@platforma-open/milaboratories.software-small-binaries:line-counter")

// Forward declaration. The body is assigned after builder() (below) so it can
// call the builder() factory recursively; declaring the name here lets
// builder().run() reference it at compile time (Tengo resolves module-level
// identifiers lexically — a closure cannot see a name declared textually after
// the enclosing function).
_lineCountResource := undefined

// _assertValidCpuRequest / _assertValidMemRequest / _assertValidGpuRequest hold
// the single definition of a valid CPU / RAM / VRAM request, so the static
// setters (.cpu()/.mem()/.gpuMemory()), the .resources({...}) dimensions, and
// the formula .staticFallback() (which substitutes for a static request on
// backends that cannot evaluate formulas) all enforce the same contract. `ctx`
// prefixes the message so the error names the offending setter.
_assertValidCpuRequest := func(amount, ctx) {
	validation.assertType(amount, "number", ctx + ": amount of cores must be a number")
	ll.assert(amount > 0, ctx + ": amount of cores should be greater than 0")
}
_assertValidMemRequest := func(amount, ctx) {
	validation.assertType(amount, ["or", "number", "string"], ctx + ": RAM amount should be a number or string")
	ll.assert(is_string(amount) || amount >= 16 * units.MiB, ctx + ": amount in bytes should be at least 16MiB")
}
// A VRAM request is a size string ("16GiB") or a number of bytes. The static
// .gpuMemory() takes a string; a formula .staticFallback() may resolve to a
// number of bytes (e.g. f.gib(48)) — both are accepted, mirroring _assertValidMemRequest,
// including the 16MiB floor that catches a bytes-where-GiB-was-meant mistake.
_assertValidGpuRequest := func(amount, ctx) {
	validation.assertType(amount, ["or", "number", "string"], ctx + ": VRAM amount must be a number of bytes or a size string like '16GiB'")
	ll.assert(is_string(amount) || amount >= 16 * units.MiB, ctx + ": VRAM amount in bytes should be at least 16MiB (did you pass bytes instead of GiB?)")
}
// A scratch request is a size string ("500GiB") or a number of bytes, with the same 16MiB floor
// that catches a bytes-where-GiB-was-meant mistake.
//
// Exactly 0 is the one number below that floor which is accepted, because it is not a size at all:
// it asks for the temporary directory the backend guarantees to every request, without a device
// behind it. Anything between 1 byte and 16MiB stays a mistake.
_assertValidScratchRequest := func(amount, ctx) {
	validation.assertType(amount, ["or", "number", "string"], ctx + ": scratch space amount must be a number of bytes or a size string like '500GiB'")
	ll.assert(is_string(amount) || amount == 0 || amount >= 16 * units.MiB, ctx + ": scratch space in bytes should be at least 16MiB, or exactly 0 to ask only for a temporary directory (did you pass bytes instead of GiB?)")
}

// Builder ids, one per builder and per copy(): the identity the cycle check of verify() keys on.
_lastBuilderId := 0

/**
 * The whole state of one builder, in one map, so copy() is a clone of it.
 */
_newState := func() {
	_lastBuilderId += 1

	return {
		id: _lastBuilderId,

		soft: undefined,
		cmd: undefined,
		args: [], // list of strings
		argsTyped: [], // list of {type: expression|string, value: string}
		typedArgSet: false,
		typedEnvSet: false,
		envs: {}, // map of names to values-strings
		envsTyped: {}, // map of names to {type: expression|string, value: string}
		secrets: {}, // { "env_name": "{secrets.secret_name}", ... }

		entrypointSet: false,

		//
		// Limits
		//
		queue: execConstants.HEAVY_QUEUE,
		cpuRequest: undefined,
		ramRequest: undefined,
		gpuMemory: undefined,
		scratchFreeSpace: undefined,

		// resource-formula builder state (ram / cpu / vram formulas + addFile tags).
		// Set by .resources({ ... }); each *FormulaAst holds a plain formula AST and
		// each *FormulaFallback the static value used on backends that can't evaluate
		// formulas at run time (see analysis doc §4).
		memFormulaAst: undefined,
		memFormulaFallback: undefined,
		cpuFormulaAst: undefined,
		cpuFormulaFallback: undefined,
		gpuFormulaAst: undefined,
		gpuFormulaFallback: undefined,
		scratchFormulaAst: undefined,
		scratchFormulaFallback: undefined,
		fileTags: {},   // fileName -> tag (for f.size("tag") / f.lineCount("tag") aggregation)

		commandName: "",
		cache: 0,
		inputCache: 0,
		nErrorLines: 200,

		// files to be added in workdir
		filesToAdd: {},
		// files to be created in the workdir with the content from resources
		filesToWrite: {},
		// names from filesToAdd / filesToWrite that should land in the workdir as
		// 0o600 (writable). Anything not in the set stays 0o400 (read-only,
		// hardlinked from the archive cache).
		writableFiles: {},
		// directories to create in the workdir
		dirsToCreate: {},

		// files to save from the workdir
		filesToSave: {},
		// files which content to save from the workdir
		filesContentToSave: {},
		// file sets to save by regex
		fileSetsToSave: {},
		// file sets to save by regex (save file content)
		fileSetsContentToSave: {},
		// files to stream from the workdir
		filesToStream: {},
		// workdir processors
		wdProcessors: {},

		// assets to be extracted into workdir before execution
		assetInfos: {},
		assetDescriptors: {},
		assetRules: {},
		assetCache: {},

		mnz: monetization.init(),

		stdout: "stdout.txt",
		stderr: "stderr.txt",
		stderrToStdout: false,
		stdoutFile: false,
		stderrFile: false,
		stdoutStream: false,
		stderrStream: false,
		stdoutContent: false,
		stderrContent: false,

		// fallbacks(): reason -> [{ attrs, name, builder }], see :exec.fallback
		fallbacks: undefined,

		// test seams: render as on a backend without RunCommand v3 (_forceRunCommandV2()), or
		// without WorkdirSave v3 (_forceWorkdirSaveV1())
		forceRunCommandV2: false,
		forceWorkdirSaveV1: false
	}
}

// Copies plain maps and arrays; everything else, smart references, software and asset infos and
// other builders included, is shared. The monetization object is a strict map of plain values
// and is copied as a whole.
_cloneValue := undefined
_cloneValue = func(v) {
	if is_map(v) {
		res := {}
		for k, vv in v {
			res[k] = _cloneValue(vv)
		}
		return res
	}
	if is_array(v) {
		res := []
		for vv in v {
			res = append(res, _cloneValue(vv))
		}
		return res
	}
	return v
}

_cloneState := func(st) {
	res := _cloneValue(st)
	res.mnz = maps.clone(st.mnz)
	return res
}

/**
 * Applies the stdout/stderr shortcuts (saveStdoutFile(), saveStderrStream(), ...) to the save and
 * stream sets. Mutates the given state: call it on a clone.
 */
_finalizeOutputs := func(st) {
	if st.stderrToStdout {
		st.stderr = st.stdout
	}
	if st.stdoutFile {
		sets.add(st.filesToSave, st.stdout)
	}
	if st.stderrFile {
		sets.add(st.filesToSave, st.stderr)
	}
	if st.stdoutStream {
		sets.add(st.filesToSave, st.stdout)
		sets.add(st.filesToStream, st.stdout)
	}
	if st.stderrStream {
		sets.add(st.filesToSave, st.stderr)
		sets.add(st.filesToStream, st.stderr)
	}
	if st.stdoutContent {
		sets.add(st.filesContentToSave, st.stdout)
	}
	if st.stderrContent {
		sets.add(st.filesContentToSave, st.stderr)
	}
}

/**
 * Today's run() up to and including the render inputs: the pure and the meta inputs of an
 * exec.exec render for the given state. Mutates the given state: call it on a clone.
 *
 * @return {inputs: map, meta: map, renderOpts: map}
 */
_planOf := func(st) {
	_finalizeOutputs(st)


	// --- Temporary directory on a backend that does not provide one ---------------
	// A current backend guarantees TMPDIR and TMP to every command that asked for scratch
	// space. An older one does not, so the SDK provides them itself: a small script staged
	// into the working directory makes the directory and execs the real command behind it.
	// See :exec.tmpdir-compat for why it has to be a file, and why the directory cannot be
	// created any other way.
	tmpdirCompatNeeded := tmpdirCompat.isNeeded(
		feats,
		tmpdirCompat.isSizedRequest(st.scratchFreeSpace, st.scratchFormulaAst)
	)
	if tmpdirCompatNeeded {
		// Only the wrapper that will actually run is staged, and which one that is
		// depends on where the command lands: a container is Linux whatever the host
		// is, while a command on the host needs the interpreter that host has.
		inContainer := false
		if !is_undefined(st.soft) {
			inContainer = tmpdirCompat.usesDocker(
				ll.fromStrict(st.soft.descriptor), feats.isDockerAvailable)
		}
		for name, content in tmpdirCompat.filesToStage(inContainer) {
			st.filesToWrite[name] = content
		}

		// 'system.scratch' does not exist on such a backend - an expression naming it
		// fails to evaluate rather than rendering empty - so every reference to it is
		// removed. The path becomes the directory the wrapper creates, named relative
		// to the working directory the command runs in, and the size becomes 0: there
		// is somewhere to write, and no device sized behind it.
		st.args = slices.map(st.args, tmpdirCompat.rewriteScratchExpressions)
		st.argsTyped = slices.map(st.argsTyped, func(a) {
			a.value = tmpdirCompat.rewriteScratchExpressions(a.value)
			return a
		})
		st.envs = maps.mapValues(st.envs, tmpdirCompat.rewriteScratchExpressions)
		st.envsTyped = maps.mapValues(st.envsTyped, func(e) {
			e.value = tmpdirCompat.rewriteScratchExpressions(e.value)
			return e
		})

		// A command a block spelled out itself. Software goes through its descriptor
		// instead, further down, because that is where its command really lives.
		if is_undefined(st.soft) {
			wrapped := tmpdirCompat.wrapCommand(st.cmd)
			st.cmd = wrapped.cmd
			// Both lists, or an exec that used argExpr would lose the wrapper: the typed
			// list is what the backend reads whenever it is sent at all.
			// Not append(prefix, args...): tengo rejects a zero-length spread, and a
			// command with no arguments at all is the common case.
			st.args = tmpdirCompat.concat(wrapped.prependArgs, st.args)
			st.argsTyped = tmpdirCompat.concat(
				slices.map(wrapped.prependArgs, func(a) {
					return { type: execConstants.ARG_TYPE_STRING, value: a }
				}),
				st.argsTyped)
		}
	}

	// We don't want these values to be encoded as JSON's since
	// values are pure bytes.
	// Thus, we create a resource with a custom type here manually.
	filesToWriteRefs := maps.mapValues(st.filesToWrite, func(v) {
		if smart.isReference(v) { return v }
		return smart.createValueResource(constants.RTYPE_BINARY_VALUE, v)
	})

	ll.assert(st.entrypointSet,
		"incomplete command: cmd() or software() must be provided to exec.builder")

	runOptions := {
		cmd: st.cmd,
		args: st.args,
		envs: st.envs,
		secrets: st.secrets,
		queue: st.queue,
		// both stdout and stderr will always be channeled to a file
		// even if stdoutFile or stderrFile are false
		stdout: st.stdout,
		stderr: st.stderr,
		nErrorLines: st.nErrorLines
	}

	pureExecInputs := {
		filesToAdd: smart.createMapResource(st.filesToAdd),
		filesToWrite: smart.createMapResource(filesToWriteRefs),
		dirsToCreate: slices.fromSet(st.dirsToCreate),
		runOptions: runOptions,
		filesToSave: slices.fromSet(st.filesToSave),
		filesContentToSave: slices.fromSet(st.filesContentToSave),
		fileSetsToSave: st.fileSetsToSave,
		fileSetsContentToSave: st.fileSetsContentToSave,
		filesToStream: slices.fromSet(st.filesToStream),
		wdProcessors: st.wdProcessors,
		assets: smart.createMapResource(st.assetInfos),
		assetDescriptors: st.assetDescriptors,
		assetRules: st.assetRules,
		assetCache: st.assetCache
	}

	// Only forward when non-empty so existing workflows that don't
	// opt into writable files keep the exact same CID.
	if len(st.writableFiles) > 0 {
		pureExecInputs.writableFiles = slices.fromSet(st.writableFiles)
	}

	if (is_int(st.ramRequest)) {
		st.ramRequest = string(st.ramRequest) + "b"
	}

	// Resolve formulas (tags -> file lists) and apply the
	// hasBlobSize fallback gate. The static quota below stays populated;
	// the ephemeral exec impl overrides ram/cpu per-dimension when the
	// corresponding formula input is present. lineCount metrics are
	// computed INLINE by running the `line-counter` Go binary via the
	// builder() factory itself (see _lineCountResource). That is a plain
	// recursive function call within :exec — no import of :pt or any
	// metrics module — so there is no import cycle.
	hasFormula := !is_undefined(st.memFormulaAst) || !is_undefined(st.cpuFormulaAst) ||
		!is_undefined(st.gpuFormulaAst) || !is_undefined(st.scratchFormulaAst)
	resolvedMem := undefined
	resolvedCpu := undefined
	resolvedGpu := undefined
	resolvedScratch := undefined
	lineCountMapResource := undefined

	if hasFormula {
		// Live evaluation needs getBlobSize: the pure exec.tpl reads input-file
		// sizes (getBlobSize) at run time when it evaluates the formula. The
		// formula ASTs ride the META rail (CID-transparent); only a computed
		// line-count map, if any, rides the REGULAR rail — it must be deep-waited
		// to final, and being file-derived it adds no CID differentiation (see the
		// attach site below and analysis doc §4). Missing getBlobSize => take the
		// static fallback path, so a formula can never break an exec on a backend
		// that cannot evaluate it.
		canEvaluateFormulas := feats.hasBlobSize
		if !canEvaluateFormulas {
			// Backend can't evaluate formulas (no getBlobSize). Each formula
			// dimension falls back to its .staticFallback(), or to a static
			// request if none was given; error only when a dimension has
			// neither. Pure decision, unit-tested in exec.formula
			// (applyFormulaFallback).
			fb := execFormula.applyFormulaFallback({
				ram: { ast: st.memFormulaAst, fallback: st.memFormulaFallback, static: st.ramRequest },
				cpu: { ast: st.cpuFormulaAst, fallback: st.cpuFormulaFallback, static: st.cpuRequest },
				gpu: { ast: st.gpuFormulaAst, fallback: st.gpuFormulaFallback, static: st.gpuMemory },
				scratch: { ast: st.scratchFormulaAst, fallback: st.scratchFormulaFallback, static: st.scratchFreeSpace }
			})
			ll.assert(is_undefined(fb.err), fb.err)
			st.ramRequest = fb.ram
			st.cpuRequest = fb.cpu
			st.gpuMemory = fb.gpu
			// A scratch formula with nothing to fall back on leaves the request unset.
			// The exec still runs: a backend that cannot evaluate the formula has no
			// scratch storage to give either, so the size is moot rather than missing.
			st.scratchFreeSpace = fb.scratch
			if is_int(st.ramRequest) { st.ramRequest = string(st.ramRequest) + "b" }
			if is_int(st.gpuMemory) { st.gpuMemory = string(st.gpuMemory) + "b" }
			if is_int(st.scratchFreeSpace) { st.scratchFreeSpace = string(st.scratchFreeSpace) + "b" }
		} else {
			tagMap := {}
			for fileName, tag in st.fileTags {
				existing := is_undefined(tagMap[tag]) ? [] : tagMap[tag]
				tagMap[tag] = append(existing, fileName)
			}
			allFiles := maps.getKeys(st.filesToAdd)

			neededLineCount := {}
			if !is_undefined(st.memFormulaAst) {
				resolvedMem = execFormula.resolveAst(st.memFormulaAst, tagMap, allFiles)
				refs := execFormula.referencedMetricFiles(resolvedMem)
				if !is_undefined(refs.lineCount) { sets.add(neededLineCount, refs.lineCount...) }
			}
			if !is_undefined(st.cpuFormulaAst) {
				resolvedCpu = execFormula.resolveAst(st.cpuFormulaAst, tagMap, allFiles)
				refs := execFormula.referencedMetricFiles(resolvedCpu)
				if !is_undefined(refs.lineCount) { sets.add(neededLineCount, refs.lineCount...) }
			}
			if !is_undefined(st.gpuFormulaAst) {
				resolvedGpu = execFormula.resolveAst(st.gpuFormulaAst, tagMap, allFiles)
				refs := execFormula.referencedMetricFiles(resolvedGpu)
				if !is_undefined(refs.lineCount) { sets.add(neededLineCount, refs.lineCount...) }
			}
			if !is_undefined(st.scratchFormulaAst) {
				resolvedScratch = execFormula.resolveAst(st.scratchFormulaAst, tagMap, allFiles)
				refs := execFormula.referencedMetricFiles(resolvedScratch)
				if !is_undefined(refs.lineCount) { sets.add(neededLineCount, refs.lineCount...) }
			}

			if len(neededLineCount) > 0 {
				perFile := {}
				for fn, _ in neededLineCount {
					perFile[fn] = _lineCountResource(fn, st.filesToAdd[fn])
				}
				lineCountMapResource = smart.createMapResource(perFile)
			}
		}
	}

	quotaData := {
		queue: st.queue,
		cpu: st.cpuRequest,
		ram: st.ramRequest
	}
	if !is_undefined(st.gpuMemory) || !is_undefined(st.gpuFormulaAst) {
		// A cpu/ram formula satisfies this requirement just like a static
		// request: it provides an explicit value, computed at run time (the
		// ephemeral impl overrides the quota before allocation; gpuMemory is
		// forwarded alongside), and the fallback covers no-getBlobSize backends.
		// Without this, a GPU + a formula would wrongly assert on hasBlobSize
		// backends (where ramRequest/cpuRequest stay undefined) yet pass on older ones.
		ll.assert(!is_undefined(st.cpuRequest) || !is_undefined(st.cpuFormulaAst), "exec.builder: a cpu request is required when a GPU is requested. GPU nodes vary in CPU capacity and cost; please provide an explicit CPU request.")
		ll.assert(!is_undefined(st.ramRequest) || !is_undefined(st.memFormulaAst), "exec.builder: a ram request is required when a GPU is requested. GPU nodes vary in RAM capacity and cost; please provide an explicit RAM request.")
		// A VRAM formula computes gpuMemory at run time (in exec.tpl); leave the
		// static quota's gpuMemory unset in that case, exactly as ram/cpu do.
		if !is_undefined(st.gpuMemory) { quotaData.gpuMemory = st.gpuMemory }
	}
	// Scratch space stands on its own: it needs no cpu/ram companion, and a VRAM-style
	// formula leaves the static field unset for the pure template to compute.
	// Always sent, defaulting to 0. The backend reads three states here and all three
	// carry meaning: absent means "a block built before this contract, give it the
	// environment it was tested on", 0 means "current SDK, no device wanted, but I do
	// want a temporary directory", and a size means both. Leaving the field out when a
	// block asked for nothing would make every current block look like an old one.
	//
	// Costs no deduplication: quotaData rides metaExecInputs below, which is excluded
	// from the exec CID.
	//
	// Sent as a size STRING, never a bare number, whichever way the block spelled it: the
	// backend parses this field through UnmarshalText, so a JSON number does not merely
	// fail this exec - it fails to parse the quota and takes the runner controller down
	// with it. The 'b' suffix is the same spelling the formula fallback above uses.
	scratchRequest := is_undefined(st.scratchFreeSpace) ? 0 : st.scratchFreeSpace
	if is_int(scratchRequest) { scratchRequest = string(scratchRequest) + "b" }
	quotaData.scratchFreeSpace = scratchRequest
	metaExecInputs := {
		quota: smart.createJsonResource(quotaData)
	}
	// Resource-formula input placement (CID-transparent formula; see analysis doc §4):
	//   - Formula ASTs (__memFormula__/__cpuFormula__) are JSON VALUE resources —
	//     final on creation — so they ride the META rail (metaExecInputs, like
	//     `quota`): excluded from the exec CID, yet readable as final in the pure
	//     exec.tpl body. Changing only the formula does NOT change the CID, so two
	//     otherwise-identical execs dedup to one allocation (formula CID-transparency).
	//     On a backend without serviceFields support, render.lib attaches meta inputs
	//     as regular ones instead — the formula then enters the CID (no transparency)
	//     but still evaluates correctly. Graceful degradation; hasBlobSize stays the
	//     only gate (gating on serviceFields would instead disable formulas there).
	//   - The line-count map (__metric_lineCount__) holds COMPUTED per-file results.
	//     On a meta (service) field those are only "resolved", not final, and a pure
	//     template cannot awaitState — so the map MUST ride the REGULAR rail
	//     (pureExecInputs) to be deep-waited to final before the body reads it. This
	//     enters the CID, but the counts are file-derived (a deterministic function of
	//     the already-in-CID input files), so identical inputs still dedup.
	// Populated only on the canEvaluateFormulas path above.
	if !is_undefined(resolvedMem) { metaExecInputs[execConstants.META_INPUT_MEM_FORMULA] = smart.createJsonResource(resolvedMem) }
	if !is_undefined(resolvedCpu) { metaExecInputs[execConstants.META_INPUT_CPU_FORMULA] = smart.createJsonResource(resolvedCpu) }
	if !is_undefined(resolvedGpu) { metaExecInputs[execConstants.META_INPUT_GPU_FORMULA] = smart.createJsonResource(resolvedGpu) }
	if !is_undefined(resolvedScratch) { metaExecInputs[execConstants.META_INPUT_SCRATCH_FORMULA] = smart.createJsonResource(resolvedScratch) }
	if !is_undefined(lineCountMapResource) { pureExecInputs[execConstants.REGULAR_INPUT_LINE_COUNT] = lineCountMapResource }

	// We add monetization only if it's enabled
	// to not break a deduplication of exec's
	// that were created before this feature existed.
	if monetization.shouldRun(st.mnz) {
		pureExecInputs.runOptions.monetization = monetization.toJson(st.mnz)
	}

	// We add name only when it is explicitly set
	// to not break deduplication of exec's created before this feature existed.
	if st.commandName != "" {
		pureExecInputs.runOptions.name = st.commandName
	}

	// We add new argsTyped and envsTyped only when they were added
	// to not break a deduplication on old pl backend.
	if st.typedArgSet || st.typedEnvSet {
		pureExecInputs.runOptions.argsTyped = st.argsTyped
		pureExecInputs.runOptions.envsTyped = st.envsTyped
	}

	if !is_undefined(st.soft) {
		pureExecInputs.softwareInfo = st.soft.resource
		descriptor := ll.fromStrict(st.soft.descriptor)
		if tmpdirCompatNeeded {
			descriptor = tmpdirCompat.patchSoftwareDescriptor(descriptor, feats.isDockerAvailable)
		}
		pureExecInputs.runOptions.software = {
			name: st.soft.name,
			version: st.soft.version,
			descriptor: descriptor
		}
	}

	renderOpts := { metaInputs: metaExecInputs }
	if st.inputCache > 0 {
		renderOpts.inputCache = st.inputCache
	}

	return { inputs: pureExecInputs, meta: metaExecInputs, renderOpts: renderOpts }
}

_definedOnly := func(m) {
	res := {}
	for k, v in m {
		if !is_undefined(v) {
			res[k] = v
		}
	}
	return res
}

// A comparable form of a value that may hold references: references become their ids.
_comparable := undefined
_comparable = func(v) {
	if smart.isReference(v) {
		return "ref:" + ll.idToString(v.id)
	}
	if is_map(v) {
		res := {}
		for k, vv in v {
			res[k] = _comparable(vv)
		}
		return res
	}
	if is_array(v) {
		res := []
		for vv in v {
			res = append(res, _comparable(vv))
		}
		return res
	}
	return v
}

/**
 * What a builder hands out as results, the part every fallback handler must declare exactly as
 * the root does: saved files, contents, file sets, streams and workdir processors, after the
 * stdout/stderr shortcuts are applied.
 */
_outputShapeOf := func(st) {
	s := _cloneState(st)
	_finalizeOutputs(s)

	procs := {}
	for name, p in s.wdProcessors {
		procs[name] = canonical.encode(_comparable(p))
	}

	return {
		saveFile: maps.getKeys(s.filesToSave),
		saveFileContent: maps.getKeys(s.filesContentToSave),
		saveFileSet: s.fileSetsToSave,
		saveFileSetContent: s.fileSetsContentToSave,
		processWorkdir: procs,
		streamFile: maps.getKeys(s.filesToStream)
	}
}

/**
 * Lists how a handler's output shape differs from the root's, one string per difference.
 */
_shapeDiff := func(root, handler) {
	diffs := []
	for kind in ["saveFile", "saveFileContent", "streamFile"] {
		r := sets.fromSlice(root[kind])
		h := sets.fromSlice(handler[kind])
		missing := []
		extra := []
		for k in root[kind] {
			if !sets.hasElement(h, k) { missing = append(missing, k) }
		}
		for k in handler[kind] {
			if !sets.hasElement(r, k) { extra = append(extra, k) }
		}
		if len(missing) > 0 {
			diffs = append(diffs, fmt.sprintf("%s: missing %v", kind, missing))
		}
		if len(extra) > 0 {
			diffs = append(diffs, fmt.sprintf("%s: not in the root %v", kind, extra))
		}
	}
	for kind in ["saveFileSet", "saveFileSetContent", "processWorkdir"] {
		r := root[kind]
		h := handler[kind]
		for k in maps.getKeys(r) {
			if is_undefined(h[k]) {
				diffs = append(diffs, fmt.sprintf("%s: missing %q", kind, k))
			} else if h[k] != r[k] {
				diffs = append(diffs, fmt.sprintf("%s: %q differs from the root (%v, root: %v)", kind, k, h[k], r[k]))
			}
		}
		for k in maps.getKeys(h) {
			if is_undefined(r[k]) {
				diffs = append(diffs, fmt.sprintf("%s: %q is not in the root", kind, k))
			}
		}
	}
	return diffs
}

/**
 * Creates a new builder for constructing and executing commands.
 *
 * @return builder - a new builder instance.
 */
builder := undefined

_makeBuilder := func(st) {
	self := undefined

	assertEntrypointNotSet := func() {
		ll.assert(!st.entrypointSet,
			"either a command with arguments or a software were already set.")
	}

	self = ll.toStrict({
		/**
		 * Sets the command to be executed, e.g. /usr/bin/env or sh.
		 *
		 * @param commandName: string - the name of the command.
		 */
		cmd: func(commandName) {
			assertEntrypointNotSet()

			st.cmd = commandName
			st.entrypointSet = true
			return self
		},

		/**
		 * Sets the software to be executed.
		 *
		 * @param software: softwareInfo - the software to execute.
		 */
		software: func(sw) {
			assertEntrypointNotSet()
			ll.assert(assets.isSoftwareInfo(sw),
				"exec.builder.software: <software> parameter is not a software info. Provide the value obtained from assets."+"importSoftware() here" // calm-down tengo-builder
			)

			st.soft = sw
			st.entrypointSet = true
			return self
		},

		/**
		 * Adds an argument to the command.
		 *
		 * @param arg: string - the argument to add.
		 */
		arg: func(arg) {
			ll.assert(is_string(arg), "exec.arg(): argument must be a string, got: %v", arg)
			st.args = append(st.args, arg)
			st.argsTyped = append(st.argsTyped, {
				type: execConstants.ARG_TYPE_STRING,
				value: arg
			})
			return self
		},

		/**
		 * Adds an argument with expression evaluation.
		 *
		 * Expressions are evaluated using the expr-lang syntax (https://expr-lang.org/docs/language-definition).
		 * Available variables in expressions:
		 *
		 * - `system.cpu` - Number of CPU cores allocated
		 * - `system.ram.bytes`, `system.ram.b` - RAM in bytes
		 * - `system.ram.kb`, `system.ram.mb`, `system.ram.gb` - RAM in metric units (base-10)
		 * - `system.ram.kib`, `system.ram.mib`, `system.ram.gib` - RAM in binary units (base-2)
		 * - Custom substitution variables defined by substitution rules
		 *
		 * Expression examples:
		 * - `--memory={system.ram.mb * 80 / 100}` - Calculate 80% of available RAM in MB
		 * - `--threads={system.cpu}` - Use number of CPU cores
		 *
		 * @param arg: string - argument with expressions, e.g., "-Xms{system.ram.mb * 80 / 100}m"
		 */
		argExpr: func(arg) {
			ll.assert(is_string(arg), "exec.argExpr(): argument must be a string, got: %v", arg)
			st.argsTyped = append(st.argsTyped, {
				type: execConstants.ARG_TYPE_EXPRESSION,
				value: arg
			})
			st.typedArgSet = true

			return self
		},

		/**
		 * @deprecated: use argExpr() instead. This method will be removed after 15 Mar 2025.
		 * Adds an argument with expression evaluation.
		 *
		 * @param arg: string - argument with expressions, e.g., "-Xms{system.ram.mb * 80 / 100}m"
		 */
		argWithVar: func(arg) {
			return self.argExpr(arg)
		},

		/**
		 * Sets an environment variable.
		 *
		 * @param name: string - the name of the environment variable.
		 * @param value: string - the value of the environment variable.
		 */
		env: func(name, value) {
			validation.assertType([name, value], ["string"])
			st.envs[name] = value
			st.envsTyped[name] = {
				type: execConstants.ARG_TYPE_STRING,
				value: value
			}
			return self
		},

		/**
		 * Sets an environment variable with expression evaluation.
		 *
		 * Expressions are evaluated using the expr-lang syntax (https://expr-lang.org/docs/language-definition).
		 * Available variables in expressions:
		 *
		 * - `system.cpu` - Number of CPU cores allocated
		 * - `system.ram.bytes`, `system.ram.b` - RAM in bytes
		 * - `system.ram.kb`, `system.ram.mb`, `system.ram.gb` - RAM in metric units (base-10)
		 * - `system.ram.kib`, `system.ram.mib`, `system.ram.gib` - RAM in binary units (base-2)
		 * - Custom substitution variables defined by substitution rules
		 *
		 * Expression examples:
		 * - `{system.ram.mb * 80 / 100}` - Calculate 80% of available RAM in MB
		 * - `{system.cpu}` - Use number of CPU cores
		 *
		 * @param name: string - the name of the environment variable.
		 * @param value: string - the value with expressions, e.g., "-Xms{system.ram.mb * 80 / 100}m"
		 */
		envExpr: func(name, value) {
			validation.assertType([name, value], ["string"])
			st.envsTyped[name] = {
				type: execConstants.ARG_TYPE_EXPRESSION,
				value: value
			}
			st.typedEnvSet = true

			return self
		},

		/**
		 * @deprecated: use envExpr() instead. This method will be removed after 15 Mar 2025.
		 * Sets an environment variable with expression evaluation.
		 *
		 * @param name: string - the name of the environment variable.
		 * @param value: string - the value with expressions, e.g., "-Xms{system.ram.mb * 80 / 100}m"
		 */
		envWithVar: func(name, value) {
			return self.envExpr(name, value)
		},

		/**
		 * Sets multiple environment variables.
		 *
		 * @param envMap: map[string]string - a map of environment variables.
		 */
		envMap: func(envMap) {
			enum.each(envMap, self.env)
			return self
		},

		/**
		 * Provide secret to command runtime.
		 *
		 * Secrets contain sensitive information that should be available for software,
		 * but should not be exposed to outer observers. License keys, passwords, API keys are examples
		 * of such information.
		 *
		 * On Platforma Backend side, secrets feature uses native instruments of particular
		 * infrastructure designed for that purpose (i.e. Kubertenes secrets). The secret is usually stored
		 * somewhere _outside_ Platforma Backend, but Platforma Backend knows how to start the software
		 * and provide access to this secret for one particular run.
		 *
		 * Value of a secret can be exposed to the process only via environment variable, because other
		 * mechanisms easly 'leak' secret's value to logs, processes list or other places, that is easy
		 * to access with little permissions.
		 *
		 * When you use .secret("SECRET_NAME"), Platforma Backend knows that this particular software
		 * needs a value of secret with name "SECRET_NAME" to be available at runtime in environment variable
		 * with the same name. You can customize env variable name by setting 2nd argument to the .secret() method.
		 *
		 * For example, MiXCR software expects license to be available in MI_LICENSE environment variable.
		 * to run MiXCR in workflow, you can use .secret("mixcr-license", "MI_LICENSE").
		 * to make Platforma Backend provide MiXCR with license code stored in secret 'mixcr-license'.
		 * This will require infrastructure, that runs Platforma Backend, to have this 'mixcr-license' secret
		 * on their side.
		 * Usually, secrets are named after environment variables software expects.
		 *
		 * Here are few recommendations on how to work with secrets:
		 *  - tend to use the environment variable name as a name of a secret for simplicity of understanding.
		 *  - when declaring a secret in your block workflow, use the same secret name for the same software.
		 *    Even in different blocks. I.e. use 'MI_LICENSE' in all MiXCR software runs in all blocks.
		 *  - once secret is added and block is released, do not change name of a secret in a block from version to version.
		 *    Changing the secret name requires all our clients creating a secret with new name to make new version of a block working.
		 *  - never use the same secret name for different software unless you know for sure they accept/expect the same secret value.
		 *
		 * Examples of secret names:
		 *  - BAD: "password", "api-key", "secret", "key" - too general. Will overlap in different blocks for different software,
		 *    making it impossible to use these blocks simultaneously in the same Platforma Backend instance.
		 *  - GOOD: "MI_LICENSE" - has 'MI_' prefix, stating this is for MiXCR software (or for MiLaboratories software in general)
		 *
		 * @param secretName: string - name of secret to pass as environment variable.
		 * @param [envName]: string - name of environment variable to set with value of secret.
		 *                            Defaults to name of a secret.
		 */
		secret: func(secretName, ...opts) {
			validation.assertType(secretName, "string")
			validation.assert(secretName != "", "exec.secret(): secret name cannot be empty")

			envName := secretName
			if len(opts) > 0 {
				envName = opts[0]
				validation.assertType(envName, "string")
				validation.assert(envName != "", "exec.secret(): environment name for secret cannot be empty")
			}

			st.secrets[envName] = secretName
			return self
		},

		/**
		 * Sets the queue to execute the command in.
		 *
		 * In local execution mode, the platform distributes available host RAM among four predefined queues:
		 * 'heavy', 'medium', 'light', and 'ui-tasks'. This allows managing resource consumption for concurrent tasks.
		 * The RAM allocation is dynamic and depends on the total system memory, with different allocation strategies
		 * for different hardware configurations.
		 *
		 * Each queue has a memory limit, which represents the absolute maximum memory a queue can use.
		 *
		 * Here are a couple of examples of how memory is distributed:
		 *
		 * **For a system with 32GiB of available RAM:**
		 * - `ui-tasks`:      Memory Limit ~9.9GiB
		 * - `light`:         Memory Limit ~10.5GiB
		 * - `medium`:        Memory Limit ~12.7GiB
		 * - `heavy`:         Memory Limit ~23.5GiB
		 *
		 * **For a system with 64GiB of available RAM:**
		 * - `ui-tasks`:      Memory Limit ~12.6GiB
		 * - `light`:         Memory Limit ~16.0GiB
		 * - `medium`:        Memory Limit ~21.4GiB
		 * - `heavy`:         Memory Limit ~39.1GiB
		 *
		 * **For a system with 256GiB of available RAM:**
		 * - `ui-tasks`:      Memory Limit ~36.2GiB
		 * - `light`:         Memory Limit ~51.0GiB
		 * - `medium`:        Memory Limit ~72.8GiB
		 * - `heavy`:         Memory Limit ~156.0GiB
		 *
		 * If a task is submitted without specifying memory requirements, it receives a default amount of RAM based on its queue:
		 * - `heavy`: 32GiB
		 * - `medium`: 1GiB
		 * - `light`: 512MiB
		 * - `ui-tasks`: 100MiB
		 *
		 * **Important Note:** The queue behavior and memory limits described above apply specifically to **local execution**.
		 * When using a batch executor (such as Slurm, Google Cloud Batch, or AWS Batch), the interpretation of queue names
		 * and the enforcement of memory limits are determined by the configuration of the specific execution backend.
		 * Furthermore, if you request more memory than a queue can provide, your request will be capped at the queue's limit.
		 * For example, requesting 100GiB in `ui-tasks` on a 32GiB system will result in an allocation of ~9.9GiB.
		 *
		 * Available queues are:
		 * - execConstants.HEAVY_QUEUE ('heavy') - default
		 * - execConstants.MEDIUM_QUEUE ('medium')
		 * - execConstants.LIGHT_QUEUE ('light')
		 * - execConstants.UI_TASKS_QUEUE ('ui-tasks')
		 *
		 * @param newQueue: string - the name of the queue.
		 */
		setQueue: func(newQueue) {
			st.queue = newQueue
			return self
		},

		/**
		 * Execute command in the 'heavy' queue.
		 */
		inHeavyQueue: func() {
			st.queue = execConstants.HEAVY_QUEUE
			return self
		},

		/**
		 * Execute command in the 'medium' queue.
		 */
		inMediumQueue: func() {
			st.queue = execConstants.MEDIUM_QUEUE
			return self
		},

		/**
		 * Execute command in the 'light' queue.
		 */
		inLightQueue: func() {
			st.queue = execConstants.LIGHT_QUEUE
			return self
		},

		/**
		 * Execute command in the 'ui-tasks' queue.
		 */
		inUiQueue: func() {
			st.queue = execConstants.UI_TASKS_QUEUE
			return self
		},

		/**
		 * Sets the number of CPUs to request from the underlying executor (i.e. Google/AWS Batch, PBS, Slurm, etc.).
		 *
		 * @param amount: number - number of cores requested for command.
		 */
		cpu: func(amount) {
			_assertValidCpuRequest(amount, "exec.builder.cpu")
			st.cpuRequest = amount

			return self
		},

		/**
		 * Sets the amount of RAM to request from the underlying executor (i.e. Google/AWS Batch, PBS, Slurm, etc.).
		 *
		 * @param amount: number | string - amount of RAM in bytes or string with size suffix (case-insensitive):
		 *                                     K,  KB,  M,  MB,  G,  GB for base-10 sizes (x1000)
		 *                                    Ki, KiB, Mi, MiB, Gi, GiB for base-2 sizes (x1024)
		 *                                  when operating with bytes, you may use 'units' package for convenience:
		 *                                    120 * units.GiB
		 *
		 * @return builder
		 */
		mem: func(amount) {
			_assertValidMemRequest(amount, "exec.builder.mem")
			st.ramRequest = amount

			return self
		},

		/**
		 * @deprecated: use mem() instead.
		 * Deprecated: use mem() instead.
		 *
		 * @return builder
		 */
		ram: func(amount) {
			self.mem(amount)
			return self
		},

		/**
		 * Declares the exec's compute resources in one call. This is the primary
		 * way to request RAM / CPU / GPU — replacing the older per-dimension
		 * formula setters.
		 *
		 * Each dimension takes EITHER a static value or a data-driven FORMULA:
		 *   - static: a number (cores, or bytes for ram/vram) or a size string
		 *     ("16GiB"). Enters the exec as-is.
		 *   - formula: an `exec.formula` chain — e.g.
		 *       f.size("input").dividedBy(f.gib(4)).between(4, 16).staticFallback(16)
		 *     Evaluated at run time from input-file metrics (size / line count).
		 *     A formula SHOULD end in .staticFallback(...) — the value used on
		 *     backends that cannot evaluate formulas (no getBlobSize); without it
		 *     such a backend errors. A formula must evaluate to a positive integer;
		 *     floor it with .between(...) / .atLeast(...) if a metric can be zero.
		 *
		 * Shapes (config map). Two parallel blocks, onCPU and onGPU, describe the
		 * CPU-node and GPU-node allocations; which are present decides the mode:
		 *   // CPU only (the common case) — onCPU alone
		 *   .resources({ queue: "heavy", onCPU: { cpu: <cpu>, ram: <ram> } })
		 *
		 *   // GPU required — onGPU alone; runs only on a GPU node (errors fast if
		 *   // the backend has none)
		 *   .resources({ queue: "heavy", onGPU: { cpu: <cpu>, ram: <ram>, vram: <vram> } })
		 *
		 *   // GPU preferred — both blocks; adaptive: the onGPU allocation is used
		 *   // when the backend has a GPU (exec.hasGpu, decided here at workflow render time),
		 *   // else the onCPU allocation.
		 *   .resources({
		 *       queue: "heavy",
		 *       onCPU: { cpu: <cpu>, ram: <ram> },
		 *       onGPU: { cpu: <cpu>, ram: <ram>, vram: <vram> }
		 *   })
		 *
		 * onCPU takes { cpu, ram }; onGPU takes { cpu, ram, vram } (vram is what
		 * makes it a GPU allocation, so it is required there).
		 *
		 * Both blocks also accept an optional `scratchFreeSpace`: disposable disk space for
		 * the command's temporary data, which TMPDIR then points at. Ask for it when a command
		 * writes large intermediate files — sorting, indexing, alignment — instead of leaving
		 * it to whatever small temporary directory the runner provides by default:
		 *
		 *   .resources({
		 *       queue: "heavy",
		 *       onCPU: { cpu: 8, ram: "32GiB", scratchFreeSpace: "500GiB" }
		 *   })
		 *
		 * The size may be a formula, like the other dimensions. A deployment that cannot serve
		 * the request caps it, and one that has no scratch storage at all ignores it: the
		 * command still runs, with the temporary storage it would have had anyway. That makes
		 * scratch space an optimisation to ask for freely, never a precondition — which is why
		 * a scratch formula with no .staticFallback() drops the request instead of failing the
		 * exec, where a ram or cpu formula would error.
		 *
		 * A .staticFallback() on a scratch formula is inert: it is consulted only by backends
		 * that cannot evaluate formulas, and those predate scratch control, so they ignore the
		 * request whatever size it carries. Harmless to write, pointless to add.
		 *
		 * NOTE: resource formulas are CID-transparent — they do NOT participate in
		 * exec deduplication. Two execs identical except for their formula dedup to
		 * one run (and one allocation); vary a real input (an arg or file) if you
		 * need them to allocate separately. (Transparency requires backend
		 * serviceFields support; on a backend without it the formula instead
		 * enters the exec CID — evaluation is still correct, only dedup is lost.)
		 *
		 * @param spec: {
		 *     queue?: string,
		 *     onCPU?: { cpu, ram: <static | formula> },
		 *     onGPU?: { cpu, ram, vram: <static | formula> }
		 *   }
		 * @return builder
		 */
		resources: func(spec) {
			ll.assert(ll.isMap(spec), "exec.builder.resources: expected a config map")
			allowed := { queue: true, onCPU: true, onGPU: true }
			for k, _ in spec {
				ll.assert(!is_undefined(allowed[k]), "exec.builder.resources: unknown key %q (allowed: queue, onCPU, onGPU)", k)
			}
			hasCPU := !is_undefined(spec.onCPU)
			hasGPU := !is_undefined(spec.onGPU)
			ll.assert(hasCPU || hasGPU, "exec.builder.resources: provide onCPU and/or onGPU")

			if !is_undefined(spec.queue) {
				validation.assertType(spec.queue, "string", "exec.builder.resources: queue must be a string")
				st.queue = spec.queue
			}

			// Per-dimension setters: a formula (exec.formula chain / AST) sets the
			// *FormulaAst + its .staticFallback(); a bare number/string is a static
			// request. Closure-assign the builder's resource state directly.
			// Each setter is authoritative for its dimension: a formula clears any
			// static request left from a prior .cpu()/.mem()/.gpuMemory() (or an earlier
			// .resources()), and a static value clears any prior formula AST + fallback.
			// Without this, a reused/reconfigured builder could keep stale state and let
			// a leftover formula override a later static value (or vice versa) at finalize.
			setCpu := func(v, ctx) {
				if execFormula.isFormula(v) {
					st.cpuFormulaAst = execFormula.astOf(v)
					st.cpuFormulaFallback = undefined
					fb := execFormula.fallbackOf(v)
					if !is_undefined(fb) { _assertValidCpuRequest(fb, ctx + " cpu fallback"); st.cpuFormulaFallback = fb }
					st.cpuRequest = undefined
				} else {
					_assertValidCpuRequest(v, ctx + " cpu")
					st.cpuRequest = v
					st.cpuFormulaAst = undefined
					st.cpuFormulaFallback = undefined
				}
			}
			setRam := func(v, ctx) {
				if execFormula.isFormula(v) {
					st.memFormulaAst = execFormula.astOf(v)
					st.memFormulaFallback = undefined
					fb := execFormula.fallbackOf(v)
					if !is_undefined(fb) { _assertValidMemRequest(fb, ctx + " ram fallback"); st.memFormulaFallback = fb }
					st.ramRequest = undefined
				} else {
					_assertValidMemRequest(v, ctx + " ram")
					st.ramRequest = v
					st.memFormulaAst = undefined
					st.memFormulaFallback = undefined
				}
			}
			setScratch := func(v, ctx) {
				if execFormula.isFormula(v) {
					st.scratchFormulaAst = execFormula.astOf(v)
					st.scratchFormulaFallback = undefined
					fb := execFormula.fallbackOf(v)
					if !is_undefined(fb) { _assertValidScratchRequest(fb, ctx + " scratchFreeSpace fallback"); st.scratchFormulaFallback = fb }
					st.scratchFreeSpace = undefined
				} else {
					_assertValidScratchRequest(v, ctx + " scratchFreeSpace")
					st.scratchFreeSpace = v
					st.scratchFormulaAst = undefined
					st.scratchFormulaFallback = undefined
				}
			}
			setVram := func(v, ctx) {
				if execFormula.isFormula(v) {
					st.gpuFormulaAst = execFormula.astOf(v)
					st.gpuFormulaFallback = undefined
					fb := execFormula.fallbackOf(v)
					if !is_undefined(fb) { _assertValidGpuRequest(fb, ctx + " vram fallback"); st.gpuFormulaFallback = fb }
					st.gpuMemory = undefined
				} else {
					_assertValidGpuRequest(v, ctx + " vram")
					st.gpuMemory = v
					st.gpuFormulaAst = undefined
					st.gpuFormulaFallback = undefined
				}
			}

			assertKeys := func(block, name, allowVram) {
				ll.assert(ll.isMap(block), "exec.builder.resources.%s: expected a map", name)
				for k, _ in block {
					ok := k == "cpu" || k == "ram" || k == "scratchFreeSpace" || (allowVram && k == "vram")
					ll.assert(ok, "exec.builder.resources.%s: unknown key %q (allowed: %s)", name, k, allowVram ? "cpu, ram, vram, scratchFreeSpace" : "cpu, ram, scratchFreeSpace")
				}
				ll.assert(!is_undefined(block.cpu) && !is_undefined(block.ram),
					"exec.builder.resources.%s: cpu and ram are required", name)
				if allowVram {
					ll.assert(!is_undefined(block.vram),
						"exec.builder.resources.%s: vram is required (it is what makes this a GPU allocation)", name)
				}
			}

			if hasCPU { assertKeys(spec.onCPU, "onCPU", false) }
			if hasGPU { assertKeys(spec.onGPU, "onGPU", true) }

			// Mode from which blocks are present:
			//   onGPU alone            -> GPU required (fail fast if no GPU support)
			//   onCPU + onGPU          -> adaptive: onGPU when the backend has a GPU, else onCPU
			//   onCPU alone            -> CPU only
			// The GPU-vs-CPU choice is resolved HERE, at workflow render time, via
			// exec.hasGpu — no backend-side plan selection is involved.
			useGPU := hasGPU && (!hasCPU || feats.hasGpu)
			if hasGPU && !hasCPU {
				ll.assert(feats.hasGpu,
					"exec.builder.resources: onGPU was set without onCPU (GPU required), but this backend has no GPU support (exec.hasGpu is false). Add an onCPU block for an adaptive CPU fallback, or run on a GPU-enabled backend.")
			}

			// Scratch space is optional in both blocks. Whichever block loses must not leave its
			// value behind, and a spec that asks for no scratch at all must clear whatever an
			// earlier .resources() call set — same discipline as the GPU state below.
			setScratchFrom := func(block, ctx) {
				if is_undefined(block.scratchFreeSpace) {
					st.scratchFreeSpace = undefined
					st.scratchFormulaAst = undefined
					st.scratchFormulaFallback = undefined
					return
				}
				setScratch(block.scratchFreeSpace, ctx)
			}

			if useGPU {
				g := spec.onGPU
				setCpu(g.cpu, "resources.onGPU")
				setRam(g.ram, "resources.onGPU")
				setVram(g.vram, "resources.onGPU")
				setScratchFrom(g, "resources.onGPU")
			} else {
				c := spec.onCPU
				setCpu(c.cpu, "resources.onCPU")
				setRam(c.ram, "resources.onCPU")
				setScratchFrom(c, "resources.onCPU")
				// CPU-only mode: clear any GPU/VRAM state left from a prior .gpuMemory()
				// or an earlier GPU-shaped .resources() so this spec doesn't leak a GPU request.
				st.gpuMemory = undefined
				st.gpuFormulaAst = undefined
				st.gpuFormulaFallback = undefined
			}
			return self
		},

		/**
		 * Requests GPU resources from the underlying executor.
		 *
		 * Prefer .resources({ onGPU: { ... } }) for new code; this static setter
		 * remains for direct/UI-driven VRAM requests.
		 *
		 * @param args: ...string - optional minimum VRAM size string (e.g. "16GiB").
		 *              No args means any GPU with default 1GiB minimum VRAM.
		 *
		 * @return builder
		 */
		gpuMemory: func(...args) {
			ll.assert(len(args) <= 1, "exec.builder.gpuMemory: accepts 0 or 1 argument")
			if len(args) == 0 {
				st.gpuMemory = "1GiB"
			} else {
				validation.assertType(args[0], "string", "exec.builder.gpuMemory: argument must be a size string like '16GiB'")
				st.gpuMemory = args[0]
			}
			return self
		},

		/**
		 * Use cacheMillis, cacheSeconds, cacheMinutes, cacheHours and cacheDays to not make hidden mistakes in cache time ranges.
		 * Sets the cache time.
		 *
		 * @param time: duration - the cache time from 'times' library.
		 */
		cache: func(time) {
			ll.assert(
				is_int(time),
				"cache time must be an integer. " +
					"Did you forget to import a standard tengo library 'times'?")
			st.cache = time
			return self
		},

		/**
		 * Sets the cache time in milliseconds.
		 *
		 * @param millis: number
		 */
		cacheMillis: func(millis) {
			ll.assert(is_int(millis) && millis > 0, "cache time must be a number of milliseconds")
			st.cache = millis * times.millisecond
			return self
		},

		/**
		 * Sets the cache time in seconds.
		 *
		 * @param seconds: number
		 */
		cacheSeconds: func(seconds) {
			ll.assert(is_int(seconds) && seconds > 0, "cache time must be a number of seconds")
			st.cache = seconds * times.second
			return self
		},

		/**
		 * Sets the cache time in minutes.
		 *
		 * @param minutes: number
		 */
		cacheMinutes: func(minutes) {
			ll.assert(is_int(minutes) && minutes > 0, "cache time must be a number of minutes")
			st.cache = minutes * times.minute
			return self
		},

		/**
		 * Sets the cache time in hours.
		 *
		 * @param hours: number
		 */
		cacheHours: func(hours) {
			ll.assert(is_int(hours) && hours > 0, "cache time must be a number of hours")
			st.cache = hours * times.hour
			return self
		},

		/**
		 * Sets the cache time in days
		 *
		 * @param days: number
		 */
		cacheDays: func(days) {
			ll.assert(is_int(days) && days > 0, "cache time must be a number of days")
			st.cache = days * times.hour * 24
			return self
		},

		/**
		 * Sets the cache duration for the execution's inputs.
		 *
		 * This is useful for an execution that is part of a sequence that might be re-rendered soon.
		 * Caching allows the inputs to be reused by the recovery mechanism, avoiding the need to
		 * recalculate them. A duration of one minute is recommended.
		 *
		 * @param time: duration - the cache time from 'times' library.
		 */
		cacheInputs: func(time) {
			ll.assert(
				is_int(time),
				"input cache time must be an integer. " +
					"Did you forget to import a standard tengo library 'times'?")
			st.inputCache = time
			return self
		},

		/**
		 * Sets the input cache time in milliseconds.
		 *
		 * @param millis: number
		 */
		cacheInputsMillis: func(millis) {
			ll.assert(is_int(millis) && millis > 0, "input cache time must be a number of milliseconds")
			st.inputCache = millis * times.millisecond
			return self
		},

		/**
		 * Sets the input cache time in seconds.
		 *
		 * @param seconds: number
		 */
		cacheInputsSeconds: func(seconds) {
			ll.assert(is_int(seconds) && seconds > 0, "input cache time must be a number of seconds")
			st.inputCache = seconds * times.second
			return self
		},

		/**
		 * Sets the input cache time in minutes.
		 *
		 * @param minutes: number
		 */
		cacheInputsMinutes: func(minutes) {
			ll.assert(is_int(minutes) && minutes > 0, "input cache time must be a number of minutes")
			st.inputCache = minutes * times.minute
			return self
		},

		/**
		 * Sets the input cache time in hours.
		 *
		 * @param hours: number
		 */
		cacheInputsHours: func(hours) {
			ll.assert(is_int(hours) && hours > 0, "input cache time must be a number of hours")
			st.inputCache = hours * times.hour
			return self
		},

		/**
		 * Sets the input cache time in days
		 *
		 * @param days: number
		 */
		cacheInputsDays: func(days) {
			ll.assert(is_int(days) && days > 0, "input cache time must be a number of days")
			st.inputCache = days * times.hour * 24
			return self
		},

		/**
		 * Sets a human-readable name for this command.
		 * Shown in error messages when the command fails.
		 *
		 * @param name: string - the command name.
		 */
		name: func(name) {
			validation.assertType(name, "string", "exec.builder.name: name must be a string")

			st.commandName = name
			return self
		},

		/**
		 * Sets the number of error lines to be captured.
		 *
		 * @param lines: number - the number of error lines.
		 */
		nErrorLines: func(lines) {
			ll.assert(
				is_int(lines) && lines >= 0,
				"lines must be integer")

			st.nErrorLines = lines
			return self
		},

		/**
		 * Adds files from given asset into working directory.
		 *
		 * @param asset: assetInfo - asset info loaded from assets.importAsset()
		 * @param destinationDir: string - path inside working directory for files to be extracted from archive. Use "." for root of the workdir.
		 * @param pathsInArchive: string[] - paths inside the archive to be extracted into destinationDir.
		 *                                   Empty array means 'unpack full archive'.
		 */
		addAsset: func(asset, destinationDir, ...pathsInArchive) {
			if (len(pathsInArchive) == 1 && is_array(pathsInArchive[0])) {
				// support [<paths>] single argument
				pathsInArchive = pathsInArchive[0]
			}
			if len(pathsInArchive) == 0 {
				// default for 'no paths' is to extract all
				pathsInArchive = []
			}

			ll.assert(assets.isAssetInfo(asset),
				"exec.builder.addAsset: <asset> parameter is not an asset info. Provide the value obtained from assets."+"importAsset() here") // calm-down tengo-builder
			validation.assertType(destinationDir, "string", "exec.builder.addAsset: <destinationDir> is not a string. It must be a path inside working directory")
			validation.assertType(pathsInArchive, ["string"], "exec.builder.addAsset: <pathsInArchive> must contain list of strings with paths inside archive")

			assetIdKey := ll.idToString(asset._id)
			if is_undefined(st.assetRules[assetIdKey]) {
				st.assetInfos[assetIdKey] = asset.resource
				st.assetDescriptors[assetIdKey] = ll.fromStrict(asset.descriptor)
				st.assetRules[assetIdKey] = {}
			}

			if len(pathsInArchive) == 0 || is_undefined(st.assetRules[assetIdKey][destinationDir]) {
				st.assetRules[assetIdKey][destinationDir] = []
			}

			if (len(pathsInArchive) > 0) {
				st.assetRules[assetIdKey][destinationDir] = append(st.assetRules[assetIdKey][destinationDir], pathsInArchive...)
			}

			return self
		},

		/**
		 * Set custom cache time for given asset. By default, cache time of 1 day is applied to all assets.
		 * This allows to customize cache time on per-asset basis
		 */
		cacheAssetMillis: func (asset, millis) {
			ll.assert(assets.isAssetInfo(asset),
				"exec.builder.cacheAssetMillis: <asset> parameter is not an asset info. Provide the value obtained from assets."+"importAsset() here") // calm-down tengo-builder
			ll.assert(is_int(millis),
				"exec.builder.cacheAssetMillis: asset cache time must be a number of milliseconds.")

			assetIdKey := ll.idToString(asset._id)
			st.assetCache[assetIdKey] = millis * times.millisecond

			return self
		},

		/**
		 * Set custom cache time for given asset. By default, cache time of 1 day is applied to all assets.
		 * This allows to customize cache time on per-asset basis
		 */
		cacheAssetSeconds: func (asset, seconds) {
			ll.assert(assets.isAssetInfo(asset),
				"exec.builder.cacheAssetSeconds: <asset> parameter is not an asset info. Provide the value obtained from assets."+"importAsset() here") // calm-down tengo-builder
			ll.assert(is_int(seconds),
				"exec.builder.cacheAssetSeconds: asset cache time must be a number of seconds.")

			assetIdKey := ll.idToString(asset._id)
			st.assetCache[assetIdKey] = seconds * times.second

			return self
		},

		/**
		 * Set custom cache time for given asset. By default, cache time of 1 day is applied to all assets.
		 * This allows to customize cache time on per-asset basis
		 */
		cacheAssetMinutes: func (asset, minutes) {
			ll.assert(assets.isAssetInfo(asset),
				"exec.builder.cacheAssetMinutes: <asset> parameter is not an asset info. Provide the value obtained from assets."+"importAsset() here")
			ll.assert(is_int(minutes),
				"exec.builder.cacheAssetMinutes: asset cache time must be a number of minutes.")

			assetIdKey := ll.idToString(asset._id)
			st.assetCache[assetIdKey] = minutes * times.minute

			return self
		},

		/**
		 * Set custom cache time for given asset. By default, cache time of 1 day is applied to all assets.
		 * This allows to customize cache time on per-asset basis
		 */
		cacheAssetHours: func (asset, hours) {
			ll.assert(assets.isAssetInfo(asset),
				"exec.builder.cacheAssetHours: <asset> parameter is not an asset info. Provide the value obtained from assets."+"importAsset() here") // calm-down tengo-builder
			ll.assert(is_int(hours),
				"exec.builder.cacheAssetHours: asset cache time must be a number of hours.")

			assetIdKey := ll.idToString(asset._id)
			st.assetCache[assetIdKey] = hours * times.hour

			return self
		},

		/**
		 * Set custom cache time for given asset. By default, cache time of 1 day is applied to all assets.
		 * This allows to customize cache time on per-asset basis
		 */
		cacheAssetDays: func (asset, days) {
			ll.assert(assets.isAssetInfo(asset),
				"exec.builder.cacheAssetDays: <asset> parameter is not an asset info. Provide the value obtained from assets."+"importAsset() here") // calm-down tengo-builder
			ll.assert(is_int(days),
				"exec.builder.cacheAssetDays: asset cache time must be a number of days.")

			assetIdKey := ll.idToString(asset._id)
			st.assetCache[assetIdKey] = days * 24 * times.hour

			return self
		},

		enableMnz: func(productKey) {
			monetization.enable(st.mnz, productKey)
			// exec supports only 1 run.
			monetization.appendRun(st.mnz)

			return self
		},

		setMnzUrl: func(url) {
			monetization.setUrl(st.mnz, url)
			return self
		},

		/**
		 * Adds a file to the working directory.
		 * When called with the same fileName multiple times,
		 * the last call will overwrite the previous ones.
		 *
		 * The file defaults to read-only (0o400) in the workdir so the backend
		 * hardlinks it from the content-addressable archive cache. Pass
		 * `{ writable: true }` when the tool legitimately needs to mutate the
		 * input in place — the backend will copy it to a fresh inode.
		 *
		 * @param fileName: string - the name of the input file.
		 * @param file: reference - a resource id of the file or a field that points to it.
		 * @param opts: { writable?: bool, mnz?: ... } - optional flags.
		 *        `writable: true` lands the file as 0o600 in the workdir.
		 */
		addFile: func(fileName, file, ...opts) {
			ll.assert(is_string(fileName), "exec.builder().addFile: fileName must be a string")
			ll.assert(smart.isReference(file), "exec.builder().addFile: file must be a reference")

			fileName = path.canonize(fileName)
			st.filesToAdd[fileName] = file
			if len(opts) > 0 && ll.isMap(opts[0]) {
				if opts[0].writable == true {
					sets.add(st.writableFiles, fileName)
				}
				if !is_undefined(opts[0].tag) {
					ll.assert(is_string(opts[0].tag), "exec.builder().addFile: tag must be a string")
					st.fileTags[fileName] = opts[0].tag
				}
			}
			monetization.addOptionalArg(st.mnz, fileName, opts...)
			return self
		},

		/**
		 * Adds multiple files to the working directory.
		 *
		 * @param filesMap: map[string]reference - a map of file names to files' references.
		 * @param opts: { writable?: bool, mnz?: ... } - applied to every entry.
		 */
		addFiles: func(filesMap, ...opts) {
			ll.assert(ll.isMap(filesMap), "exec.builder().addFiles: filesMap must be map of file names to file resources")
			maps.forEach(filesMap, func(fileName, file) {
				self.addFile(fileName, file, opts...)
			})
			return self
		},

		/**
		 * Writes a file with a given content.
		 * When called with the same fileName multiple times,
		 * the last call will overwrite the previous ones.
		 *
		 * Maps and arrays are serialized via `canonical.encode` (sorted keys at
		 * every level) so the resulting bytes — and therefore the exec step's
		 * dedup CID — are stable across runs. Callers that previously did
		 * `writeFile(name, json.encode(value))` should pass `value` directly.
		 *
		 * The file defaults to read-only (0o400) in the workdir. Pass
		 * `{ writable: true }` when the tool needs to mutate the file in place
		 * — the backend will land it as 0o600 and copy from the value cache to
		 * a fresh inode.
		 *
		 * @param fileName: string - the name of the content.
		 * @param data: string|bytes|map|array|reference - the content to write.
		 *        Maps and arrays are canonicalized to JSON; strings / bytes /
		 *        references are passed through unchanged.
		 * @param opts: { writable?: bool, mnz?: ... } - optional flags.
		 *        `writable: true` lands the file as 0o600 in the workdir.
		 */
		writeFile: func(fileName, data, ...opts) {
			// Auto-encode value-like inputs (regular / immutable / strict maps
			// and arrays) into canonical JSON. Explicitly exclude smart
			// references — they're implemented as strict maps and would
			// otherwise be stringified, breaking downstream resource handling.
			if (ll.isMap(data) || is_array(data)) && !smart.isReference(data) {
				data = canonical.encode(data)
			}
			validation.assertType(data, ["or",
				"string",
				"bytes",
				validation.reference])

			fileName = path.canonize(fileName)

			st.filesToWrite[fileName] = data
			if len(opts) > 0 && ll.isMap(opts[0]) && opts[0].writable == true {
				sets.add(st.writableFiles, fileName)
			}
			monetization.addOptionalArg(st.mnz, fileName, opts...)

			return self
		},

		/**
		 * Writes multiple files with their contents to the working directory.
		 * Each entry follows the same encoding rules as `writeFile` — maps and
		 * arrays are canonical-encoded, references and strings/bytes pass
		 * through unchanged.
		 *
		 * @param filesMap: map[string]string|bytes|map|array|reference -
		 *        a map of file names to contents.
		 * @param opts: { writable?: bool, mnz?: ... } - applied to every entry.
		 */
		writeFiles: func(filesMap, ...opts) {
			ll.assert(ll.isMap(filesMap), "exec.builder().writeFiles: filesMap must be map of file names to contents")
			maps.forEach(filesMap, func(fileName, data) {
				self.writeFile(fileName, data, opts...)
			})
			return self
		},

		/**
		 * Creates a directory.
		 *
		 * @param dir: string - the directory to create.
		 */
		mkDir: func(dir) {
			dir = path.canonize(dir)
			st.dirsToCreate = sets.add(st.dirsToCreate, dir)
			return self
		},

		/**
		 * Saves a file.
		 *
		 * @param fileName: string - the name of the output file.
		 */
		saveFile: func(fileName) {
			fileName = path.canonize(fileName)
			sets.add(st.filesToSave, fileName)
			return self
		},

		/**
		 * Saves a file's content to a value resource.
		 *
		 * @param fileName: string - the name of the output value.
		 */
		saveFileContent: func(fileName) {
			fileName = path.canonize(fileName)
			sets.add(st.filesContentToSave, fileName)
			return self
		},

		/**
		 * Saves files from the exec workdir using regex.
		 *
		 * @param name: string - a name to refer this file set in the outputs
		 * @param regex: string - regex pattern
		 */
		saveFileSet: func(name, regex) {
			st.fileSetsToSave[name] = regex
			return self
		},

		/**
		 * Run specified
		 */
		processWorkdir: func(name, tpl, tplArgs) {
			st.wdProcessors[name] = {
				tpl: tpl,
				tplArgs: tplArgs
			}
			return self
		},

		/**
		 * Saves files content from the exec workdir using regex.
		 *
		 * @param name: string - a name to refer this file set in the outputs
		 * @param regex: string - regex pattern
		 */
		saveFileSetContent: func(name, regex) {
			st.fileSetsContentToSave[name] = regex
			return self
		},

		/**
		 * A command to stream a file by a given file name.
		 *
		 * @param fileName: string - the name of the file to stream.
		 */
		streamFile: func(fileName) {
			fileName = path.canonize(fileName)
			sets.add(st.filesToStream, fileName)

			return self
		},

		/**
		 * Set stdout file name
		 */
		stdoutFileName: func(fileName) {
			fileName = path.canonize(fileName)
			st.stdout = fileName
			return self
		},

		/**
		 * Set stderr file name
		 */
		stderrFileName: func(fileName) {
			fileName = path.canonize(fileName)
			st.stderr = fileName
			return self
		},

		/**
		 * Sets stdout to be captured as a value resource.
		 */
		saveStdoutContent: func() {
			st.stdoutContent = true
			return self
		},

		/**
		 * Sets stderr to be captured as a value resource.
		 */
		saveStderrContent: func() {
			st.stderrContent = true
			return self
		},

		/**
		 * Redirects stderr output to stdout.
		 */
		printErrStreamToStdout: func() {
			st.stderrToStdout = true
			return self
		},

		/**
		 * Save stdout as file.
		 */
		saveStdoutFile: func() {
			st.stdoutFile = true
			return self
		},

		/**
		 * Save stderr as file.
		 */
		saveStderrFile: func() {
			st.stderrFile = true
			return self
		},

		/**
		 * Save stdout as stream.
		 */
		saveStdoutStream: func() {
			st.stdoutStream = true
			return self
		},

		/**
		 * Save stderr as stream.
		 */
		saveStderrStream: func() {
			st.stderrStream = true
			return self
		},

		/**
		 * Returns an independent builder with the same state: the same command, files, limits,
		 * outputs and fallbacks. Changing one does not change the other. Resources (files,
		 * software, handler builders) are shared, not copied.
		 *
		 * Typical use is a fallback plan that differs from the root in one setting:
		 *
		 *   main := exec.builder().software(sw).arg("align")...
		 *   moreRam := main.copy().mem("64GiB")
		 *   main.fallbacks({ OOM: [{ name: "moreRam", builder: moreRam }] })
		 *
		 * @return builder
		 */
		copy: func() {
			c := _cloneState(st)
			_lastBuilderId += 1
			c.id = _lastBuilderId
			return _makeBuilder(c)
		},

		/**
		 * Declares what runs instead when the command fails for a known reason. Needs a backend
		 * with RunCommand v3; on an older one the policy is ignored with a notice and a failure is
		 * an error, as without it.
		 *
		 * The policy maps a failure reason to a handler: an exec builder, or an ordered list of
		 * entries { <attributes>?, name?, builder }, the first matching one wins. An entry with no
		 * attributes matches any failure of that reason. Reasons and their attributes:
		 *   SoftwareError: exitCode (int), messageMatch (regex over the last log lines)
		 *   OOM:           exitCode (int)
		 *   GPUMissed:     backendHasGPU (bool), timeout (int, ms)
		 *   UnknownError, TimeIsUp, WorkdirOutOfSpace, ScratchOutOfSpace, InfraError: none
		 *
		 * `name` is the plan key shown in getAttempts() and in the final error; without it the key
		 * is "<reason>[<index>]". A handler builder may declare its own fallbacks. Every handler
		 * must save, stream and process exactly what this builder does (see verify()), and the
		 * tree must not contain cycles. The backend caps the number of attempts per job.
		 *
		 * Every handler's plan is an input of the exec, so the exec starts once the inputs of
		 * all its plans are ready, the files they add and line counts their formulas need
		 * included, whether a handler ever runs or not. A handler's plan, its quota and resource
		 * formulas included, is part of the exec's identity (CID): unlike the root's, they are
		 * not CID-transparent, so changing them, or a backend feature they depend on, computes
		 * the exec anew. When a handler's queue has no RunCommand v3 the exec runs without
		 * fallbacks, with a notice.
		 *
		 *   exec.builder()...fallbacks({
		 *       GPUMissed: cpuOnly,
		 *       SoftwareError: [{ exitCode: 2, name: "reindex", builder: reindex }]
		 *   })
		 *
		 * @param policy: map - reason -> builder | [builder | { <attributes>?, name?, builder }]
		 * @return builder
		 */
		fallbacks: func(policy) {
			normalized := fallback.validate(policy)
			// plan keys must be unique per policy: checked here, at the call site
			fallback.flatten(normalized)
			st.fallbacks = normalized
			return self
		},

		/**
		 * Checks the fallback tree: no handler is its own ancestor, and every handler, at any
		 * depth, saves the same files, file contents, file sets and file set contents, streams
		 * the same files and runs the same workdir processors as this builder. Panics listing
		 * every difference. run() calls it first; calling it earlier is allowed.
		 *
		 * @return builder
		 */
		verify: func() {
			errors := self._verifyErrors()
			ll.assert(len(errors) == 0, "exec.builder: invalid fallbacks:\n  %s", text.join(errors, "\n  "))
			return self
		},

		/**
		 * @return string[] - the problems verify() reports, empty when there are none
		 */
		_verifyErrors: func() {
			errors := []
			rootShape := self._outputShape()

			walk := undefined
			walk = func(b, path, ancestors) {
				entries := b._fallbackEntries()
				if is_undefined(entries) {
					return
				}
				for reason in maps.getKeys(entries) {
					for i, e in entries[reason] {
						key := fallback.planKey(reason, i, e)
						where := text.join(append(copy(path), key), " → ")
						id := e.builder._execBuilderId()
						if !is_undefined(ancestors[id]) {
							errors = append(errors, fmt.sprintf("%s: the handler is its own ancestor (a cycle)", where))
							continue
						}
						for d in _shapeDiff(rootShape, e.builder._outputShape()) {
							errors = append(errors, fmt.sprintf("%s: %s", where, d))
						}
						a := copy(ancestors)
						a[id] = true
						walk(e.builder, append(copy(path), key), a)
					}
				}
			}
			rootAncestors := {}
			rootAncestors[self._execBuilderId()] = true
			walk(self, [fallback.ROOT_PLAN], rootAncestors)

			return errors
		},

		/**
		 * The inputs run() renders exec.exec with: the pure inputs (including the fallback plans
		 * and policy, when used on a backend with RunCommand v3) and the meta inputs. Does not
		 * change the builder.
		 *
		 * @return { inputs: map, meta: map, renderOpts: map, st: map }
		 */
		plan: func() {
			self.verify()
			return self._plan()
		},

		_plan: func() {
			p := _cloneState(st)
			planned := _planOf(p)
			planned.st = p

			if p.forceRunCommandV2 {
				planned.meta[execConstants.META_INPUT_FORCE_RUN_COMMAND_V2] = smart.createJsonResource(true)
			}
			if p.forceWorkdirSaveV1 {
				planned.meta[execConstants.META_INPUT_FORCE_WORKDIR_SAVE_V1] = smart.createJsonResource(true)
			}

			if is_undefined(p.fallbacks) {
				return planned
			}
			if p.forceRunCommandV2 || is_undefined(limits.getRunCommandV3Type(p.queue)) {
				ll.print("exec.builder: the backend has no RunCommand v3, fallbacks are ignored; a failure is an error")
				return planned
			}

			flat := fallback.flatten(p.fallbacks)
			// A handler in a queue without RunCommand v3 would run without the outcome router: its
			// stream would never join the collection and its own fallbacks would be ignored. As on a
			// backend without v3 at all (spec §5), the exec then runs without fallbacks.
			for key, b in flat.plans {
				if !b._hasRunCommandV3() {
					ll.print(fmt.sprintf("exec.builder: fallback plan %q runs in a queue without RunCommand v3 on this backend, fallbacks are ignored; a failure is an error", key))
					return planned
				}
			}
			plans := {}
			for key, b in flat.plans {
				hp := b._plan()
				plans[key] = smart.createMapResource({
					inputs: smart.createMapResource(_definedOnly(hp.inputs)),
					meta: smart.createMapResource(_definedOnly(hp.meta))
				})
			}
			planned.inputs.fallbackPlans = smart.createMapResource(plans)
			planned.inputs.fallbackPolicy = flat.policy

			return planned
		},

		_execBuilderId: func() {
			return string(st.id)
		},

		_hasRunCommandV3: func() {
			return !st.forceRunCommandV2 && !is_undefined(limits.getRunCommandV3Type(st.queue))
		},

		_fallbackEntries: func() {
			return st.fallbacks
		},

		_outputShape: func() {
			return _outputShapeOf(st)
		},

		/**
		 * Test seam: renders this exec as on a backend without RunCommand v3, whatever the
		 * backend has. Not for blocks.
		 */
		_forceRunCommandV2: func() {
			st.forceRunCommandV2 = true
			return self
		},

		/**
		 * Test seam: saves this exec, and its fallback plans, as on a backend without WorkdirSave
		 * v3, whatever the backend has: fallbacks work, a lost working directory is not
		 * restarted. Not for blocks.
		 */
		_forceWorkdirSaveV1: func() {
			st.forceWorkdirSaveV1 = true
			return self
		},

		/**
		 * Executes the command.
		 *
		 * @return A map containing the execution results.
		 */
		run: func() {
			self.verify()

			planned := self._plan()
			fin := planned.st

			tpl := render.create(assets.importTemplate(":exec.exec"), planned.inputs, planned.renderOpts)

			res := undefined
			res = ll.toStrict(oop.inherit(tpl, {
				/**
				 * Retrieves a file.
				 *
				 * @param fileName: string
				 * @return field - a reference to the file resource.
				 */
				getFile: func(fileName) {
					ll.assert(sets.hasElement(fin.filesToSave, fileName),
						"file '%s' was not saved, add saveFile() call to the exec builder", fileName)
					return tpl.output("files", fin.cache).getFutureInputField(fileName)
				},

				/**
				 * Retrieves the content of a file.
				 *
				 * @param fileName: string
				 * @return field - a reference to the file content resource.
				 */
				getFileContent: func(fileName) {
					ll.assert(sets.hasElement(fin.filesContentToSave, fileName),
						"file '%s' content was not saved, add saveFileContent() call to the exec builder", fileName)
					return tpl.output("filesContent", fin.cache).getFutureInputField(fileName)
				},

				/**
				 * Retrieves a file stream.
				 *
				 * @param fileName: string
				 * @return field - a reference to the file stream resource.
				 */
				getFileStream: func(fileName) {
					ll.assert(sets.hasElement(fin.filesToStream, fileName),
						"file '%s' stream was not saved, add streamFile() call to the exec builder", fileName)
					return tpl.output("fileStreams", fin.cache).getFutureInputField(fileName, true)
				},

				/**
				 * Retrieves a file set resource.
				 *
				 * @param fileSetName: string - name of a file set
				 * @return field - a reference to the map resource with files
				 */
				getFileSet: func(fileSetName) {
					ll.assert(!is_undefined(fin.fileSetsToSave[fileSetName]),
						"file set '%s' was not saved, add saveFileSet() call to the exec builder", fileSetName)
					return tpl.output("fileSets", fin.cache).getFutureInputField(fileSetName)
				},

				/**
				 * Retrieves a file set content resource.
				 *
				 * @param fileSetName: string - name of a file set
				 * @return field - a reference to the map resource with files
				 */
				getFileSetContent: func(fileSetName) {
					ll.assert(!is_undefined(fin.fileSetsContentToSave[fileSetName]),
						"file set '%s' content was not saved, add saveFileSetContent() call to the exec builder", fileSetName)
					return tpl.output("fileSetsContent", fin.cache).getFutureInputField(fileSetName)
				},

				/**
				 * Retrieves the attempt history of a successful run: one entry per attempt, the
				 * last one the attempt that succeeded. A result reused from an exec rendered by an
				 * SDK before exec fallbacks (same inputs, so the same exec.exec render) has no
				 * attempts output: there this never resolves.
				 *
				 *   [{ attempt: 0, plan: "root", result: "fail", reason: "OOM", exitCode: 137 },
				 *    { attempt: 1, plan: "moreRam", result: "success", exitCode: 0 }]
				 *
				 * @return field - a reference to the JSON resource with the history.
				 */
				getAttempts: func() {
					return tpl.output("attempts", fin.cache)
				},

				getProcessorResult: func(procName) {
					ll.assert(!is_undefined(fin.wdProcessors[procName]),
						"processor '%s' result was not saved, add processWorkdir() call to the exec builder", procName)
					return tpl.output("wdProcessors", fin.cache).getFutureInputField(procName)
				},

				/**
				 * Retrieves the stdout stream.
				 */
				getStdoutStream: func() {
					ll.assert(fin.stdoutStream,
						"stdout stream was not saved, add saveStdoutStream() call to the exec builder")
					return res.getFileStream(fin.stdout)
				},

				/**
				 * Retrieves the stderr stream.
				 */
				getStderrStream: func() {
					ll.assert(fin.stderrStream,
						"stderr stream was not saved, add saveStderrStream() call to the exec builder")
					return res.getFileStream(fin.stderr)
				},

				/**
				 * Retrieves the stdout file.
				 */
				getStdoutFile: func() {
					ll.assert(fin.stdoutFile,
						"stdout file was not saved, add saveStdoutFile() call to the exec builder")
					return res.getFile(fin.stdout)
				},

				/**
				 * Retrieves the stderr file.
				 */
				getStderrFile: func() {
					ll.assert(fin.stderrFile,
						"stderr file was not saved, add saveStderrFile() call to the exec builder")
					return res.getFile(fin.stderr)
				},

				/**
				 * Retrieves the content of the stdout file.
				 */
				getStdoutContent: func() {
					ll.assert(fin.stdoutContent,
						"stdout content was not saved, add saveStdoutContent() call to the exec builder")
					return res.getFileContent(fin.stdout)
				},

				/**
				 * Retrieves the content of the stderr file.
				 */
				getStderrContent: func() {
					ll.assert(fin.stderrContent,
						"stderr content was not saved, add saveStderrContent() call to the exec builder")
					return res.getFileContent(fin.stderr)
				}
			}))

			return res
		}
	})

	return self
}

builder = func() {
	return _makeBuilder(_newState())
}

// _lineCountResource runs the line-counter binary on one file and returns a
// reference to the content resource holding that file's exact line count.
// Streaming binary => fixed small memory; light queue; 30-day input cache.
// Defined after builder() so it can call the factory recursively (a plain
// function call within :exec — no import, no cycle, no DI).
_lineCountResource = func(fileName, fileRef) {
	countOut := "linecount.txt"
	res := builder().
		software(lineCounterSoft).
		addFile(fileName, fileRef).
		arg("--input").arg(fileName).
		arg("--output").arg(countOut).
		saveFileContent(countOut).
		inLightQueue().
		cacheInputsDays(30).
		mem("256MiB").
		cpu(1).
		run()
	return res.getFileContent(countOut)
}

export ll.toStrict({
	builder: builder,

	// True when at least one backend runner advertises GPU availability.
	// .resources({ onCPU, onGPU }) reads this at workflow render time to choose the
	// onGPU allocation vs the onCPU fallback, so blocks rarely need it directly. It
	// also backs the GPU-required guard: onGPU without onCPU (or a static
	// .gpuMemory()) on a GPU-less backend is a permanent error.
	hasGpu: feats.hasGpu,
	formula: execFormula
})
