/*
 * Column ids in block args.
 *
 * A column id is the canonical JSON string that names a column. A workflow can find
 * a column by two kinds of id:
 *   - a block output: `{ __isRef: true, blockId, name }`;
 *   - a discovered column: `{ __isDiscovered: true, column, path?, columnQualifications? }`,
 *     a column reached from another one through the linker columns of `path`,
 *     `path[0]` applied first.
 */

ll := import(":ll")
json := import("json")
text := import("text")

/**
 * The column an id names, with the linker columns that lead to it.
 *
 * A discovered column is also taken decoded, as a map; its `column` and `path[].column`
 * are then column ids or resolved columns {spec, data}.
 *
 * @param query: any
 * @return column: { column, path, qualifications } | undefined - `column` and the entries
 *                 of `path` are the ids of block outputs, as given; `qualifications` are
 *                 the axis qualifications of `column`. Undefined when query is not a
 *                 column id.
 */
parse := func(query) {
	key := query
	if is_string(query) {
		if !text.has_prefix(query, "{") {
			return undefined
		}
		key = json.decode(query)
		if is_error(key) || !ll.isMap(key) {
			return undefined
		}
		if key.__isRef == true {
			return { column: query, path: [], qualifications: [] }
		}
	}
	if !ll.isMap(key) || key.__isDiscovered != true {
		return undefined
	}

	path := []
	if !is_undefined(key.path) {
		for step in key.path {
			ll.assert(step.type == "linker",
				"column-id: unsupported path step type %q (only \"linker\" is allowed)", step.type)
			ll.assert(!is_undefined(step.column),
				"column-id: linker step has no column: %v", step)
			path = append(path, step.column)
		}
	}
	qualifications := []
	if !is_undefined(key.columnQualifications) {
		qualifications = key.columnQualifications
	}
	return { column: key.column, path: path, qualifications: qualifications }
}

export ll.toStrict({
	parse: parse
})
