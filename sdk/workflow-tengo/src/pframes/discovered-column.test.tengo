test := import(":test")
json := import("json")
discoveredColumn := import(":pframes.discovered-column")

OUTPUT_ID := "{\"__isRef\":true,\"blockId\":\"b1\",\"name\":\"score\"}"
LINKER_ID := "{\"__isRef\":true,\"blockId\":\"b2\",\"name\":\"linker\"}"
QUALIFICATIONS := [{ axis: { name: "pl7.app/sampleId" }, contextDomain: { "pl7.app/blockId": "b1" } }]

TestParsesId := func() {
	id := string(json.encode({
		__isDiscovered: true,
		column: OUTPUT_ID,
		path: [{ type: "linker", column: LINKER_ID }],
		columnQualifications: QUALIFICATIONS
	}))
	test.isEqual(
		{ column: OUTPUT_ID, path: [LINKER_ID], qualifications: QUALIFICATIONS },
		discoveredColumn.parse(id))
}

TestParsesIdWithoutPath := func() {
	id := string(json.encode({ __isDiscovered: true, column: OUTPUT_ID }))
	test.isEqual({ column: OUTPUT_ID, path: [], qualifications: [] }, discoveredColumn.parse(id))
}

TestParsesKeyWithResolvedColumns := func() {
	resolved := { spec: { kind: "PColumn" }, data: "data_ref" }
	parsed := discoveredColumn.parse({
		__isDiscovered: true,
		column: resolved,
		path: [{ type: "linker", column: resolved }]
	})
	test.isEqual({ column: resolved, path: [resolved], qualifications: [] }, parsed)
}

TestRejectsWhatIsNotDiscoveredColumn := func() {
	test.isTrue(is_undefined(discoveredColumn.parse(OUTPUT_ID)), "the id of a block output")
	test.isTrue(is_undefined(discoveredColumn.parse("pl7.app/score")), "a plain string")
	test.isTrue(is_undefined(discoveredColumn.parse("{not json")), "a string that is not JSON")
	test.isTrue(is_undefined(discoveredColumn.parse("{\"name\":\"x\"}")), "JSON of another map")
	test.isTrue(is_undefined(discoveredColumn.parse({ name: "pl7.app/score" })), "a query spec")
	test.isTrue(is_undefined(discoveredColumn.parse({ __isRef: true, blockId: "b1", name: "x" })), "a ref map")
	test.isTrue(is_undefined(discoveredColumn.parse({ spec: {}, data: "d" })), "a resolved column")
	test.isTrue(is_undefined(discoveredColumn.parse(undefined)), "undefined")
}
