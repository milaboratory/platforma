/**
 * Block action context.
 *
 * The caller creates or passes on the action context of what it creates; the callee reports.
 *
 * Every render can have an action context: an ActionContext resource that its "actionContext" field points
 * to. The field is an optional service field of the render schema: the creator sets it once, and
 * nothing can change it later.
 * The middle layer creates the context of the root render of a block. render() creates the context
 * of every render that template code creates: the baggage is a copy of the baggage of the current
 * renderer's context with its own "name", and the parent context links it in a "child/..." field,
 * so the contexts form a tree.
 *
 * An "actionContext" field can also point to a sinkhole (ActionSinkhole): reports on that resource are
 * dropped, and every render it creates gets the sinkhole too. render(tpl, inputs, { actionContext: false })
 * puts a rendered template and everything below it into the sinkhole.
 * A render without an "actionContext" field reports nowhere, and its children get no field.
 *
 * Reports (record, setReading) are asynchronous key-value sets on the context of the resource
 * (tx.resourceKeyValueSetAsync): transition/<namespace>/<resource>/<ns> and reading/<namespace>/<resource>/<key>,
 * where <resource> is the decimal resource ID. They are no-ops when the backend lacks the primitives
 * (feats.kvAsync, feats.optionalServiceField), or when the resource has no action context, so templates
 * can report unconditionally.
 *
 * Namespaces "core", "render", "workdir" and "exec" are reserved for the platform.
 * Namespaces and reading keys must not contain "/".
 */

ll := import(":ll")
feats := import(":feats")
constants := import(":constants")
json := import("json")
slices := import(":slices")
text := import("text")
times := import("times")
tx := import("tx")

LINK_FIELD := "actionContext"
STATES := ["WaitingForInputs", "Running", "WaitingWorkdirGate", "WaitingSubmissionGate", "PopulatingWorkdir",
	"CollectingOutputs", "WaitingForScheduler", "WaitingForMachine", "Terminated", "Completed"]
CHILD_FIELD_PREFIX := "child/"
CONTEXT_TYPE := { Name: "ActionContext", Version: "1" }
SINKHOLE_TYPE := { Name: "ActionSinkhole", Version: "1" }

// The action context of the current renderer, its context baggage, the sinkhole of this execution and a counter
// for child field names. Every import of this module is a new instance, so the state is kept in the
// execution context.
_vars := func() {
	return ll.moduleVars("action-context")
}

/**
 * @param rid: resource id
 * @return what the "actionContext" field of the resource points to:
 *         { kind: "none" } without the field, { kind: "context", id } for an action context,
 *         { kind: "sinkhole", id } for anything else.
 */
linkOf := func(rid) {
	// ServiceFields is a strict map: a missing key is an error, so look the field up by iteration
	for name, field in tx.getResource(rid).ServiceFields {
		if name != LINK_FIELD || field.Value == 0 {
			continue
		}
		if tx.getResource(field.Value).Type.Name == CONTEXT_TYPE.Name {
			return { kind: "context", id: field.Value }
		}
		return { kind: "sinkhole", id: field.Value }
	}
	return { kind: "none" }
}

/**
 * @param rid: resource id
 * @return id of the action context of the resource, or undefined.
 */
contextOf := func(rid) {
	link := linkOf(rid)
	return link.kind == "context" ? link.id : undefined
}

_own := func() {
	vars := _vars()
	own := vars.get("own")
	if is_undefined(own) {
		own = linkOf(ll.getCurrentTemplateRenderer().ID)
		vars.set("own", own)
	}
	return own
}

_ownBaggage := func() {
	vars := _vars()
	baggage := vars.get("ownBaggage")
	if is_undefined(baggage) {
		baggage = {}
		raw := tx.getResource(_own().id).Data
		if !is_undefined(raw) && len(raw) > 0 {
			baggage = json.decode(raw)
		}
		vars.set("ownBaggage", baggage)
	}
	return copy(baggage)
}

_childFieldName := func() {
	vars := _vars()
	counter := vars.get("childCounter")
	counter = is_undefined(counter) ? 0 : counter + 1
	vars.set("childCounter", counter)
	return CHILD_FIELD_PREFIX + string(times.time_unix_nano(times.now())) + "-" + string(counter)
}

// _enabled is true when the backend has the primitives of block action context: optional service
// fields for the link and asynchronous key-value sets for the reports.
_enabled := func() {
	return feats.kvAsync && feats.optionalServiceField
}

_link := func(rid, target) {
	if !_enabled() {
		return
	}
	field := ll.fieldId(rid, LINK_FIELD)
	tx.createField(field, constants.FTYPE_SERVICE)
	tx.setFieldToResource(field, target)
}

_validateKeyPart := func(name, part) {
	ll.assert(is_string(part) && len(part) > 0, "action context: %s must be a non-empty string", name)
	ll.assert(!text.contains(part, "/"), "action context: %s %q contains \"/\"", name, part)
}

_sinkhole := func() {
	vars := _vars()
	sinkhole := vars.get("sinkhole")
	if is_undefined(sinkhole) {
		sinkhole = tx.createEphemeral(SINKHOLE_TYPE.Name, SINKHOLE_TYPE.Version, "{}")
		vars.set("sinkhole", sinkhole)
	}
	return sinkhole
}

_createContext := func(rid, baggage) {
	contextId := tx.createEphemeral(CONTEXT_TYPE.Name, CONTEXT_TYPE.Version, json.encode(baggage))
	_link(rid, contextId)
	return contextId
}

/**
 * Points the "actionContext" field of a resource the current template created to a sinkhole: reports on it
 * are dropped, and the renders it creates get the sinkhole too. Call it in the transaction that
 * created the resource.
 *
 * @param rid: resource id
 */
sinkhole := func(rid) {
	_link(rid, _sinkhole())
}

/**
 * Sets the action context of a render that the current template created, from the action context of the current
 * renderer: a new context under the renderer's context, the sinkhole when the renderer is in the
 * sinkhole, nothing when the renderer has no action context.
 *
 * @param rid: id of the new render, in the transaction that created it
 * @param name: (optional) display name of the render, e.g. the template name
 * @return id of the new context, or undefined
 */
createChild := func(rid, name) {
	if !_enabled() {
		return undefined
	}
	own := _own()
	if own.kind == "none" {
		return undefined
	}
	if own.kind == "sinkhole" {
		sinkhole(rid)
		return undefined
	}

	baggage := _ownBaggage()
	if !is_undefined(name) {
		baggage.name = name
	}

	contextId := _createContext(rid, baggage)

	childField := ll.fieldId(own.id, _childFieldName())
	tx.createField(childField, constants.FTYPE_DYNAMIC)
	tx.setFieldToResource(childField, contextId)

	return contextId
}

/**
 * Returns the action context handle of a resource.
 *
 * @param rid: resource id
 * @return handle with:
 *   - setReading(namespace, key, value): sets an reading of the resource; the value is a string or bytes
 *   - record(namespace, state, ...detail): records a transition of the resource, state is a state name,
 *                                      e.g. "Running"; detail is an optional string for the user
 */
of := func(rid) {
	contextId := func() {
		return _enabled() ? contextOf(rid) : undefined
	}

	return ll.toStrict({
		setReading: func(namespace, key, value) {
			_validateKeyPart("namespace", namespace)
			_validateKeyPart("reading key", key)
			ctx := contextId()
			if !is_undefined(ctx) {
				tx.resourceKeyValueSetAsync(ctx, "reading/" + namespace + "/" + string(rid) + "/" + key, value)
			}
		},

		record: func(namespace, state, ...detail) {
			_validateKeyPart("namespace", namespace)
			ll.assert(slices.hasElement(STATES, state), "action context: unknown state %q", state)
			ctx := contextId()
			if !is_undefined(ctx) {
				key := "transition/" + namespace + "/" + string(rid) + "/" + string(times.time_unix_nano(times.now()))
				value := json.encode({ state: state, detail: len(detail) > 0 ? detail[0] : "", reason: "" })
				tx.resourceKeyValueSetAsync(ctx, key, value)
			}
		}
	})
}

/**
 * Returns the action context handle of the current renderer: the handle of `of`, plus
 *   - baggage(): returns a copy of the baggage of the current renderer's action context, e.g. "run-id",
 *             "block-id", "block-pack" and "name"; undefined without a context or in the sinkhole.
 *   - create(...baggage): creates the action context of the current renderer, for a template rendered
 *                      without an action context; baggage is an optional map of context baggage. Returns the id of
 *                      the context. When the renderer already has an action context, it creates nothing and
 *                      returns its context, or undefined for a sinkhole. Returns undefined when the backend
 *                      lacks the primitives (see the module description).
 */
self := func() {
	renderer := ll.getCurrentTemplateRenderer().ID
	handle := of(renderer)
	return ll.toStrict({
		setReading: handle.setReading,
		record: handle.record,

		baggage: func() {
			return _own().kind == "context" ? _ownBaggage() : undefined
		},

		create: func(...baggage) {
			if !_enabled() {
				return undefined
			}
			own := _own()
			if own.kind != "none" {
				return own.kind == "context" ? own.id : undefined
			}
			contextBaggage := len(baggage) > 0 ? baggage[0] : {}
			contextId := _createContext(renderer, contextBaggage)
			vars := _vars()
			vars.set("own", { kind: "context", id: contextId })
			vars.set("ownBaggage", copy(contextBaggage))
			return contextId
		}
	})
}

export ll.toStrict({
	LINK_FIELD: LINK_FIELD,
	CHILD_FIELD_PREFIX: CHILD_FIELD_PREFIX,

	linkOf: linkOf,
	contextOf: contextOf,
	createChild: createChild,
	sinkhole: sinkhole,
	of: of,
	self: self
})
